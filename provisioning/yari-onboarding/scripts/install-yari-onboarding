#!/usr/bin/env bash
set -euo pipefail

if [[ "$(id -u)" -ne 0 ]]; then
  echo "Run with sudo: sudo provisioning/yari-onboarding/scripts/install-yari-onboarding" >&2
  exit 1
fi

SRC_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

install -d -m 0755 /usr/local/sbin /usr/local/bin
install -m 0755 "${SRC_ROOT}/scripts/yari-onboarding" /usr/local/sbin/yari-onboarding
install -m 0755 "${SRC_ROOT}/scripts/yari-service-manager" /usr/local/sbin/yari-service-manager
install -m 0755 "${SRC_ROOT}/scripts/yari-package-app" /usr/local/bin/yari-package-app
install -m 0755 "${SRC_ROOT}/scripts/build-yari-portal" /usr/local/bin/build-yari-portal

install -d -m 0755 /opt/yari/onboarding/web
PORTAL_SRC="${SRC_ROOT}/portal"
PORTAL_DIST="${PORTAL_SRC}/dist"

node_major_version() {
  node -p "Number(process.versions.node.split('.')[0])" 2>/dev/null || echo 0
}

portal_build_tools_ready() {
  local major
  command -v node >/dev/null 2>&1 || return 1
  command -v npm >/dev/null 2>&1 || return 1
  major="$(node_major_version)"
  [[ "${major}" =~ ^[0-9]+$ ]] || return 1
  (( major >= 18 ))
}

install_node20_build_tools() {
  if portal_build_tools_ready; then
    return 0
  fi

  command -v apt-get >/dev/null 2>&1 || return 1

  echo "Installing Node.js 20 for Svelte portal build"
  export DEBIAN_FRONTEND=noninteractive

  # A stale NodeSource entry with a missing/rotated key makes apt-get update
  # fail before we can install curl/gnupg. Disable it, install prerequisites
  # from Ubuntu, then recreate the NodeSource source with a fresh keyring.
  rm -f /etc/apt/sources.list.d/nodesource.list
  rm -f /etc/apt/keyrings/nodesource.gpg

  apt-get update
  apt-get install -y ca-certificates curl gnupg
  install -d -m 0755 /etc/apt/keyrings
  curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
    | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg
  chmod 0644 /etc/apt/keyrings/nodesource.gpg
  echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_20.x nodistro main" \
    >/etc/apt/sources.list.d/nodesource.list
  apt-get update
  apt-get install -y nodejs

  portal_build_tools_ready
}


validate_portal_dist() {
  if [[ ! -f "${PORTAL_DIST}/index.html" ]]; then
    echo "Svelte portal build failed: ${PORTAL_DIST}/index.html was not created." >&2
    return 1
  fi
  if [[ ! -f "${PORTAL_DIST}/portal-version.json" || ! -f "${PORTAL_DIST}/portal-assets.json" ]]; then
    echo "Svelte portal metadata missing. Run npm run build in ${PORTAL_SRC}." >&2
    return 1
  fi
  shopt -s nullglob
  local portal_gzip_assets=("${PORTAL_DIST}"/*.gz "${PORTAL_DIST}"/assets/*.gz)
  shopt -u nullglob
  if (( ${#portal_gzip_assets[@]} == 0 )); then
    echo "Svelte portal precompressed assets missing. Run npm run build in ${PORTAL_SRC}." >&2
    return 1
  fi
}

portal_dist_stale() {
  [[ "${YARI_PORTAL_FORCE_BUILD:-0}" == "1" ]] && return 0
  [[ ! -f "${PORTAL_DIST}/index.html" ]] && return 0
  [[ ! -f "${PORTAL_DIST}/portal-version.json" ]] && return 0
  [[ ! -f "${PORTAL_DIST}/portal-assets.json" ]] && return 0

  local source_paths=()
  local candidate
  for candidate in \
    "${PORTAL_SRC}/src" \
    "${PORTAL_SRC}/scripts" \
    "${PORTAL_SRC}/index.html" \
    "${PORTAL_SRC}/package.json" \
    "${PORTAL_SRC}/package-lock.json" \
    "${PORTAL_SRC}/svelte.config.js" \
    "${PORTAL_SRC}/tsconfig.json" \
    "${PORTAL_SRC}/vite.config.ts"; do
    [[ -e "${candidate}" ]] && source_paths+=("${candidate}")
  done

  if (( ${#source_paths[@]} > 0 )) && find "${source_paths[@]}" -type f -newer "${PORTAL_DIST}/portal-version.json" -print -quit | grep -q .; then
    return 0
  fi

  return 1
}

ensure_portal_dist() {
  if ! portal_dist_stale; then
    return 0
  fi

  if ! install_node20_build_tools; then
    echo "Svelte portal build is missing or stale and Node.js >= 18/npm are not available." >&2
    echo "Install Node.js 20, or build provisioning/yari-onboarding/portal/dist before running this installer." >&2
    exit 1
  fi
  echo "Building Svelte YARI OS portal from ${PORTAL_SRC}"
  "${SRC_ROOT}/scripts/build-yari-portal"
}

ensure_portal_dist

if ! validate_portal_dist; then
  exit 1
fi

rm -rf /opt/yari/onboarding/web/*
cp -a "${PORTAL_DIST}/." /opt/yari/onboarding/web/
echo "Installed Svelte YARI OS portal from ${PORTAL_DIST}"
find /opt/yari/onboarding/web -name '*:Zone.Identifier' -delete || true
if command -v gzip >/dev/null 2>&1; then
  find /opt/yari/onboarding/web -type f \( -name '*.html' -o -name '*.js' -o -name '*.css' -o -name '*.json' -o -name '*.svg' -o -name '*.txt' \) -exec gzip -kf -9 {} \;
fi

install -d -m 0755 /etc/yari /etc/yari/apps.d /opt/yari/onboarding/apps
if [[ ! -f /etc/yari/onboarding.env ]]; then
  cat >/etc/yari/onboarding.env <<'ENV'
# Optional production hardening. When set, all mutating portal API calls
# require X-YARI-Token or Authorization: Bearer with this value.
# YARI_PORTAL_API_TOKEN=change-me-per-device
ENV
  chmod 0600 /etc/yari/onboarding.env
fi
cp -a "${SRC_ROOT}/apps/." /opt/yari/onboarding/apps/
find /opt/yari/onboarding/apps -name '*:Zone.Identifier' -delete || true
install -d -m 0755 /var/lib/yari/onboarding /var/lib/yari/app-packages

install -d -m 0755 /etc/systemd/system
install -m 0644 "${SRC_ROOT}/systemd/"*.service /etc/systemd/system/

systemctl daemon-reload
systemctl enable \
  yari-onboarding.service \
  yari-agent.service \
  yari-mavlink-router.service \
  yari-autopilot-manager.service \
  yari-log-manager.service \
  yari-video.service \
  yari-ros.service

echo "YARI onboarding/device portal installed. Start with: sudo systemctl restart yari-onboarding.service"
echo "YARI companion status services are enabled for the next boot. Start now with: sudo systemctl restart yari-agent yari-mavlink-router yari-autopilot-manager yari-log-manager yari-video yari-ros"
