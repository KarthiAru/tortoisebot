AP_PASSWORD = os.environ.get("YARI_ONBOARDING_AP_PASSWORD", "")
CONNECTIVITY_TIMEOUT = int(os.environ.get("YARI_ONBOARDING_CONNECTIVITY_TIMEOUT", "45"))
HTTP_PORT = int(os.environ.get("YARI_ONBOARDING_HTTP_PORT", "80"))
REBOOT_AFTER_SAVE = os.environ.get("YARI_ONBOARDING_REBOOT_AFTER_SAVE", "1") not in {"0", "false", "False"}
