def run(args, check=False, capture=True):
    kwargs = {"text": True}
    if capture:
        kwargs.update({"stdout": subprocess.PIPE, "stderr": subprocess.PIPE})
    result = subprocess.run(args, **kwargs)
    if check and result.returncode != 0:
        raise RuntimeError(f"Command failed: {' '.join(args)}\n{result.stderr.strip() if result.stderr else ''}")
    return result


def has_command(name):
    return run(["/usr/bin/env", "sh", "-lc", f"command -v {name}"], capture=True).returncode == 0


def device_id():
    try:
        value = DEVICE_ID_FILE.read_text().strip()
        if value:
            return value
    except (FileNotFoundError, PermissionError, OSError):
        pass
    for candidate in (Path("/etc/machine-id"), Path("/var/lib/dbus/machine-id")):
        try:
            value = candidate.read_text().strip()
            if value:
                return value[:8]
        except FileNotFoundError:
            pass
    return secrets.token_hex(4)


def regenerate_device_id():
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    new_id = secrets.token_hex(4)
    DEVICE_ID_FILE.write_text(new_id + "\n")
    os.chmod(DEVICE_ID_FILE, 0o600)
    state = current_state({"mode": read_state().get("mode", "unknown"), "message": "device id regenerated"})
    write_state(state)
    return state


def ap_ssid():
    return os.environ.get("YARI_ONBOARDING_AP_SSID", f"{AP_SSID_PREFIX}-{device_id()}")


def current_state(extra=None):
    payload = {
        "device_id": device_id(),
        "ap_ssid": ap_ssid(),
        "ap_url": f"http://{AP_ADDR}",
        "wifi_iface": AP_IFACE,
        "networkmanager": has_command("nmcli"),
        "complete": COMPLETE_FILE.exists(),
        "hostname": socket.gethostname(),
    }
    if extra:
        payload.update(extra)
    return payload


def write_state(payload):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    STATE_FILE.write_text(json.dumps(payload, indent=2) + "\n")


def read_state():
    try:
        return json.loads(STATE_FILE.read_text())
    except (FileNotFoundError, json.JSONDecodeError):
        return current_state()


def read_text_file(path):
    try:
        return Path(path).read_text().strip()
    except (FileNotFoundError, PermissionError, OSError):
        return ""


def device_model():
    for path in DEVICE_MODEL_PATHS:
        value = read_text_file(path).replace("\x00", "").strip()
        if value:
            return value
    return "unknown"


def write_json_secret(path, payload):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(payload, indent=2) + "\n")
    os.chmod(path, 0o600)


def read_json_file(path, default=None):
    try:
        return json.loads(path.read_text())
    except (FileNotFoundError, PermissionError, OSError, json.JSONDecodeError):
        return {} if default is None else default


def redact_secret(value):
    if not value:
        return {"configured": False}
    return {"configured": True, "length": len(str(value)), "preview": str(value)[:4] + "..."}


def service_manager_status(role):
    payload = read_json_file(SERVICE_STATE_DIR / f"{role}.json", {})
    if not payload:
        return {"available": False, "message": f"yari-{role} service has not written status yet"}
    payload["available"] = True
    payload["age_seconds"] = max(0, int(time.time()) - int(payload.get("updated", 0)))
    return payload


def save_ssh_access(ssh_key="", ssh_password=""):
    result = {"authorized_key": False, "password": False}
    ssh_key = normalize_form_value(str(ssh_key or ""))
    ssh_password = normalize_form_value(str(ssh_password or ""))
    if ssh_key:
        home = Path("/home") / ONBOARDING_USER
        ssh_dir = home / ".ssh"
        ssh_dir.mkdir(parents=True, exist_ok=True)
        auth = ssh_dir / "authorized_keys"
        existing = auth.read_text().splitlines() if auth.exists() else []
        if ssh_key not in existing:
            existing.append(ssh_key)
            auth.write_text("\n".join(line for line in existing if line.strip()) + "\n")
        os.chmod(ssh_dir, 0o700)
        os.chmod(auth, 0o600)
        try:
            import pwd
            user = pwd.getpwnam(ONBOARDING_USER)
            os.chown(ssh_dir, user.pw_uid, user.pw_gid)
            os.chown(auth, user.pw_uid, user.pw_gid)
        except Exception:
            pass
        result["authorized_key"] = True
    if ssh_password:
        if APPLY_NETWORK:
            subprocess.run(["chpasswd"], input=f"{ONBOARDING_USER}:{ssh_password}\n", text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        result["password"] = True
    return result


def save_pairing_tokens(atlas_token="", foxglove_token=""):
    current = read_json_file(PORTAL_SECRETS_FILE, {})
    atlas_token = normalize_form_value(str(atlas_token or ""))
    foxglove_token = normalize_form_value(str(foxglove_token or ""))
    if atlas_token:
        current["atlas_token"] = atlas_token
    if foxglove_token:
        current["foxglove_token"] = foxglove_token
    if current:
        write_json_secret(PORTAL_SECRETS_FILE, current)
    return {"atlas_token": redact_secret(current.get("atlas_token")), "foxglove_token": redact_secret(current.get("foxglove_token"))}


def default_device_profile():
    return {
        "profile_preset": "tortoisebot_rover",
        "vehicle_class": "ground_rover",
        "autopilot_stack": "ros_only",
        "compute_target": "raspberry_pi",
        "ros_domain_id": 0,
        "notes": "",
    }


def read_device_profile():
    config = read_json_file(PORTAL_CONFIG_FILE, {})
    profile = {**default_device_profile(), **config.get("device_profile", {})}
    if profile.get("profile_preset") not in {"tortoisebot_rover", "ros_ground_robot", "px4_companion", "ardupilot_companion", "generic_edge", "custom"}:
        profile["profile_preset"] = "custom"
    if profile.get("vehicle_class") not in {"ground_rover", "multirotor", "fixed_wing", "vtol", "boat", "sub", "generic_edge"}:
        profile["vehicle_class"] = "generic_edge"
    if profile.get("autopilot_stack") not in {"none", "px4", "ardupilot", "ros_only", "custom"}:
        profile["autopilot_stack"] = "custom"
    if profile.get("compute_target") not in {"raspberry_pi", "jetson_orin", "jetson_nano", "x86_ubuntu", "custom"}:
        profile["compute_target"] = "custom"
    try:
        domain = int(profile.get("ros_domain_id", 0))
    except (TypeError, ValueError):
        domain = 0
    profile["ros_domain_id"] = max(0, min(domain, 232))
    profile["notes"] = str(profile.get("notes") or "")[:500]
    return profile


def normalize_device_profile(payload):
    profile_preset = str(payload.get("profile_preset") or "custom").strip().lower()
    vehicle_class = str(payload.get("vehicle_class") or "ground_rover").strip().lower()
    autopilot_stack = str(payload.get("autopilot_stack") or "none").strip().lower()
    compute_target = str(payload.get("compute_target") or "raspberry_pi").strip().lower()
    if profile_preset not in {"tortoisebot_rover", "ros_ground_robot", "px4_companion", "ardupilot_companion", "generic_edge", "custom"}:
        raise ValueError("profile_preset must be one of tortoisebot_rover, ros_ground_robot, px4_companion, ardupilot_companion, generic_edge, custom")
    if vehicle_class not in {"ground_rover", "multirotor", "fixed_wing", "vtol", "boat", "sub", "generic_edge"}:
        raise ValueError("vehicle_class must be one of ground_rover, multirotor, fixed_wing, vtol, boat, sub, generic_edge")
    if autopilot_stack not in {"none", "px4", "ardupilot", "ros_only", "custom"}:
        raise ValueError("autopilot_stack must be one of none, px4, ardupilot, ros_only, custom")
    if compute_target not in {"raspberry_pi", "jetson_orin", "jetson_nano", "x86_ubuntu", "custom"}:
        raise ValueError("compute_target must be one of raspberry_pi, jetson_orin, jetson_nano, x86_ubuntu, custom")
    ros_domain_id = int(payload.get("ros_domain_id", 0))
    if ros_domain_id < 0 or ros_domain_id > 232:
        raise ValueError("ros_domain_id must be between 0 and 232")
    return {
        "profile_preset": profile_preset,
        "vehicle_class": vehicle_class,
        "autopilot_stack": autopilot_stack,
        "compute_target": compute_target,
        "ros_domain_id": ros_domain_id,
        "notes": str(payload.get("notes") or "")[:500],
    }


def save_device_profile(payload):
    profile = normalize_device_profile(payload)
    config = read_json_file(PORTAL_CONFIG_FILE, {})
    config["device_profile"] = profile
    config["updated"] = int(time.time())
    PORTAL_CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
    PORTAL_CONFIG_FILE.write_text(json.dumps(config, indent=2) + "\n")
    os.chmod(PORTAL_CONFIG_FILE, 0o600)
    return {"ok": True, "profile": read_device_profile()}


def portal_config_status():
    secrets_payload = read_json_file(PORTAL_SECRETS_FILE, {})
    return {
        "user": ONBOARDING_USER,
        "ssh_authorized_keys": len((Path("/home") / ONBOARDING_USER / ".ssh" / "authorized_keys").read_text().splitlines()) if (Path("/home") / ONBOARDING_USER / ".ssh" / "authorized_keys").exists() else 0,
        "atlas_token": redact_secret(secrets_payload.get("atlas_token")),
        "foxglove_token": redact_secret(secrets_payload.get("foxglove_token")),
    }


def portal_assets_summary():
    payload = read_json_file(PORTAL_ASSETS_FILE, {})
    assets = payload.get("assets") if isinstance(payload.get("assets"), list) else []
    gzip_assets = [asset for asset in assets if isinstance(asset, dict) and asset.get("gzip")]
    return {
        "available": bool(payload),
        "generated_at": payload.get("generated_at", "unknown"),
        "asset_count": int(payload.get("asset_count") or len(assets)),
        "total_bytes": int(payload.get("total_bytes") or sum(int(asset.get("bytes") or 0) for asset in assets if isinstance(asset, dict))),
        "gzip_asset_count": len(gzip_assets),
        "gzip_total_bytes": sum(int(asset.get("bytes") or 0) for asset in gzip_assets if isinstance(asset, dict)),
        "manifest": str(PORTAL_ASSETS_FILE),
    }


def portal_version():
    payload = read_json_file(PORTAL_VERSION_FILE, {})
    return {
        "name": payload.get("name", "yari-os-device-portal"),
        "version": payload.get("version", "unbuilt"),
        "build_time": payload.get("build_time", "unknown"),
        "git_commit": payload.get("git_commit", "unknown"),
        "frontend_stack": payload.get("frontend_stack", "svelte-build-missing"),
        "api_token_required": bool(portal_api_token()),
        "assets": portal_assets_summary(),
    }


def portal_api_token():
    return str(os.environ.get("YARI_PORTAL_API_TOKEN", PORTAL_API_TOKEN) or "").strip()


def header_value(headers, *names):
    for name in names:
        value = headers.get(name)
        if value is not None:
            return value
        value = headers.get(name.lower())
        if value is not None:
            return value
        value = headers.get(name.title())
        if value is not None:
            return value
    return ""


def bearer_token(value):
    value = str(value or "").strip()
    if value.lower().startswith("bearer "):
        return value[7:].strip()
    return ""


def request_authorized(headers):
    expected = portal_api_token()
    if not expected:
        return True
    supplied = str(header_value(headers, "x-yari-token") or "").strip()
    if not supplied:
        supplied = bearer_token(header_value(headers, "authorization"))
    return bool(supplied) and secrets.compare_digest(supplied, expected)


def command_output(args, timeout=8):
    try:
        result = subprocess.run(args, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=timeout)
    except (FileNotFoundError, subprocess.TimeoutExpired) as exc:
        return {"ok": False, "stdout": "", "stderr": str(exc), "returncode": 1}
    return {"ok": result.returncode == 0, "stdout": result.stdout.strip(), "stderr": result.stderr.strip(), "returncode": result.returncode}


def has_connectivity():
    checks = [
        ["/usr/bin/env", "sh", "-lc", "ip -4 addr show scope global | grep -q inet"],
        ["/usr/bin/env", "sh", "-lc", "ip route | grep -q '^default'"],
    ]
    return all(run(command, capture=True).returncode == 0 for command in checks)


def wait_for_connectivity(timeout):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if has_connectivity():
            return True
        time.sleep(2)
    return has_connectivity()


def ensure_ap():
    if has_command("nmcli"):
        ensure_ap_networkmanager()
        return
    ensure_ap_wpa_supplicant()


def nm_connection_names():
    result = run(["nmcli", "-t", "-f", "NAME", "connection", "show"], capture=True)
    if result.returncode != 0:
        return []
    return result.stdout.splitlines()


def try_saved_networkmanager_wifi(timeout=25):
    if not has_command("nmcli") or "yari-wifi" not in nm_connection_names():
        return False
    run(["nmcli", "connection", "down", "yari-setup-ap"], capture=True)
    result = run(["nmcli", "connection", "up", "yari-wifi"], capture=True)
    if result.returncode != 0:
        write_state(current_state({
            "mode": "client-failed",
            "configured_ssid": read_configured_ssid(),
            "error": (result.stderr or result.stdout).strip(),
        }))
        return False
    if wait_for_connectivity(timeout):
        write_state(current_state({"mode": "client", "message": "connected using saved yari-wifi profile"}))
        return True
    write_state(current_state({
        "mode": "client-failed",
        "configured_ssid": read_configured_ssid(),
        "error": "saved yari-wifi profile activated but no network connectivity was detected",
    }))
    return False


def read_configured_ssid():
    if not has_command("nmcli"):
        return ""
    result = run(["nmcli", "-g", "802-11-wireless.ssid", "connection", "show", "yari-wifi"], capture=True)
    return result.stdout.strip() if result.returncode == 0 else ""


def ensure_ap_networkmanager():
    ssid = ap_ssid()
    existing = nm_connection_names()
    if "yari-setup-ap" in existing:
        run(["nmcli", "connection", "delete", "yari-setup-ap"], capture=True)
    run(["nmcli", "connection", "add", "type", "wifi", "ifname", AP_IFACE, "con-name", "yari-setup-ap", "autoconnect", "no", "ssid", ssid], check=True)
    run(["nmcli", "connection", "modify", "yari-setup-ap", "802-11-wireless.mode", "ap", "802-11-wireless.band", "bg", "ipv4.method", "shared", "ipv4.addresses", f"{AP_ADDR}/{AP_PREFIX}", "ipv6.method", "ignore"], check=True)
    if AP_PASSWORD:
        run(["nmcli", "connection", "modify", "yari-setup-ap", "wifi-sec.key-mgmt", "wpa-psk", "wifi-sec.psk", AP_PASSWORD], check=True)
    run(["nmcli", "connection", "up", "yari-setup-ap"], check=True)
    write_state(current_state({"mode": "setup-ap", "ap_backend": "networkmanager", "ap_security": "wpa-psk" if AP_PASSWORD else "open"}))


def ensure_ap_wpa_supplicant():
    missing = [name for name in ("wpa_supplicant", "ip", "systemctl") if not has_command(name)]
    if missing:
        message = f"Missing AP fallback tools: {', '.join(missing)}"
        write_state(current_state({"mode": "error", "error": message}))
        raise RuntimeError(message)

    runtime = Path("/run/yari-onboarding")
    runtime.mkdir(parents=True, exist_ok=True)
    wpa_conf = runtime / "wpa_supplicant-ap.conf"
    networkd_conf = Path(f"/run/systemd/network/80-yari-{AP_IFACE}-ap.network")
    networkd_conf.parent.mkdir(parents=True, exist_ok=True)

    ssid = ap_ssid().replace('"', '\\"')
    lines = ["ctrl_interface=/run/wpa_supplicant", "ap_scan=2", "network={", f"    ssid=\"{ssid}\"", "    mode=2", "    frequency=2412"]
    if AP_PASSWORD:
        password = AP_PASSWORD.replace('"', '\\"')
        lines.extend(["    key_mgmt=WPA-PSK", f"    psk=\"{password}\""])
        security = "wpa-psk"
    else:
        lines.append("    key_mgmt=NONE")
        security = "open"
    lines.append("}")
    wpa_conf.write_text("\n".join(lines) + "\n")
    os.chmod(wpa_conf, 0o600)

    networkd_conf.write_text("\n".join([
        "[Match]",
        f"Name={AP_IFACE}",
        "",
        "[Network]",
        f"Address={AP_ADDR}/{AP_PREFIX}",
        "DHCPServer=yes",
        "IPMasquerade=ipv4",
        "",
        "[DHCPServer]",
        "PoolOffset=20",
        "PoolSize=180",
        "EmitDNS=yes",
        f"DNS={AP_ADDR}",
        "",
    ]))

    run(["systemctl", "stop", f"wpa_supplicant@{AP_IFACE}.service"], capture=True)
    run(["/usr/bin/env", "sh", "-lc", f"pkill -f 'wpa_supplicant.*-i ?{AP_IFACE}' || true"], capture=True)
    run(["ip", "link", "set", AP_IFACE, "down"], capture=True)
    run(["ip", "addr", "flush", "dev", AP_IFACE], capture=True)
    run(["ip", "link", "set", AP_IFACE, "up"], check=True)
    run(["wpa_supplicant", "-B", "-i", AP_IFACE, "-c", str(wpa_conf), "-D", "nl80211"], check=True)
    run(["systemctl", "restart", "systemd-networkd"], capture=True)
    run(["ip", "addr", "replace", f"{AP_ADDR}/{AP_PREFIX}", "dev", AP_IFACE], capture=True)
    write_state(current_state({"mode": "setup-ap", "ap_backend": "wpa_supplicant-networkd", "ap_security": security}))


def normalize_form_value(value):
    value = value.strip()
    if len(value) >= 2 and value[0] == value[-1] and value[0] in {"'", '"'}:
        return value[1:-1]
    return value


def nm_keyfile_value(value):
    if "\n" in value or "\r" in value:
        raise ValueError("Wi-Fi values cannot contain newlines")
    return value.replace("\\", "\\\\").replace(";", "\\;")


def static_ip_keyfile_lines(config):
    if not config.get("enabled"):
        return ["method=auto"]
    lines = ["method=manual", f"address1={config['address_cidr']},{config.get('gateway', '')}"]
    dns = config.get("dns") or []
    if dns:
        lines.append(f"dns={';'.join(dns)};")
    return lines


def write_networkmanager_wifi(ssid, password):
    NM_CONNECTION_DIR.mkdir(parents=True, exist_ok=True)
    run(["nmcli", "connection", "delete", "yari-wifi"], capture=True)
    connection = NM_CONNECTION_DIR / "yari-wifi.nmconnection"
    static_config = read_static_ip_config()
    content = "\n".join([
        "[connection]",
        "id=yari-wifi",
        f"uuid={uuid.uuid4()}",
        "type=wifi",
        f"interface-name={AP_IFACE}",
        "autoconnect=true",
        "autoconnect-priority=100",
        "",
        "[wifi]",
        "mode=infrastructure",
        f"ssid={nm_keyfile_value(ssid)}",
        "",
        "[wifi-security]",
        "key-mgmt=wpa-psk",
        f"psk={nm_keyfile_value(password)}",
        "",
        "[ipv4]",
        *static_ip_keyfile_lines(static_config),
        "",
        "[ipv6]",
        "method=ignore",
        "",
        "[proxy]",
        "",
    ])
    connection.write_text(content)
    os.chown(connection, 0, 0)
    os.chmod(connection, 0o600)
    run(["nmcli", "connection", "reload"], check=True)


def write_netplan(ssid, password):
    netplan = NETPLAN_DIR / "01-yari-wifi.yaml"
    netplan.parent.mkdir(parents=True, exist_ok=True)
    escaped_ssid = ssid.replace('"', '\\"')
    escaped_password = password.replace('"', '\\"')
    content = (
        "network:\n"
        "  version: 2\n"
        "  renderer: networkd\n"
        "  ethernets:\n"
        "    eth0:\n"
        "      dhcp4: true\n"
        "      optional: true\n"
        "  wifis:\n"
        f"    {AP_IFACE}:\n"
        "      dhcp4: true\n"
        "      optional: true\n"
        "      access-points:\n"
        f"        \"{escaped_ssid}\":\n"
        f"          password: \"{escaped_password}\"\n"
    )
    netplan.write_text(content)
    os.chmod(netplan, 0o600)
    cloud = CLOUD_CFG_DIR / "99-yari-disable-network-config.cfg"
    cloud.parent.mkdir(parents=True, exist_ok=True)
    cloud.write_text("network: {config: disabled}\n")


def parse_bool(value):
    return value in {True, "true", "on", "1", "yes", "enabled", 1}


def read_static_ip_config():
    config = read_json_file(STATIC_NETWORK_CONFIG_FILE, {})
    if not isinstance(config, dict):
        config = {}
    return {
        "enabled": bool(config.get("enabled", False)),
        "connection_name": str(config.get("connection_name") or "yari-wifi"),
        "address_cidr": str(config.get("address_cidr") or ""),
        "gateway": str(config.get("gateway") or ""),
        "dns": [str(item) for item in config.get("dns", []) if item],
        "config_file": str(STATIC_NETWORK_CONFIG_FILE),
    }


def normalize_static_ip_config(payload):
    enabled = parse_bool(payload.get("enabled"))
    connection_name = re.sub(r"[^a-zA-Z0-9_.-]+", "-", str(payload.get("connection_name") or "yari-wifi")).strip("-") or "yari-wifi"
    address = str(payload.get("address_cidr") or payload.get("address") or "").strip()
    gateway = str(payload.get("gateway") or "").strip()
    dns_value = payload.get("dns") or []
    if isinstance(dns_value, str):
        dns = [item for item in re.split(r"[\s,;]+", dns_value.strip()) if item]
    elif isinstance(dns_value, list):
        dns = [str(item).strip() for item in dns_value if str(item).strip()]
    else:
        raise ValueError("dns must be a string or list")
    if enabled:
        if not address:
            raise ValueError("address_cidr is required when static IP is enabled")
        try:
            ipaddress.ip_interface(address)
        except ValueError as exc:
            raise ValueError(f"invalid static address_cidr: {exc}") from exc
        if gateway:
            try:
                ipaddress.ip_address(gateway)
            except ValueError as exc:
                raise ValueError(f"invalid gateway: {exc}") from exc
        for server in dns:
            try:
                ipaddress.ip_address(server)
            except ValueError as exc:
                raise ValueError(f"invalid DNS server {server}: {exc}") from exc
    return {"enabled": enabled, "connection_name": connection_name, "address_cidr": address, "gateway": gateway, "dns": dns}


def apply_static_ip_networkmanager(config):
    connection_name = config.get("connection_name") or "yari-wifi"
    if config.get("enabled"):
        args = [
            "nmcli", "connection", "modify", connection_name,
            "ipv4.method", "manual",
            "ipv4.addresses", config["address_cidr"],
            "ipv4.gateway", config.get("gateway", ""),
            "ipv4.dns", ",".join(config.get("dns", [])),
            "ipv6.method", "ignore",
        ]
    else:
        args = [
            "nmcli", "connection", "modify", connection_name,
            "ipv4.method", "auto",
            "ipv4.addresses", "",
            "ipv4.gateway", "",
            "ipv4.dns", "",
            "ipv6.method", "ignore",
        ]
    run(args, check=True)
    run(["nmcli", "connection", "reload"], check=True)


def save_static_ip_config(payload):
    config = normalize_static_ip_config(payload)
    STATIC_NETWORK_CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
    STATIC_NETWORK_CONFIG_FILE.write_text(json.dumps(config, indent=2) + "\n")
    os.chmod(STATIC_NETWORK_CONFIG_FILE, 0o600)
    if has_command("nmcli") and APPLY_NETWORK:
        apply_static_ip_networkmanager(config)
    return {"ok": True, "static_ip": read_static_ip_config(), "applied": bool(has_command("nmcli") and APPLY_NETWORK)}


def default_network_policy():
    return {
        "fallback_ap_enabled": True,
        "fallback_timeout_sec": CONNECTIVITY_TIMEOUT,
        "maintenance_ap_enabled": False,
        "serve_portal_on_client_network": True,
    }


def read_network_policy():
    config = {**default_network_policy(), **read_json_file(NETWORK_POLICY_CONFIG_FILE, {})}
    try:
        timeout = int(config.get("fallback_timeout_sec", CONNECTIVITY_TIMEOUT))
    except (TypeError, ValueError):
        timeout = CONNECTIVITY_TIMEOUT
    config["fallback_timeout_sec"] = max(5, min(timeout, 600))
    config["fallback_ap_enabled"] = bool(config.get("fallback_ap_enabled", True))
    config["maintenance_ap_enabled"] = bool(config.get("maintenance_ap_enabled", False))
    config["serve_portal_on_client_network"] = bool(config.get("serve_portal_on_client_network", True))
    config["config_file"] = str(NETWORK_POLICY_CONFIG_FILE)
    return config


def save_network_policy(payload):
    timeout = int(payload.get("fallback_timeout_sec", CONNECTIVITY_TIMEOUT))
    if timeout < 5 or timeout > 600:
        raise ValueError("fallback_timeout_sec must be between 5 and 600")
    config = {
        "fallback_ap_enabled": parse_bool(payload.get("fallback_ap_enabled", True)),
        "fallback_timeout_sec": timeout,
        "maintenance_ap_enabled": parse_bool(payload.get("maintenance_ap_enabled", False)),
        "serve_portal_on_client_network": parse_bool(payload.get("serve_portal_on_client_network", True)),
        "updated": int(time.time()),
    }
    NETWORK_POLICY_CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
    NETWORK_POLICY_CONFIG_FILE.write_text(json.dumps(config, indent=2) + "\n")
    os.chmod(NETWORK_POLICY_CONFIG_FILE, 0o600)
    return {"ok": True, "policy": read_network_policy()}


def configure_wifi(ssid, password, hostname=""):
    ssid = normalize_form_value(ssid)
    password = normalize_form_value(password)
    if not ssid or not password:
        raise ValueError("ssid and password are required")
    if hostname:
        safe_hostname = re.sub(r"[^a-z0-9-]+", "-", hostname.strip().lower()).strip("-")
        if safe_hostname:
            HOSTNAME_FILE.parent.mkdir(parents=True, exist_ok=True)
            HOSTNAME_FILE.write_text(safe_hostname + "\n")
            if APPLY_NETWORK:
                run(["hostnamectl", "set-hostname", safe_hostname], capture=True)
    if has_command("nmcli") and APPLY_NETWORK:
        write_networkmanager_wifi(ssid, password)
    else:
        write_netplan(ssid, password)
        if APPLY_NETWORK:
            run(["netplan", "generate"], check=True)
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    COMPLETE_FILE.touch()
    write_state(current_state({"mode": "configured", "configured_ssid": ssid}))


def save_setup_config(payload):
    ssid = str(payload.get("ssid") or "")
    password = str(payload.get("password") or "")
    hostname = str(payload.get("hostname") or "")
    configured_wifi = False
    if ssid or password:
        configure_wifi(ssid, password, hostname)
        configured_wifi = True
    elif hostname:
        safe_hostname = re.sub(r"[^a-z0-9-]+", "-", hostname.strip().lower()).strip("-")
        if safe_hostname:
            HOSTNAME_FILE.parent.mkdir(parents=True, exist_ok=True)
            HOSTNAME_FILE.write_text(safe_hostname + "\n")
            if APPLY_NETWORK:
                run(["hostnamectl", "set-hostname", safe_hostname], capture=True)
    ssh = save_ssh_access(payload.get("ssh_key", ""), payload.get("ssh_password", ""))
    tokens = save_pairing_tokens(payload.get("atlas_token", ""), payload.get("foxglove_token", ""))
    config = read_json_file(PORTAL_CONFIG_FILE, {})
    config.update({"hostname": hostname, "updated": int(time.time())})
    profile_payload = payload.get("device_profile") if isinstance(payload.get("device_profile"), dict) else payload
    profile_keys = {"profile_preset", "vehicle_class", "autopilot_stack", "compute_target", "ros_domain_id", "notes"}
    if any(key in profile_payload for key in profile_keys):
        config["device_profile"] = normalize_device_profile(profile_payload)
    if payload.get("atlas_url"):
        config["atlas_url"] = normalize_form_value(str(payload.get("atlas_url")))
    if payload.get("atlas_upload_url"):
        config["atlas_upload_url"] = normalize_form_value(str(payload.get("atlas_upload_url")))
    PORTAL_CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
    PORTAL_CONFIG_FILE.write_text(json.dumps(config, indent=2) + "\n")
    os.chmod(PORTAL_CONFIG_FILE, 0o600)
    state = current_state({"mode": "configured" if configured_wifi else read_state().get("mode", "client"), "portal_config": portal_config_status()})
    write_state(state)
    return {"ok": True, "wifi_configured": configured_wifi, "ssh": ssh, "tokens": tokens, "state": state}


def reboot_soon():
    def delayed():
        time.sleep(2)
        run(["systemctl", "reboot"], capture=False)
    threading.Thread(target=delayed, daemon=True).start()



def split_escaped(value, separator=":"):
    parts = []
    current = []
    escaped = False
    for char in value:
        if escaped:
            current.append(char)
            escaped = False
        elif char == "\\":
            escaped = True
        elif char == separator:
            parts.append("".join(current))
            current = []
        else:
            current.append(char)
    if escaped:
        current.append("\\")
    parts.append("".join(current))
    return parts


def parse_kv_lines(output, separator=":"):
    rows = []
    for line in output.splitlines():
        if not line.strip():
            continue
        rows.append([part.strip() for part in split_escaped(line, separator)])
    return rows


def parse_lsblk_json():
    result = command_output(["lsblk", "-J", "-o", "NAME,TYPE,SIZE,MOUNTPOINT,MODEL,TRAN"], timeout=6)
    if not result["ok"]:
        return []
    try:
        return json.loads(result["stdout"]).get("blockdevices", [])
    except json.JSONDecodeError:
        return []


def device_status():
    meminfo = read_text_file("/proc/meminfo")
    memory = {}
    for line in meminfo.splitlines():
        key, _, value = line.partition(":")
        if key in {"MemTotal", "MemAvailable", "SwapTotal", "SwapFree"}:
            memory[key] = value.strip()
    temp = read_text_file("/sys/class/thermal/thermal_zone0/temp")
    temperature_c = None
    if temp.isdigit():
        temperature_c = round(int(temp) / 1000, 1)
    return {
        "device_id": device_id(),
        "device_model": device_model(),
        "hostname": socket.gethostname(),
        "os_release": read_text_file("/etc/os-release"),
        "kernel": command_output(["uname", "-r"])["stdout"],
        "architecture": command_output(["uname", "-m"])["stdout"],
        "uptime": read_text_file("/proc/uptime"),
        "load_average": read_text_file("/proc/loadavg"),
        "cpu_count": os.cpu_count(),
        "memory": memory,
        "temperature_c": temperature_c,
        "ip_addresses": command_output(["hostname", "-I"])["stdout"].split(),
        "storage": parse_lsblk_json(),
        "onboarding": read_state(),
        "portal": portal_version(),
        "profile": read_device_profile(),
    }


def nm_active_connections():
    result = command_output(["nmcli", "-t", "-f", "NAME,UUID,TYPE,DEVICE", "connection", "show", "--active"])
    if not result["ok"]:
        return []
    connections = []
    for row in parse_kv_lines(result["stdout"]):
        if len(row) >= 4:
            connections.append({"name": row[0], "uuid": row[1], "type": row[2], "device": row[3]})
    return connections


def network_status():
    interfaces = []
    ip_result = command_output(["ip", "-j", "addr", "show"], timeout=6)
    if ip_result["ok"]:
        try:
            interfaces = json.loads(ip_result["stdout"])
        except json.JSONDecodeError:
            interfaces = []
    nm_status = command_output(["nmcli", "-t", "-f", "DEVICE,TYPE,STATE,CONNECTION", "device", "status"])
    devices = []
    if nm_status["ok"]:
        for row in parse_kv_lines(nm_status["stdout"]):
            if len(row) >= 4:
                devices.append({"device": row[0], "type": row[1], "state": row[2], "connection": row[3]})
    return {
        "connected": has_connectivity(),
        "wifi_iface": AP_IFACE,
        "networkmanager": has_command("nmcli"),
        "active_connections": nm_active_connections(),
        "devices": devices,
        "interfaces": interfaces,
        "config": network_config_placeholders(),
        "onboarding": read_state(),
    }


def output_lines(result, limit=120):
    combined = "\n".join(part for part in (result.get("stdout", ""), result.get("stderr", "")) if part)
    lines = combined.splitlines()
    if len(lines) > limit:
        return lines[-limit:]
    return lines


def filtered_lines(text, patterns, limit=80):
    regex = re.compile("|".join(patterns), re.IGNORECASE)
    lines = [line for line in text.splitlines() if regex.search(line)]
    if len(lines) > limit:
        return lines[-limit:]
    return lines


def network_diagnostics():
    iface = AP_IFACE
    checks = {
        "ipv4_global_address": command_output(["/usr/bin/env", "sh", "-lc", "ip -4 addr show scope global | grep -q inet"], timeout=5)["ok"],
        "default_route": command_output(["/usr/bin/env", "sh", "-lc", "ip route | grep -q '^default'"], timeout=5)["ok"],
        "dns_servers": bool(dns_status()),
    }
    route_probe = command_output(["ip", "route", "get", "1.1.1.1"], timeout=5)
    nm_general = command_output(["nmcli", "-t", "-f", "STATE,CONNECTIVITY,WIFI-HW,WIFI,WWAN-HW,WWAN", "general"], timeout=6) if has_command("nmcli") else {"ok": False, "stdout": "", "stderr": "nmcli not installed", "returncode": 127}
    nm_device = command_output(["nmcli", "-t", "-f", "DEVICE,TYPE,STATE,CONNECTION", "device", "status"], timeout=6) if has_command("nmcli") else {"ok": False, "stdout": "", "stderr": "nmcli not installed", "returncode": 127}
    nm_wifi = command_output(["nmcli", "-t", "-f", "802-11-wireless.ssid,802-11-wireless-security.key-mgmt", "connection", "show", "yari-wifi"], timeout=6) if has_command("nmcli") else {"ok": False, "stdout": "", "stderr": "nmcli not installed", "returncode": 127}
    nm_ap = command_output(["nmcli", "-t", "-f", "802-11-wireless.ssid,802-11-wireless.mode,ipv4.method", "connection", "show", "yari-setup-ap"], timeout=6) if has_command("nmcli") else {"ok": False, "stdout": "", "stderr": "nmcli not installed", "returncode": 127}
    journal = command_output(["journalctl", "-u", "NetworkManager", "-b", "-n", "240", "--no-pager"], timeout=12)
    failure_patterns = [
        re.escape(iface),
        "yari-wifi",
        "yari-setup-ap",
        "failed",
        "no-secrets",
        "ssid-not-found",
        "association took too long",
        "IP configuration could not be reserved",
        "supplicant",
        "not connected",
    ]
    return {
        "ok": all(checks.values()),
        "checked_at": int(time.time()),
        "wifi_iface": iface,
        "checks": checks,
        "connectivity": has_connectivity(),
        "state": read_state(),
        "route_probe": {"ok": route_probe["ok"], "lines": output_lines(route_probe, 20)},
        "networkmanager": {
            "installed": has_command("nmcli"),
            "general": {"ok": nm_general["ok"], "lines": output_lines(nm_general, 20)},
            "devices": {"ok": nm_device["ok"], "lines": output_lines(nm_device, 40)},
            "yari_wifi_profile": {"ok": nm_wifi["ok"], "lines": output_lines(nm_wifi, 20)},
            "setup_ap_profile": {"ok": nm_ap["ok"], "lines": output_lines(nm_ap, 20)},
            "recent_clues": filtered_lines(journal.get("stdout", "") + "\n" + journal.get("stderr", ""), failure_patterns),
        },
        "dns": {"servers": dns_status(), "resolv_conf": read_text_file("/etc/resolv.conf")},
        "active_connections": nm_active_connections(),
    }


def reconnect_wifi():
    if not has_command("nmcli"):
        return {"ok": False, "error": "NetworkManager/nmcli is not installed", "diagnostics": network_diagnostics()}
    run(["nmcli", "connection", "down", "yari-setup-ap"], capture=True)
    result = command_output(["nmcli", "connection", "up", "yari-wifi"], timeout=45)
    if result["ok"]:
        wait_for_connectivity(10)
    return {"ok": result["ok"], "stdout": result["stdout"], "stderr": result["stderr"], "diagnostics": network_diagnostics()}


def forget_wifi():
    for path in (NM_CONNECTION_DIR / "yari-wifi.nmconnection", NETPLAN_DIR / "01-yari-wifi.yaml"):
        path.unlink(missing_ok=True)
    if has_command("nmcli"):
        run(["nmcli", "connection", "delete", "yari-wifi"], capture=True)
        run(["nmcli", "connection", "reload"], capture=True)
    state = current_state({"mode": "wifi-forgotten", "complete": False, "message": "saved client Wi-Fi profile removed"})
    write_state(state)
    return {"ok": True, "state": state, "diagnostics": network_diagnostics()}


def wifi_scan():
    if not has_command("nmcli"):
        return {"ok": False, "error": "NetworkManager/nmcli is not installed", "networks": []}
    run(["nmcli", "device", "wifi", "rescan", "ifname", AP_IFACE], capture=True)
    fields = "SSID,BSSID,CHAN,FREQ,RATE,SIGNAL,SECURITY"
    result = command_output(["nmcli", "-t", "-f", fields, "device", "wifi", "list", "ifname", AP_IFACE], timeout=12)
    networks = []
    if result["ok"]:
        for row in parse_kv_lines(result["stdout"]):
            if len(row) >= 7 and row[0]:
                networks.append({
                    "ssid": row[0],
                    "bssid": row[1],
                    "channel": row[2],
                    "frequency": row[3],
                    "rate": row[4],
                    "signal": row[5],
                    "security": row[6],
                })
    return {"ok": result["ok"], "error": result["stderr"], "networks": networks}


def service_name(name):
    service = SERVICE_ALLOWLIST.get(name)
    if not service:
        raise ValueError(f"Unsupported service '{name}'")
    return service


def service_status(name, unit=None):
    unit = unit or service_name(name)
    active = command_output(["systemctl", "is-active", unit], timeout=5)
    enabled = command_output(["systemctl", "is-enabled", unit], timeout=5)
    return {
        "name": name,
        "unit": unit,
        "active": active["stdout"] or "unknown",
        "enabled": enabled["stdout"] or "unknown",
        "available": active["returncode"] != 4,
    }


def service_manager_role_for_name(name):
    if name == "yari-agent":
        return "agent"
    if name.startswith("yari-"):
        return name.removeprefix("yari-")
    return ""


def services_status():
    services = []
    for name, unit in SERVICE_ALLOWLIST.items():
        status = service_status(name, unit)
        role = service_manager_role_for_name(name)
        if role:
            status["manager_state"] = service_manager_status(role)
        services.append(status)
    return {"services": services}


def service_action(name, action):
    unit = service_name(name)
    if action not in {"start", "stop", "restart", "enable", "disable"}:
        raise ValueError(f"Unsupported service action '{action}'")
    result = command_output(["systemctl", action, unit], timeout=20)
    return {"ok": result["ok"], "service": service_status(name, unit), "stdout": result["stdout"], "stderr": result["stderr"]}


def service_logs(name, lines=120):
    unit = service_name(name)
    lines = max(1, min(int(lines), 500))
    result = command_output(["journalctl", "-u", unit, "-n", str(lines), "--no-pager"], timeout=10)
    return {"ok": result["ok"], "name": name, "unit": unit, "logs": result["stdout"], "error": result["stderr"]}


def app_permission_review(permissions, runtime="service-bundle", container=None, devices=None, volumes=None):
    severity_rank = {"low": 0, "medium": 1, "high": 2}
    items = []
    for permission in permissions:
        severity, reason = APP_PERMISSION_LABELS.get(permission, ("low", "Declared app permission"))
        items.append({"permission": permission, "risk": severity, "reason": reason})
    container = container or {}
    if runtime == "container" and container.get("privileged") and not any(item["permission"] == "system.privileged" for item in items):
        items.append({"permission": "system.privileged", "risk": "high", "reason": "Privileged container access"})
    if runtime == "container" and container.get("network") == "host" and not any(item["permission"] == "network.host" for item in items):
        items.append({"permission": "network.host", "risk": "high", "reason": "Host network namespace access"})
    if devices and not any(item["permission"] in {"camera.read", "serial.read-write", "can.read-write", "gpu.access"} for item in items):
        items.append({"permission": "devices", "risk": "medium", "reason": "Container device mappings"})
    if volumes and not any(item["permission"] == "storage.persistent" for item in items):
        items.append({"permission": "volumes", "risk": "medium", "reason": "Container volume mappings"})
    risk = "low"
    if items:
        risk = max((item["risk"] for item in items), key=lambda value: severity_rank[value])
    return {"risk": risk, "items": items}


def validate_app_device_path(device, permissions):
    device = str(device or "").strip()
    if not device or "\n" in device or "\r" in device or not device.startswith("/dev/"):
        raise ValueError(f"Invalid app device '{device}'")
    for permission, prefixes in APP_PERMISSION_DEVICE_PREFIXES.items():
        if permission in permissions and any(device == prefix or device.startswith(prefix) for prefix in prefixes):
            return device
    raise ValueError(f"App device '{device}' requires a matching device permission")


def parse_app_volume(volume):
    value = str(volume or "").strip()
    if not value or "\n" in value or "\r" in value:
        raise ValueError(f"Invalid app volume '{value}'")
    parts = value.split(":")
    if len(parts) not in {2, 3}:
        raise ValueError(f"Invalid app volume '{value}'")
    host_path, container_path = parts[0], parts[1]
    options = parts[2].split(",") if len(parts) == 3 and parts[2] else []
    if not host_path.startswith("/") or not container_path.startswith("/"):
        raise ValueError(f"Invalid app volume '{value}'")
    if any(option not in APP_VOLUME_OPTIONS for option in options):
        raise ValueError(f"Invalid app volume option in '{value}'")
    return host_path, container_path, options


def validate_app_volume(volume, app_id, permissions, runtime):
    value = str(volume or "").strip()
    if not value or "\n" in value or "\r" in value:
        raise ValueError(f"Invalid app volume '{value}'")
    if runtime != "container":
        return value
    host_path, _, _ = parse_app_volume(value)
    allowed_prefixes = tuple(f"{prefix}{app_id}/" for prefix in APP_VOLUME_HOST_PREFIXES)
    if "storage.persistent" not in permissions:
        raise ValueError(f"App volume '{value}' requires storage.persistent permission")
    if not any(host_path == prefix[:-1] or host_path.startswith(prefix) for prefix in allowed_prefixes):
        raise ValueError(f"App volume '{value}' must be under a YARI app data directory")
    return value


def validate_container_runtime_options(app_id, runtime, container, permissions):
    network = str(container.get("network") or "bridge")
    if network not in {"bridge", "host", "none"}:
        raise ValueError(f"Invalid container network '{network}'")
    if runtime == "container" and network == "host" and "network.host" not in permissions:
        raise ValueError(f"Container app '{app_id}' requires network.host permission for host networking")
    capabilities = []
    for item in container.get("capabilities", []):
        capability = str(item).strip().upper()
        if not capability:
            continue
        if capability not in APP_SAFE_CAPABILITIES:
            raise ValueError(f"Unsupported container capability '{capability}'")
        if "system.capabilities" not in permissions:
            raise ValueError(f"Container app '{app_id}' requires system.capabilities permission")
        capabilities.append(capability)
    privileged = bool(container.get("privileged", False))
    if runtime == "container" and privileged and "system.privileged" not in permissions:
        raise ValueError(f"Container app '{app_id}' requires system.privileged permission")
    return network, privileged, capabilities


def normalize_app_manifest(manifest, source="builtin"):
    if not isinstance(manifest, dict):
        raise ValueError("App manifest must be a JSON object")
    schema_version = str(manifest.get("schema_version") or APP_MANIFEST_SCHEMA_VERSION)
    if schema_version != APP_MANIFEST_SCHEMA_VERSION:
        raise ValueError(f"Unsupported app manifest schema_version '{schema_version}'")
    app_id = str(manifest.get("id") or "").strip()
    if not re.match(r"^[a-z0-9][a-z0-9_.-]{1,63}$", app_id):
        raise ValueError(f"Invalid app id '{app_id}'")
    runtime = str(manifest.get("runtime") or manifest.get("kind") or "service-bundle")
    if runtime not in {"core-service", "service-bundle", "container"}:
        raise ValueError(f"Unsupported app runtime '{runtime}'")
    services = []
    for item in manifest.get("services", []):
        service = str(item).strip()
        if not service:
            continue
        if service not in SERVICE_ALLOWLIST and not re.match(r"^[A-Za-z0-9_.@-]+\.service$", service):
            raise ValueError(f"Invalid app service '{service}'")
        services.append(service)
    if runtime in {"core-service", "service-bundle"} and not services:
        raise ValueError(f"App runtime '{runtime}' requires at least one service")
    container = manifest.get("container") if isinstance(manifest.get("container"), dict) else {}
    if runtime == "container" and not str(container.get("image") or "").strip():
        raise ValueError("Container app manifests require container.image")
    ports = []
    for port in manifest.get("ports", []):
        if isinstance(port, dict):
            value = int(port.get("container"))
            host = port.get("host")
            if host is not None:
                host = int(host)
                if host < 1 or host > 65535:
                    raise ValueError(f"Invalid app host port '{port}'")
            protocol = str(port.get("protocol") or "tcp").lower()
            if protocol not in {"tcp", "udp"}:
                raise ValueError(f"Invalid app port protocol '{protocol}'")
            normalized_port = {"container": value, "protocol": protocol}
            if host is not None:
                normalized_port["host"] = host
            if port.get("description"):
                normalized_port["description"] = str(port.get("description"))
        else:
            value = int(port)
            normalized_port = value
        if value < 1 or value > 65535:
            raise ValueError(f"Invalid app port '{port}'")
        ports.append(normalized_port)
    permissions = []
    for item in manifest.get("permissions", []):
        permission = str(item).strip()
        if not permission:
            continue
        if not APP_PERMISSION_PATTERN.match(permission):
            raise ValueError(f"Invalid app permission '{permission}'")
        if permission not in permissions:
            permissions.append(permission)
    ui = manifest.get("ui") if isinstance(manifest.get("ui"), dict) else {}
    network, privileged, capabilities = validate_container_runtime_options(app_id, runtime, container, permissions)
    environment = {}
    if isinstance(container.get("environment"), dict):
        for key, value in container.get("environment", {}).items():
            env_key = str(key)
            if not re.match(r"^[A-Za-z_][A-Za-z0-9_]*$", env_key):
                raise ValueError(f"Invalid container environment variable '{env_key}'")
            environment[env_key] = str(value)
    devices = [validate_app_device_path(item, permissions) for item in manifest.get("devices", []) if str(item).strip()]
    volumes = [validate_app_volume(item, app_id, permissions, runtime) for item in manifest.get("volumes", []) if str(item).strip()]
    permission_review = app_permission_review(permissions, runtime, container, devices, volumes)

    return {
        "schema_version": schema_version,
        "id": app_id,
        "name": str(manifest.get("name") or app_id),
        "version": str(manifest.get("version") or "unknown"),
        "kind": runtime,
        "runtime": runtime,
        "description": str(manifest.get("description") or ""),
        "services": services,
        "ports": ports,
        "permissions": permissions,
        "permission_review": permission_review,
        "devices": devices,
        "volumes": volumes,
        "healthcheck": manifest.get("healthcheck", {}) if isinstance(manifest.get("healthcheck", {}), dict) else {},
        "container": {
            "image": str(container.get("image") or ""),
            "network": network,
            "privileged": privileged,
            "capabilities": capabilities,
            "environment": environment,
        },
        "ui": {"path": str(ui.get("path") or "")},
        "source": source,
    }


def app_service_statuses(app):
    statuses = []
    for name in app.get("services", []):
        if name in SERVICE_ALLOWLIST:
            statuses.append(service_status(name))
        elif name.endswith(".service"):
            statuses.append(service_status(name.removesuffix(".service"), name))
        else:
            statuses.append({"name": name, "unit": name, "active": "unknown", "enabled": "unknown", "available": False})
    return statuses


def app_health_from_services(statuses):
    if not statuses:
        return "not-managed"
    active = [status.get("active") for status in statuses]
    if all(value == "active" for value in active):
        return "running"
    if any(value == "active" for value in active):
        return "partial"
    if any(value in {"failed", "activating", "deactivating"} for value in active):
        return "attention"
    return "stopped"


def container_runtime_status():
    for binary in ("podman", "docker"):
        if has_command(binary):
            version = command_output([binary, "--version"], timeout=5)
            return {"available": True, "runtime": binary, "name": binary, "version": version.get("stdout", ""), "error": version.get("stderr", "")}
    return {"available": False, "runtime": "", "name": "", "version": "", "error": "Docker or Podman is not installed"}


def app_container_name(app_id):
    if not re.match(r"^[a-z0-9][a-z0-9_.-]{1,63}$", app_id):
        raise ValueError(f"Invalid app id '{app_id}'")
    return "yari-" + re.sub(r"[^a-zA-Z0-9_.-]", "-", app_id)


def container_status(app):
    if app.get("runtime") != "container":
        return {"managed": False}
    runtime = container_runtime_status()
    name = app_container_name(app["id"])
    status = {"managed": True, "name": name, "runtime": runtime, "active": "unknown"}
    if not runtime["available"]:
        status["active"] = "runtime-missing"
        return status
    result = command_output([runtime["runtime"], "inspect", "--format", "{{.State.Status}}", name], timeout=8)
    status["active"] = result["stdout"] if result["ok"] and result["stdout"] else "not-created"
    status["error"] = result["stderr"]
    return status


def container_health(status):
    active = status.get("active")
    if active == "running":
        return "running"
    if active in {"runtime-missing", "unknown"}:
        return "attention"
    return "stopped"


def app_healthcheck_status(app):
    healthcheck = app.get("healthcheck") if isinstance(app.get("healthcheck"), dict) else {}
    check_type = str(healthcheck.get("type") or "").strip().lower()
    if not check_type:
        return {"configured": False, "ok": None, "state": "not-configured"}
    if check_type == "service":
        service = str(healthcheck.get("service") or "").strip()
        if not service:
            return {"configured": True, "ok": False, "state": "invalid", "error": "service healthcheck requires service"}
        for status in app_service_statuses({"services": [service]}):
            ok = status.get("active") == "active"
            return {"configured": True, "ok": ok, "state": "passing" if ok else "failing", "service": service, "status": status}
    if check_type == "tcp":
        host = str(healthcheck.get("host") or "127.0.0.1")
        port = int(healthcheck.get("port") or 0)
        timeout = max(1, min(int(healthcheck.get("timeout_sec") or 2), 10))
        if port < 1 or port > 65535:
            return {"configured": True, "ok": False, "state": "invalid", "error": "tcp healthcheck requires port 1-65535"}
        try:
            with socket.create_connection((host, port), timeout=timeout):
                return {"configured": True, "ok": True, "state": "passing", "type": "tcp", "host": host, "port": port}
        except OSError as exc:
            return {"configured": True, "ok": False, "state": "failing", "type": "tcp", "host": host, "port": port, "error": str(exc)}
    if check_type == "http":
        url = str(healthcheck.get("url") or "")
        timeout = max(1, min(int(healthcheck.get("timeout_sec") or 3), 10))
        parsed = urlparse(url)
        if parsed.scheme not in {"http", "https"} or not parsed.hostname:
            return {"configured": True, "ok": False, "state": "invalid", "error": "http healthcheck requires http(s) url"}
        path = parsed.path or "/"
        if parsed.query:
            path += "?" + parsed.query
        connection_class = http.client.HTTPSConnection if parsed.scheme == "https" else http.client.HTTPConnection
        try:
            connection = connection_class(parsed.hostname, parsed.port, timeout=timeout)
            try:
                connection.request("GET", path)
                response = connection.getresponse()
                ok = 200 <= response.status < 400
                return {"configured": True, "ok": ok, "state": "passing" if ok else "failing", "type": "http", "url": url, "status": response.status}
            finally:
                connection.close()
        except OSError as exc:
            return {"configured": True, "ok": False, "state": "failing", "type": "http", "url": url, "error": str(exc)}
    return {"configured": True, "ok": False, "state": "unsupported", "error": f"Unsupported healthcheck type '{check_type}'"}


def combine_app_health(base_health, healthcheck):
    if not healthcheck.get("configured"):
        return base_health
    if healthcheck.get("ok") is True:
        return "running" if base_health in {"running", "not-managed"} else base_health
    return "attention"


def app_manifest_digest(app):
    derived_fields = {
        "source",
        "installed",
        "installed_source",
        "installed_version",
        "registry_source",
        "service_status",
        "container_status",
        "healthcheck_status",
        "health",
        "actions",
        "update",
        "permission_review",
    }
    comparable = {key: value for key, value in app.items() if key not in derived_fields}
    payload = json.dumps(comparable, sort_keys=True, separators=(",", ":"))
    return hashlib.sha256(payload.encode("utf-8")).hexdigest()


def app_update_metadata(app, registry_app=None):
    metadata = {
        "manifest_digest": app_manifest_digest(app),
        "registry_version": "",
        "registry_digest": "",
        "update_available": False,
    }
    if registry_app:
        registry_digest = app_manifest_digest(registry_app)
        metadata.update({
            "registry_version": registry_app.get("version", ""),
            "registry_digest": registry_digest,
            "update_available": registry_digest != metadata["manifest_digest"],
        })
    return metadata


def raw_app_manifests():
    apps = []
    errors = []
    seen = set()
    for manifest in BUILTIN_APP_MANIFESTS:
        app = normalize_app_manifest(manifest, "builtin")
        seen.add(app["id"])
        apps.append(app)
    if APP_MANIFEST_DIR.exists():
        for path in sorted(APP_MANIFEST_DIR.glob("*.json")):
            try:
                app = normalize_app_manifest(json.loads(path.read_text()), str(path))
                if app["id"] in seen:
                    errors.append({"source": str(path), "error": f"duplicate app id '{app['id']}'"})
                    continue
                seen.add(app["id"])
                apps.append(app)
            except Exception as exc:
                errors.append({"source": str(path), "error": str(exc)})
    return apps, errors


def app_readiness(app, service_statuses=None, container_status_payload=None):
    runtime = app.get("runtime")
    if runtime == "container":
        status = container_status_payload if container_status_payload is not None else container_status(app)
        runtime_info = status.get("runtime") if isinstance(status.get("runtime"), dict) else {}
        if not runtime_info.get("available", False):
            return {"state": "blocked", "message": runtime_info.get("error") or "Docker or Podman is not installed"}
        if status.get("active") == "runtime-missing":
            return {"state": "blocked", "message": "Container runtime is missing"}
        return {"state": "ready", "message": f"Container runtime available: {runtime_info.get('name') or runtime_info.get('runtime') or 'container'}"}
    statuses = service_statuses if service_statuses is not None else app_service_statuses(app)
    if not statuses:
        return {"state": "blocked", "message": "No service is declared for this app"}
    unavailable = [status.get("unit") or status.get("name") for status in statuses if status.get("available") is False]
    if unavailable:
        return {"state": "blocked", "message": "Missing service unit: " + ", ".join(str(item) for item in unavailable)}
    return {"state": "ready", "message": "Declared services are available"}


def enrich_app(app, registry_app=None):
    app = dict(app)
    external = app.get("source") != "builtin"
    app["update"] = app_update_metadata(app, registry_app)
    app["service_status"] = app_service_statuses(app)
    app["container_status"] = container_status(app)
    app["readiness"] = app_readiness(app, app["service_status"], app["container_status"])
    if app.get("runtime") == "container":
        base_health = container_health(app["container_status"])
        can_run = app["readiness"].get("state") == "ready"
    else:
        base_health = app_health_from_services(app["service_status"])
        can_run = app["readiness"].get("state") == "ready"
    app["healthcheck_status"] = app_healthcheck_status(app)
    app["health"] = combine_app_health(base_health, app["healthcheck_status"])
    app["installed"] = True
    app["actions"] = {
        "install": False,
        "uninstall": external,
        "start": can_run,
        "stop": can_run,
        "restart": can_run,
        "logs": bool(app["service_status"]) or (app.get("runtime") == "container" and can_run),
        "update": bool(app["update"].get("update_available")),
    }
    return app


def recommended_apps_for_profile(profile=None):
    profile = profile or read_device_profile()
    vehicle_class = profile.get("vehicle_class", "ground_rover")
    autopilot_stack = profile.get("autopilot_stack", "none")
    base = [
        {"id": "yari-atlas-agent", "reason": "Atlas telemetry, pairing, uploads, and remote operations."},
        {"id": "yari-atlas-bridge", "reason": "Atlas live-control bridge for ROS 2 camera, telemetry, and commands."},
        {"id": "log-manager", "reason": "MCAP, service, and vehicle log collection."},
    ]
    if vehicle_class in {"ground_rover", "generic_edge"} or autopilot_stack in {"none", "ros_only"}:
        base.extend([
            {"id": "ros2-manager", "reason": "ROS 2 launch, topic discovery, and MCAP recording."},
            {"id": "rosbag-recorder", "reason": "Reusable MCAP recording profile for Foxglove/Atlas datasets."},
            {"id": "ground-slam-mapping", "reason": "Ground-robot SLAM and mapping profile for LiDAR, TF, odometry, and Nav2."},
            {"id": "video-manager", "reason": "Camera preview, Foxglove image readiness, and streaming settings."},
            {"id": "foxglove-bridge", "reason": "Live visualization and teleop through Foxglove."},
        ])
    if autopilot_stack in {"px4", "ardupilot"} or vehicle_class in {"multirotor", "fixed_wing", "vtol", "boat", "sub"}:
        base.extend([
            {"id": "mavlink-router", "reason": "PX4/ArduPilot MAVLink routing and autopilot status."},
            {"id": "autopilot-log-downloader", "reason": "PX4/ArduPilot log download, queueing, and upload readiness."},
            {"id": "video-manager", "reason": "Low-latency camera streams for remote piloting and inspection."},
            {"id": "foxglove-bridge", "reason": "Live MAVLink/ROS visualization during integration and debugging."},
        ])
    seen = set()
    recommendations = []
    for item in base:
        if item["id"] in seen:
            continue
        seen.add(item["id"])
        recommendations.append(item)
    return recommendations


def registry_apps_by_id():
    registry = {}
    if APP_REGISTRY_DIR.exists():
        for path in sorted(APP_REGISTRY_DIR.glob("*.json")):
            try:
                app = normalize_app_manifest(json.loads(path.read_text()), str(path))
                registry[app["id"]] = app
            except Exception:
                continue
    return registry


def app_catalog():
    apps, errors = raw_app_manifests()
    registry_by_id = registry_apps_by_id()
    enriched = [enrich_app(app, registry_by_id.get(app["id"])) for app in apps]
    app_ids = {app["id"] for app in enriched}
    recommendations = []
    for item in recommended_apps_for_profile():
        recommendations.append({**item, "installed": item["id"] in app_ids})
    return {
        "apps": enriched,
        "errors": errors,
        "manifest_dir": str(APP_MANIFEST_DIR),
        "schema_version": APP_MANIFEST_SCHEMA_VERSION,
        "container_runtime": container_runtime_status(),
        "device_profile": read_device_profile(),
        "recommendations": recommendations,
    }


def app_registry():
    apps = []
    errors = []
    installed_apps, installed_errors = raw_app_manifests()
    installed_by_id = {app["id"]: app for app in installed_apps}
    if APP_REGISTRY_DIR.exists():
        for path in sorted(APP_REGISTRY_DIR.glob("*.json")):
            try:
                app = normalize_app_manifest(json.loads(path.read_text()), str(path))
                installed = installed_by_id.get(app["id"])
                app["installed"] = installed is not None
                app["installed_version"] = installed.get("version", "") if installed else ""
                app["installed_source"] = installed.get("source", "") if installed else ""
                app["update"] = app_update_metadata(installed, app) if installed else {
                    "manifest_digest": "",
                    "registry_version": app.get("version", ""),
                    "registry_digest": app_manifest_digest(app),
                    "update_available": False,
                }
                if installed and installed.get("source") == "builtin":
                    can_apply = False
                    apply_reason = f"Built-in app '{app['id']}' is managed by the base image"
                elif installed:
                    can_apply = bool(app["update"].get("update_available"))
                    apply_reason = "update available" if can_apply else "installed manifest is current"
                else:
                    can_apply = True
                    apply_reason = "ready to install"
                app["readiness"] = app_readiness(app)
                app["registry_source"] = "local"
                app["actions"] = {
                    "apply": can_apply,
                    "install": not installed and can_apply,
                    "update": bool(installed and can_apply),
                    "reason": apply_reason,
                }
                apps.append(app)
            except Exception as exc:
                errors.append({"source": str(path), "error": str(exc)})
    installed_ids = {app["id"] for app in installed_apps}
    return {
        "apps": apps,
        "errors": errors,
        "registry_dir": str(APP_REGISTRY_DIR),
        "schema_version": APP_MANIFEST_SCHEMA_VERSION,
        "installed_ids": sorted(installed_ids),
    }


def file_sha256(path):
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def is_app_package_path(path):
    name = path.name
    return any(name.endswith(extension) for extension in APP_PACKAGE_EXTENSIONS)


def safe_package_name(name):
    name = str(name or "").strip()
    if not name or "/" in name or "\\" in name or ".." in name:
        raise ValueError(f"Invalid app package '{name}'")
    if not any(name.endswith(extension) for extension in APP_PACKAGE_EXTENSIONS):
        raise ValueError(f"Unsupported app package '{name}'")
    return name


def package_path(name):
    name = safe_package_name(name)
    path = APP_PACKAGE_DIR / name
    try:
        path.resolve().relative_to(APP_PACKAGE_DIR.resolve())
    except ValueError as exc:
        raise ValueError(f"App package '{name}' is outside {APP_PACKAGE_DIR}") from exc
    if not path.exists() or not path.is_file():
        raise ValueError(f"App package '{name}' not found")
    return path


def safe_tar_member_name(name):
    item = Path(str(name or ""))
    if item.is_absolute() or ".." in item.parts:
        raise ValueError(f"Package member path '{name}' is unsafe")
    return str(name)


def read_tar_json_member(archive, member):
    safe_tar_member_name(member.name)
    extracted = archive.extractfile(member)
    if extracted is None:
        raise ValueError(f"Package member '{member.name}' cannot be read")
    return extracted.read()


def find_package_member(members, names):
    direct = next((member for member in members if member.name in names), None)
    if direct is not None:
        return direct
    return next((member for member in members if any(member.name.endswith("/" + name) for name in names)), None)


def verify_app_package_signature(manifest_bytes, signature):
    if not APP_PACKAGE_PUBLIC_KEY_FILE.exists():
        return False, "public-key-missing"
    if not has_command("openssl"):
        return False, "openssl-missing"
    try:
        signature_bytes = base64.b64decode(signature, validate=True)
    except (binascii.Error, ValueError):
        return False, "invalid-signature-encoding"
    with tempfile.TemporaryDirectory(prefix="yari-app-signature-") as tmpdir:
        tmpdir_path = Path(tmpdir)
        manifest_path = tmpdir_path / "manifest.json"
        signature_path = tmpdir_path / "manifest.sig"
        manifest_path.write_bytes(manifest_bytes)
        signature_path.write_bytes(signature_bytes)
        try:
            command_output([
                "openssl",
                "dgst",
                "-sha256",
                "-verify",
                str(APP_PACKAGE_PUBLIC_KEY_FILE),
                "-signature",
                str(signature_path),
                str(manifest_path),
            ], timeout=20)
        except RuntimeError:
            return False, "verification-failed"
    return True, "verified"


def package_signature_status(metadata, manifest_bytes=None):
    signature = str(metadata.get("signature") or "").strip()
    signer = str(metadata.get("signed_by") or metadata.get("signer") or "").strip()
    signature_type = str(metadata.get("signature_type") or metadata.get("algorithm") or "").strip()
    present = bool(signature or signer or signature_type)
    verified = False
    status = "present-not-verified" if present else "missing"
    if present and signature and manifest_bytes is not None:
        verified, status = verify_app_package_signature(manifest_bytes, signature)
    if APP_REQUIRE_SIGNED_PACKAGES and not present:
        status = "required-missing"
    if APP_REQUIRE_VERIFIED_PACKAGES and present and not verified:
        status = "required-not-verified" if status == "present-not-verified" else status
    return {
        "required": APP_REQUIRE_SIGNED_PACKAGES,
        "verification_required": APP_REQUIRE_VERIFIED_PACKAGES,
        "public_key_file": str(APP_PACKAGE_PUBLIC_KEY_FILE),
        "present": present,
        "verified": verified,
        "status": status,
        "signed_by": signer,
        "signature_type": signature_type,
    }


def read_app_package(path):
    metadata = {}
    try:
        with tarfile.open(path, "r:*") as archive:
            members = [member for member in archive.getmembers() if member.isfile()]
            manifest_member = find_package_member(members, {"manifest.json", "app.json"})
            if manifest_member is None:
                raise ValueError("Package does not contain manifest.json")
            manifest_bytes = read_tar_json_member(archive, manifest_member)
            manifest_sha256 = hashlib.sha256(manifest_bytes).hexdigest()
            metadata_member = find_package_member(members, APP_PACKAGE_METADATA_NAMES)
            if metadata_member is not None:
                metadata_bytes = read_tar_json_member(archive, metadata_member)
                metadata = json.loads(metadata_bytes.decode("utf-8"))
            if not isinstance(metadata, dict):
                raise ValueError("Package metadata must be a JSON object")
            declared_manifest_sha256 = str(metadata.get("manifest_sha256") or "").strip().lower()
            if declared_manifest_sha256 and declared_manifest_sha256 != manifest_sha256:
                raise ValueError("Package manifest_sha256 does not match embedded manifest")
            manifest = json.loads(manifest_bytes.decode("utf-8"))
    except tarfile.TarError as exc:
        raise ValueError(f"Invalid app package archive: {exc}") from exc
    app = normalize_app_manifest(manifest, str(path))
    signature = package_signature_status(metadata, manifest_bytes)
    if APP_REQUIRE_SIGNED_PACKAGES and not signature["present"]:
        raise ValueError("App package signature is required")
    if APP_REQUIRE_VERIFIED_PACKAGES and not signature["verified"]:
        raise ValueError(f"App package signature verification failed: {signature['status']}")
    return {
        "app": app,
        "metadata": metadata,
        "manifest_sha256": manifest_sha256,
        "signature": signature,
    }


def read_app_package_manifest(path):
    return read_app_package(path)["app"]


def app_packages():
    packages = []
    errors = []
    installed_by_id = {app["id"]: app for app in raw_app_manifests()[0]}
    if APP_PACKAGE_DIR.exists():
        for path in sorted(item for item in APP_PACKAGE_DIR.iterdir() if item.is_file() and is_app_package_path(item)):
            try:
                package = read_app_package(path)
                app = package["app"]
                installed = installed_by_id.get(app["id"])
                stat = path.stat()
                packages.append({
                    "name": path.name,
                    "path": str(path),
                    "bytes": stat.st_size,
                    "modified": int(stat.st_mtime),
                    "sha256": file_sha256(path),
                    "manifest_sha256": package["manifest_sha256"],
                    "metadata": package["metadata"],
                    "signature": package["signature"],
                    "app": app,
                    "installed": installed is not None,
                    "installed_version": installed.get("version", "") if installed else "",
                    "update": app_update_metadata(installed, app) if installed else {
                        "manifest_digest": "",
                        "registry_version": app.get("version", ""),
                        "registry_digest": app_manifest_digest(app),
                        "update_available": False,
                    },
                })
            except Exception as exc:
                errors.append({"path": str(path), "error": str(exc)})
    return {
        "packages": packages,
        "errors": errors,
        "package_dir": str(APP_PACKAGE_DIR),
        "supported_extensions": list(APP_PACKAGE_EXTENSIONS),
        "signature_required": APP_REQUIRE_SIGNED_PACKAGES,
        "signature_verification_required": APP_REQUIRE_VERIFIED_PACKAGES,
        "signature_public_key_file": str(APP_PACKAGE_PUBLIC_KEY_FILE),
    }


def install_app_package(name, replace=False):
    path = package_path(name)
    package = read_app_package(path)
    app = package["app"]
    return install_app_manifest({
        "manifest": app,
        "replace": replace,
        "package": {
            "name": path.name,
            "sha256": file_sha256(path),
            "manifest_sha256": package["manifest_sha256"],
            "signature": package["signature"],
        },
    })


def upload_app_package(payload):
    name = safe_package_name(str(payload.get("name") or payload.get("filename") or ""))
    replace = payload.get("replace", False) in {True, "true", "on", "1", 1}
    content_base64 = str(payload.get("content_base64") or payload.get("data") or "")
    if not content_base64:
        raise ValueError("Package upload content_base64 is required")
    if "," in content_base64 and content_base64.split(",", 1)[0].startswith("data:"):
        content_base64 = content_base64.split(",", 1)[1]
    try:
        content = base64.b64decode(content_base64, validate=True)
    except (binascii.Error, ValueError) as exc:
        raise ValueError("Package upload content_base64 is invalid") from exc
    if not content:
        raise ValueError("Package upload is empty")
    if len(content) > APP_PACKAGE_UPLOAD_MAX_BYTES:
        raise ValueError(f"Package upload exceeds {APP_PACKAGE_UPLOAD_MAX_BYTES} bytes")
    APP_PACKAGE_DIR.mkdir(parents=True, exist_ok=True)
    target = APP_PACKAGE_DIR / name
    try:
        target.resolve().relative_to(APP_PACKAGE_DIR.resolve())
    except ValueError as exc:
        raise ValueError(f"App package '{name}' is outside {APP_PACKAGE_DIR}") from exc
    if target.exists() and not replace:
        raise ValueError(f"App package '{name}' already exists")
    tmp = target.with_suffix(target.suffix + ".uploading")
    tmp.write_bytes(content)
    try:
        package = read_app_package(tmp)
        tmp.replace(target)
    except Exception:
        tmp.unlink(missing_ok=True)
        raise
    return {
        "ok": True,
        "package": {
            "name": target.name,
            "bytes": len(content),
            "sha256": file_sha256(target),
            "manifest_sha256": package["manifest_sha256"],
            "signature": package["signature"],
            "app": package["app"],
        },
    }


def delete_app_package(name):
    path = package_path(name)
    path.unlink()
    return {"ok": True, "deleted": path.name}


def registry_app_manifest(app_id):
    if not re.match(r"^[a-z0-9][a-z0-9_.-]{1,63}$", app_id):
        raise ValueError(f"Invalid app id '{app_id}'")
    registry = app_registry()
    for app in registry["apps"]:
        if app["id"] == app_id:
            source = Path(app["source"])
            return json.loads(source.read_text())
    raise ValueError(f"Registry app '{app_id}' not found")


def install_registry_app(app_id, replace=False):
    return install_app_manifest({"manifest": registry_app_manifest(app_id), "replace": replace})


def update_installed_app(app_id):
    installed = app_by_id(app_id)
    if installed.get("source") == "builtin":
        raise ValueError(f"Built-in app '{app_id}' is managed by the base image")
    registry_app = registry_apps_by_id().get(app_id)
    if not registry_app:
        raise ValueError(f"No registry update source found for app '{app_id}'")
    update = app_update_metadata(installed, registry_app)
    if not update.get("update_available"):
        raise ValueError(f"App '{app_id}' is already up to date")
    result = install_app_manifest({"manifest": registry_app, "replace": True})
    result["update"] = update
    return result


def app_by_id(app_id):
    for app in raw_app_manifests()[0]:
        if app["id"] == app_id:
            return app
    raise ValueError(f"Unsupported app '{app_id}'")


def app_manifest_path(app_id):
    if not re.match(r"^[a-z0-9][a-z0-9_.-]{1,63}$", app_id):
        raise ValueError(f"Invalid app id '{app_id}'")
    return APP_MANIFEST_DIR / f"{app_id}.json"


def validate_app_manifest_payload(payload):
    manifest = payload.get("manifest") if isinstance(payload, dict) and isinstance(payload.get("manifest"), dict) else payload
    replace = bool(payload.get("replace", False)) if isinstance(payload, dict) else False
    app = normalize_app_manifest(manifest, "pending")
    existing_apps, _ = raw_app_manifests()
    existing = next((item for item in existing_apps if item["id"] == app["id"]), None)
    can_install = not existing or replace
    reason = "ready"
    if existing and existing.get("source") == "builtin":
        can_install = False
        reason = f"Cannot replace built-in app '{app['id']}'"
    elif existing and not replace:
        reason = f"App '{app['id']}' already exists; set replace=true to update it"
    return {
        "ok": True,
        "app": app,
        "existing": existing is not None,
        "existing_source": existing.get("source", "") if existing else "",
        "replace": replace,
        "can_install": can_install,
        "reason": reason,
    }


def install_app_manifest(payload):
    manifest = payload.get("manifest") if isinstance(payload, dict) and isinstance(payload.get("manifest"), dict) else payload
    validation = validate_app_manifest_payload(payload)
    app = validation["app"]
    if not validation["can_install"]:
        raise ValueError(validation["reason"])
    APP_MANIFEST_DIR.mkdir(parents=True, exist_ok=True)
    target = app_manifest_path(app["id"])
    persisted_keys = {"schema_version", "id", "name", "version", "runtime", "kind", "description", "services", "ports", "permissions", "devices", "volumes", "healthcheck", "container", "ui", "update"}
    persisted = {key: value for key, value in manifest.items() if key in persisted_keys}
    persisted["schema_version"] = APP_MANIFEST_SCHEMA_VERSION
    persisted["id"] = app["id"]
    persisted["runtime"] = app["runtime"]
    target.write_text(json.dumps(persisted, indent=2, sort_keys=True) + "\n")
    os.chmod(target, 0o644)
    installed = normalize_app_manifest(json.loads(target.read_text()), str(target))
    result = {"ok": True, "app": enrich_app(installed), "path": str(target), "catalog": app_catalog()}
    if isinstance(payload, dict) and isinstance(payload.get("package"), dict):
        result["package"] = payload["package"]
    return result


def uninstall_app_manifest(app_id):
    app = app_by_id(app_id)
    if app.get("source") == "builtin":
        raise ValueError(f"Cannot uninstall built-in app '{app_id}'")
    source = Path(app.get("source", ""))
    try:
        source.relative_to(APP_MANIFEST_DIR)
    except ValueError as exc:
        raise ValueError(f"App manifest is outside {APP_MANIFEST_DIR}") from exc
    if source.exists():
        source.unlink()
    return {"ok": True, "removed": app_id, "path": str(source), "catalog": app_catalog()}


def app_service_unit(service):
    if service in SERVICE_ALLOWLIST:
        return SERVICE_ALLOWLIST[service]
    if service.endswith(".service") and re.match(r"^[A-Za-z0-9_.@-]+\.service$", service):
        return service
    raise ValueError(f"Unsupported app service '{service}'")


def container_run_command(runtime, app):
    container = app.get("container", {})
    image = container.get("image", "")
    if not image:
        raise ValueError(f"Container app '{app['id']}' has no image")
    name = app_container_name(app["id"])
    command = [runtime, "run", "-d", "--name", name, "--restart", "unless-stopped"]
    network = container.get("network") or "bridge"
    if network in {"host", "none"}:
        command.extend(["--network", network])
    for port in app.get("ports", []):
        if isinstance(port, dict) and network != "host":
            protocol = port.get("protocol", "tcp")
            target = f"{port.get('host', port.get('container'))}:{port.get('container')}/{protocol}"
            command.extend(["-p", target])
    for device in app.get("devices", []):
        command.extend(["--device", device])
    for volume in app.get("volumes", []):
        command.extend(["-v", volume])
    for key, value in container.get("environment", {}).items():
        command.extend(["-e", f"{key}={value}"])
    for capability in container.get("capabilities", []):
        command.extend(["--cap-add", capability])
    if container.get("privileged"):
        command.append("--privileged")
    command.append(image)
    return command


def container_app_action(app, action):
    runtime = container_runtime_status()
    if not runtime["available"]:
        raise ValueError(runtime["error"])
    binary = runtime["runtime"]
    name = app_container_name(app["id"])
    results = []
    if action in {"stop", "restart"}:
        results.append(command_output([binary, "stop", name], timeout=30))
    if action == "restart":
        results.append(command_output([binary, "rm", name], timeout=30))
    if action == "start":
        results.append(command_output([binary, "rm", "-f", name], timeout=30))
    if action in {"start", "restart"}:
        results.append(command_output(container_run_command(binary, app), timeout=60))
    return {
        "ok": all(item["ok"] for item in results),
        "app": enrich_app(app),
        "action": action,
        "container": name,
        "runtime": runtime,
        "results": results,
    }


def app_action(app_id, action):
    if action not in {"start", "stop", "restart"}:
        raise ValueError(f"Unsupported app action '{action}'")
    app = app_by_id(app_id)
    if app.get("runtime") == "container":
        return container_app_action(app, action)
    results = []
    for service in app.get("services", []):
        unit = app_service_unit(service)
        result = command_output(["systemctl", action, unit], timeout=20)
        results.append({"service": service, "unit": unit, "ok": result["ok"], "stdout": result["stdout"], "stderr": result["stderr"]})
    return {"ok": all(item["ok"] for item in results), "app": enrich_app(app), "action": action, "results": results}


def app_logs(app_id, lines=120):
    app = app_by_id(app_id)
    lines = max(1, min(int(lines), 500))
    logs = []
    if app.get("runtime") == "container":
        runtime = container_runtime_status()
        if not runtime["available"]:
            raise ValueError(runtime["error"])
        name = app_container_name(app["id"])
        result = command_output([runtime["runtime"], "logs", "--tail", str(lines), name], timeout=15)
        logs.append({"container": name, "runtime": runtime["runtime"], "ok": result["ok"], "logs": result["stdout"], "error": result["stderr"]})
    for service in app.get("services", []):
        unit = app_service_unit(service)
        result = command_output(["journalctl", "-u", unit, "-n", str(lines), "--no-pager"], timeout=10)
        logs.append({"service": service, "unit": unit, "ok": result["ok"], "logs": result["stdout"], "error": result["stderr"]})
    return {"ok": all(item["ok"] for item in logs), "app_id": app_id, "logs": logs}


def glob_paths(patterns):
    found = []
    for pattern in patterns:
        found.extend(str(path) for path in sorted(Path("/").glob(pattern.lstrip("/"))))
    return found


def autopilot_status():
    serial_devices = glob_paths(["/dev/serial/by-id/*", "/dev/ttyACM*", "/dev/ttyUSB*", "/dev/ttyAMA*"])
    manager_payload = service_manager_status("autopilot-manager")
    router_payload = service_manager_status("mavlink-router")
    return {
        "supported": True,
        "connected": manager_payload.get("connected", bool(serial_devices)),
        "serial_devices": manager_payload.get("serial_devices", serial_devices),
        "mavlink_router": service_status("yari-mavlink-router"),
        "manager": service_status("yari-autopilot-manager"),
        "manager_state": manager_payload,
        "router_state": router_payload,
        "endpoints": router_payload.get("endpoints", read_mavlink_endpoints().get("endpoints", [])),
        "flight_stack": manager_payload.get("flight_stack", "unknown"),
        "heartbeat": manager_payload.get("heartbeat"),
        "version": manager_payload.get("version"),
        "mode": manager_payload.get("mode"),
        "battery": manager_payload.get("battery"),
        "gps": manager_payload.get("gps"),
        "armed": manager_payload.get("armed"),
        "firmware_upload": {"supported": False, "message": "Firmware upload UI placeholder; flashing must remain hardware-profile aware."},
    }


def read_mavlink_endpoints():
    try:
        return json.loads(MAVLINK_CONFIG_FILE.read_text())
    except (FileNotFoundError, json.JSONDecodeError):
        return {
            "endpoints": [
                {"name": "autopilot-serial", "type": "serial", "device": "/dev/ttyACM0", "baud": 57600, "enabled": False},
                {"name": "qgc-udp", "type": "udp", "host": "0.0.0.0", "port": 14550, "enabled": False},
            ]
        }


def write_mavlink_endpoints(payload):
    endpoints = payload.get("endpoints")
    if not isinstance(endpoints, list):
        raise ValueError("endpoints must be a list")
    normalized = []
    for endpoint in endpoints:
        if not isinstance(endpoint, dict) or endpoint.get("type") not in {"serial", "udp", "tcp"}:
            raise ValueError("each endpoint needs type serial, udp, or tcp")
        item = dict(endpoint)
        item["enabled"] = bool(item.get("enabled", False))
        if item["type"] == "serial":
            if not item.get("device"):
                raise ValueError("serial endpoints require device")
            item["baud"] = int(item.get("baud", 57600))
        if item["type"] in {"udp", "tcp"}:
            item["host"] = str(item.get("host") or "127.0.0.1")
            item["port"] = int(item.get("port", 14550))
            if item["port"] < 1 or item["port"] > 65535:
                raise ValueError("endpoint port must be between 1 and 65535")
        normalized.append(item)
    MAVLINK_CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
    MAVLINK_CONFIG_FILE.write_text(json.dumps({"endpoints": normalized}, indent=2) + "\n")
    os.chmod(MAVLINK_CONFIG_FILE, 0o600)
    return read_mavlink_endpoints()


def ros_command(args, timeout=8):
    shell_args = " ".join(args)
    return command_output(["bash", "-lc", f"source /opt/ros/humble/setup.bash 2>/dev/null || true; {shell_args}"], timeout=timeout)


