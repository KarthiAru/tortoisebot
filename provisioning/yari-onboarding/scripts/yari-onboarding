}


def run(args, check=False, capture=True):
    kwargs = {"text": True}
    if capture:
        kwargs.update({"stdout": subprocess.PIPE, "stderr": subprocess.PIPE})
    result = subprocess.run(args, **kwargs)
    if check and result.returncode != 0:
        raise RuntimeError(f"Command failed: {' '.join(args)}\n{result.stderr.strip() if result.stderr else ''}")
    return result


def has_command(name):
    return run(["/usr/bin/env", "sh", "-lc", f"command -v {name}"], capture=True).returncode == 0


def device_id():
    try:
        value = DEVICE_ID_FILE.read_text().strip()
        if value:
            return value
    except (FileNotFoundError, PermissionError, OSError):
        pass
    for candidate in (Path("/etc/machine-id"), Path("/var/lib/dbus/machine-id")):
        try:
            value = candidate.read_text().strip()
            if value:
                return value[:8]
        except FileNotFoundError:
            pass
    return secrets.token_hex(4)


def regenerate_device_id():
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    new_id = secrets.token_hex(4)
    DEVICE_ID_FILE.write_text(new_id + "\n")
    os.chmod(DEVICE_ID_FILE, 0o600)
    state = current_state({"mode": read_state().get("mode", "unknown"), "message": "device id regenerated"})
    write_state(state)
    return state


def ap_ssid():
    return os.environ.get("YARI_ONBOARDING_AP_SSID", f"{AP_SSID_PREFIX}-{device_id()}")


def current_state(extra=None):
    payload = {
        "device_id": device_id(),
        "ap_ssid": ap_ssid(),
        "ap_url": f"http://{AP_ADDR}",
        "wifi_iface": AP_IFACE,
        "networkmanager": has_command("nmcli"),
        "complete": COMPLETE_FILE.exists(),
        "hostname": socket.gethostname(),
    }
    if extra:
        payload.update(extra)
    return payload


def write_state(payload):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    STATE_FILE.write_text(json.dumps(payload, indent=2) + "\n")


def read_state():
    try:
        return json.loads(STATE_FILE.read_text())
    except (FileNotFoundError, json.JSONDecodeError):
        return current_state()


def read_text_file(path):
    try:
        return Path(path).read_text().strip()
    except (FileNotFoundError, PermissionError, OSError):
        return ""


def write_json_secret(path, payload):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(payload, indent=2) + "\n")
    os.chmod(path, 0o600)


def read_json_file(path, default=None):
    try:
        return json.loads(path.read_text())
    except (FileNotFoundError, PermissionError, OSError, json.JSONDecodeError):
        return {} if default is None else default


def redact_secret(value):
    if not value:
        return {"configured": False}
    return {"configured": True, "length": len(str(value)), "preview": str(value)[:4] + "..."}


def service_manager_status(role):
    payload = read_json_file(SERVICE_STATE_DIR / f"{role}.json", {})
    if not payload:
        return {"available": False, "message": f"yari-{role} service has not written status yet"}
    payload["available"] = True
    payload["age_seconds"] = max(0, int(time.time()) - int(payload.get("updated", 0)))
    return payload


def save_ssh_access(ssh_key="", ssh_password=""):
    result = {"authorized_key": False, "password": False}
    ssh_key = normalize_form_value(str(ssh_key or ""))
    ssh_password = normalize_form_value(str(ssh_password or ""))
    if ssh_key:
        home = Path("/home") / ONBOARDING_USER
        ssh_dir = home / ".ssh"
        ssh_dir.mkdir(parents=True, exist_ok=True)
        auth = ssh_dir / "authorized_keys"
        existing = auth.read_text().splitlines() if auth.exists() else []
        if ssh_key not in existing:
            existing.append(ssh_key)
            auth.write_text("\n".join(line for line in existing if line.strip()) + "\n")
        os.chmod(ssh_dir, 0o700)
        os.chmod(auth, 0o600)
        try:
            import pwd
            user = pwd.getpwnam(ONBOARDING_USER)
            os.chown(ssh_dir, user.pw_uid, user.pw_gid)
            os.chown(auth, user.pw_uid, user.pw_gid)
        except Exception:
            pass
        result["authorized_key"] = True
    if ssh_password:
        if APPLY_NETWORK:
            subprocess.run(["chpasswd"], input=f"{ONBOARDING_USER}:{ssh_password}\n", text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        result["password"] = True
    return result


def save_pairing_tokens(atlas_token="", foxglove_token=""):
    current = read_json_file(PORTAL_SECRETS_FILE, {})
    atlas_token = normalize_form_value(str(atlas_token or ""))
    foxglove_token = normalize_form_value(str(foxglove_token or ""))
    if atlas_token:
        current["atlas_token"] = atlas_token
    if foxglove_token:
        current["foxglove_token"] = foxglove_token
    if current:
        write_json_secret(PORTAL_SECRETS_FILE, current)
    return {"atlas_token": redact_secret(current.get("atlas_token")), "foxglove_token": redact_secret(current.get("foxglove_token"))}


def portal_config_status():
    secrets_payload = read_json_file(PORTAL_SECRETS_FILE, {})
    return {
        "user": ONBOARDING_USER,
        "ssh_authorized_keys": len((Path("/home") / ONBOARDING_USER / ".ssh" / "authorized_keys").read_text().splitlines()) if (Path("/home") / ONBOARDING_USER / ".ssh" / "authorized_keys").exists() else 0,
        "atlas_token": redact_secret(secrets_payload.get("atlas_token")),
        "foxglove_token": redact_secret(secrets_payload.get("foxglove_token")),
    }


def command_output(args, timeout=8):
    try:
        result = subprocess.run(args, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=timeout)
    except (FileNotFoundError, subprocess.TimeoutExpired) as exc:
        return {"ok": False, "stdout": "", "stderr": str(exc), "returncode": 1}
    return {"ok": result.returncode == 0, "stdout": result.stdout.strip(), "stderr": result.stderr.strip(), "returncode": result.returncode}


def has_connectivity():
    checks = [
        ["/usr/bin/env", "sh", "-lc", "ip -4 addr show scope global | grep -q inet"],
        ["/usr/bin/env", "sh", "-lc", "ip route | grep -q '^default'"],
    ]
    return all(run(command, capture=True).returncode == 0 for command in checks)


def wait_for_connectivity(timeout):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if has_connectivity():
            return True
        time.sleep(2)
    return has_connectivity()


def ensure_ap():
    if has_command("nmcli"):
        ensure_ap_networkmanager()
        return
    ensure_ap_wpa_supplicant()


def nm_connection_names():
    result = run(["nmcli", "-t", "-f", "NAME", "connection", "show"], capture=True)
    if result.returncode != 0:
        return []
    return result.stdout.splitlines()


def try_saved_networkmanager_wifi(timeout=25):
    if not has_command("nmcli") or "yari-wifi" not in nm_connection_names():
        return False
    run(["nmcli", "connection", "down", "yari-setup-ap"], capture=True)
    result = run(["nmcli", "connection", "up", "yari-wifi"], capture=True)
    if result.returncode != 0:
        write_state(current_state({
            "mode": "client-failed",
            "configured_ssid": read_configured_ssid(),
            "error": (result.stderr or result.stdout).strip(),
        }))
        return False
    if wait_for_connectivity(timeout):
        write_state(current_state({"mode": "client", "message": "connected using saved yari-wifi profile"}))
        return True
    write_state(current_state({
        "mode": "client-failed",
        "configured_ssid": read_configured_ssid(),
        "error": "saved yari-wifi profile activated but no network connectivity was detected",
    }))
    return False


def read_configured_ssid():
    if not has_command("nmcli"):
        return ""
    result = run(["nmcli", "-g", "802-11-wireless.ssid", "connection", "show", "yari-wifi"], capture=True)
    return result.stdout.strip() if result.returncode == 0 else ""


def ensure_ap_networkmanager():
    ssid = ap_ssid()
    existing = nm_connection_names()
    if "yari-setup-ap" in existing:
        run(["nmcli", "connection", "delete", "yari-setup-ap"], capture=True)
    run(["nmcli", "connection", "add", "type", "wifi", "ifname", AP_IFACE, "con-name", "yari-setup-ap", "autoconnect", "no", "ssid", ssid], check=True)
    run(["nmcli", "connection", "modify", "yari-setup-ap", "802-11-wireless.mode", "ap", "802-11-wireless.band", "bg", "ipv4.method", "shared", "ipv4.addresses", f"{AP_ADDR}/{AP_PREFIX}", "ipv6.method", "ignore"], check=True)
    if AP_PASSWORD:
        run(["nmcli", "connection", "modify", "yari-setup-ap", "wifi-sec.key-mgmt", "wpa-psk", "wifi-sec.psk", AP_PASSWORD], check=True)
    run(["nmcli", "connection", "up", "yari-setup-ap"], check=True)
    write_state(current_state({"mode": "setup-ap", "ap_backend": "networkmanager", "ap_security": "wpa-psk" if AP_PASSWORD else "open"}))


def ensure_ap_wpa_supplicant():
    missing = [name for name in ("wpa_supplicant", "ip", "systemctl") if not has_command(name)]
    if missing:
        message = f"Missing AP fallback tools: {', '.join(missing)}"
        write_state(current_state({"mode": "error", "error": message}))
        raise RuntimeError(message)

    runtime = Path("/run/yari-onboarding")
    runtime.mkdir(parents=True, exist_ok=True)
    wpa_conf = runtime / "wpa_supplicant-ap.conf"
    networkd_conf = Path(f"/run/systemd/network/80-yari-{AP_IFACE}-ap.network")
    networkd_conf.parent.mkdir(parents=True, exist_ok=True)

    ssid = ap_ssid().replace('"', '\\"')
    lines = ["ctrl_interface=/run/wpa_supplicant", "ap_scan=2", "network={", f"    ssid=\"{ssid}\"", "    mode=2", "    frequency=2412"]
    if AP_PASSWORD:
        password = AP_PASSWORD.replace('"', '\\"')
        lines.extend(["    key_mgmt=WPA-PSK", f"    psk=\"{password}\""])
        security = "wpa-psk"
    else:
        lines.append("    key_mgmt=NONE")
        security = "open"
    lines.append("}")
    wpa_conf.write_text("\n".join(lines) + "\n")
    os.chmod(wpa_conf, 0o600)

    networkd_conf.write_text("\n".join([
        "[Match]",
        f"Name={AP_IFACE}",
        "",
        "[Network]",
        f"Address={AP_ADDR}/{AP_PREFIX}",
        "DHCPServer=yes",
        "IPMasquerade=ipv4",
        "",
        "[DHCPServer]",
        "PoolOffset=20",
        "PoolSize=180",
        "EmitDNS=yes",
        f"DNS={AP_ADDR}",
        "",
    ]))

    run(["systemctl", "stop", f"wpa_supplicant@{AP_IFACE}.service"], capture=True)
    run(["/usr/bin/env", "sh", "-lc", f"pkill -f 'wpa_supplicant.*-i ?{AP_IFACE}' || true"], capture=True)
    run(["ip", "link", "set", AP_IFACE, "down"], capture=True)
    run(["ip", "addr", "flush", "dev", AP_IFACE], capture=True)
    run(["ip", "link", "set", AP_IFACE, "up"], check=True)
    run(["wpa_supplicant", "-B", "-i", AP_IFACE, "-c", str(wpa_conf), "-D", "nl80211"], check=True)
    run(["systemctl", "restart", "systemd-networkd"], capture=True)
    run(["ip", "addr", "replace", f"{AP_ADDR}/{AP_PREFIX}", "dev", AP_IFACE], capture=True)
    write_state(current_state({"mode": "setup-ap", "ap_backend": "wpa_supplicant-networkd", "ap_security": security}))


def normalize_form_value(value):
    value = value.strip()
    if len(value) >= 2 and value[0] == value[-1] and value[0] in {"'", '"'}:
        return value[1:-1]
    return value


def nm_keyfile_value(value):
    if "\n" in value or "\r" in value:
        raise ValueError("Wi-Fi values cannot contain newlines")
    return value.replace("\\", "\\\\").replace(";", "\\;")


def write_networkmanager_wifi(ssid, password):
    NM_CONNECTION_DIR.mkdir(parents=True, exist_ok=True)
    run(["nmcli", "connection", "delete", "yari-wifi"], capture=True)
    connection = NM_CONNECTION_DIR / "yari-wifi.nmconnection"
    content = "\n".join([
        "[connection]",
        "id=yari-wifi",
        f"uuid={uuid.uuid4()}",
        "type=wifi",
        f"interface-name={AP_IFACE}",
        "autoconnect=true",
        "autoconnect-priority=100",
        "",
        "[wifi]",
        "mode=infrastructure",
        f"ssid={nm_keyfile_value(ssid)}",
        "",
        "[wifi-security]",
        "key-mgmt=wpa-psk",
        f"psk={nm_keyfile_value(password)}",
        "",
        "[ipv4]",
        "method=auto",
        "",
        "[ipv6]",
        "method=ignore",
        "",
        "[proxy]",
        "",
    ])
    connection.write_text(content)
    os.chown(connection, 0, 0)
    os.chmod(connection, 0o600)
    run(["nmcli", "connection", "reload"], check=True)


def write_netplan(ssid, password):
    netplan = NETPLAN_DIR / "01-yari-wifi.yaml"
    netplan.parent.mkdir(parents=True, exist_ok=True)
    escaped_ssid = ssid.replace('"', '\\"')
    escaped_password = password.replace('"', '\\"')
    content = (
        "network:\n"
        "  version: 2\n"
        "  renderer: networkd\n"
        "  ethernets:\n"
        "    eth0:\n"
        "      dhcp4: true\n"
        "      optional: true\n"
        "  wifis:\n"
        f"    {AP_IFACE}:\n"
        "      dhcp4: true\n"
        "      optional: true\n"
        "      access-points:\n"
        f"        \"{escaped_ssid}\":\n"
        f"          password: \"{escaped_password}\"\n"
    )
    netplan.write_text(content)
    os.chmod(netplan, 0o600)
    cloud = CLOUD_CFG_DIR / "99-yari-disable-network-config.cfg"
    cloud.parent.mkdir(parents=True, exist_ok=True)
    cloud.write_text("network: {config: disabled}\n")


def configure_wifi(ssid, password, hostname=""):
    ssid = normalize_form_value(ssid)
    password = normalize_form_value(password)
    if not ssid or not password:
        raise ValueError("ssid and password are required")
    if hostname:
        safe_hostname = re.sub(r"[^a-z0-9-]+", "-", hostname.strip().lower()).strip("-")
        if safe_hostname:
            HOSTNAME_FILE.parent.mkdir(parents=True, exist_ok=True)
            HOSTNAME_FILE.write_text(safe_hostname + "\n")
            if APPLY_NETWORK:
                run(["hostnamectl", "set-hostname", safe_hostname], capture=True)
    if has_command("nmcli") and APPLY_NETWORK:
        write_networkmanager_wifi(ssid, password)
    else:
        write_netplan(ssid, password)
        if APPLY_NETWORK:
            run(["netplan", "generate"], check=True)
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    COMPLETE_FILE.touch()
    write_state(current_state({"mode": "configured", "configured_ssid": ssid}))


def save_setup_config(payload):
    ssid = str(payload.get("ssid") or "")
    password = str(payload.get("password") or "")
    hostname = str(payload.get("hostname") or "")
    configured_wifi = False
    if ssid or password:
        configure_wifi(ssid, password, hostname)
        configured_wifi = True
    elif hostname:
        safe_hostname = re.sub(r"[^a-z0-9-]+", "-", hostname.strip().lower()).strip("-")
        if safe_hostname:
            HOSTNAME_FILE.parent.mkdir(parents=True, exist_ok=True)
            HOSTNAME_FILE.write_text(safe_hostname + "\n")
            if APPLY_NETWORK:
                run(["hostnamectl", "set-hostname", safe_hostname], capture=True)
    ssh = save_ssh_access(payload.get("ssh_key", ""), payload.get("ssh_password", ""))
    tokens = save_pairing_tokens(payload.get("atlas_token", ""), payload.get("foxglove_token", ""))
    config = read_json_file(PORTAL_CONFIG_FILE, {})
    config.update({"hostname": hostname, "updated": int(time.time())})
    if payload.get("atlas_url"):
        config["atlas_url"] = normalize_form_value(str(payload.get("atlas_url")))
    if payload.get("atlas_upload_url"):
        config["atlas_upload_url"] = normalize_form_value(str(payload.get("atlas_upload_url")))
    PORTAL_CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
    PORTAL_CONFIG_FILE.write_text(json.dumps(config, indent=2) + "\n")
    os.chmod(PORTAL_CONFIG_FILE, 0o600)
    state = current_state({"mode": "configured" if configured_wifi else read_state().get("mode", "client"), "portal_config": portal_config_status()})
    write_state(state)
    return {"ok": True, "wifi_configured": configured_wifi, "ssh": ssh, "tokens": tokens, "state": state}


def reboot_soon():
    def delayed():
        time.sleep(2)
        run(["systemctl", "reboot"], capture=False)
    threading.Thread(target=delayed, daemon=True).start()



def split_escaped(value, separator=":"):
    parts = []
    current = []
    escaped = False
    for char in value:
        if escaped:
            current.append(char)
            escaped = False
        elif char == "\\":
            escaped = True
        elif char == separator:
            parts.append("".join(current))
            current = []
        else:
            current.append(char)
    if escaped:
        current.append("\\")
    parts.append("".join(current))
    return parts


def parse_kv_lines(output, separator=":"):
    rows = []
    for line in output.splitlines():
        if not line.strip():
            continue
        rows.append([part.strip() for part in split_escaped(line, separator)])
    return rows


def parse_lsblk_json():
    result = command_output(["lsblk", "-J", "-o", "NAME,TYPE,SIZE,MOUNTPOINT,MODEL,TRAN"], timeout=6)
    if not result["ok"]:
        return []
    try:
        return json.loads(result["stdout"]).get("blockdevices", [])
    except json.JSONDecodeError:
        return []


def device_status():
    meminfo = read_text_file("/proc/meminfo")
    memory = {}
    for line in meminfo.splitlines():
        key, _, value = line.partition(":")
        if key in {"MemTotal", "MemAvailable", "SwapTotal", "SwapFree"}:
            memory[key] = value.strip()
    temp = read_text_file("/sys/class/thermal/thermal_zone0/temp")
    temperature_c = None
    if temp.isdigit():
        temperature_c = round(int(temp) / 1000, 1)
    return {
        "device_id": device_id(),
        "hostname": socket.gethostname(),
        "os_release": read_text_file("/etc/os-release"),
        "kernel": command_output(["uname", "-r"])["stdout"],
        "architecture": command_output(["uname", "-m"])["stdout"],
        "uptime": read_text_file("/proc/uptime"),
        "load_average": read_text_file("/proc/loadavg"),
        "cpu_count": os.cpu_count(),
        "memory": memory,
        "temperature_c": temperature_c,
        "ip_addresses": command_output(["hostname", "-I"])["stdout"].split(),
        "storage": parse_lsblk_json(),
        "onboarding": read_state(),
    }


def nm_active_connections():
    result = command_output(["nmcli", "-t", "-f", "NAME,UUID,TYPE,DEVICE", "connection", "show", "--active"])
    if not result["ok"]:
        return []
    connections = []
    for row in parse_kv_lines(result["stdout"]):
        if len(row) >= 4:
            connections.append({"name": row[0], "uuid": row[1], "type": row[2], "device": row[3]})
    return connections


def network_status():
    interfaces = []
    ip_result = command_output(["ip", "-j", "addr", "show"], timeout=6)
    if ip_result["ok"]:
        try:
            interfaces = json.loads(ip_result["stdout"])
        except json.JSONDecodeError:
            interfaces = []
    nm_status = command_output(["nmcli", "-t", "-f", "DEVICE,TYPE,STATE,CONNECTION", "device", "status"])
    devices = []
    if nm_status["ok"]:
        for row in parse_kv_lines(nm_status["stdout"]):
            if len(row) >= 4:
                devices.append({"device": row[0], "type": row[1], "state": row[2], "connection": row[3]})
    return {
        "connected": has_connectivity(),
        "wifi_iface": AP_IFACE,
        "networkmanager": has_command("nmcli"),
        "active_connections": nm_active_connections(),
        "devices": devices,
        "interfaces": interfaces,
        "config": network_config_placeholders(),
        "onboarding": read_state(),
    }


def wifi_scan():
    if not has_command("nmcli"):
        return {"ok": False, "error": "NetworkManager/nmcli is not installed", "networks": []}
    run(["nmcli", "device", "wifi", "rescan", "ifname", AP_IFACE], capture=True)
    fields = "SSID,BSSID,CHAN,FREQ,RATE,SIGNAL,SECURITY"
    result = command_output(["nmcli", "-t", "-f", fields, "device", "wifi", "list", "ifname", AP_IFACE], timeout=12)
    networks = []
    if result["ok"]:
        for row in parse_kv_lines(result["stdout"]):
            if len(row) >= 7 and row[0]:
                networks.append({
                    "ssid": row[0],
                    "bssid": row[1],
                    "channel": row[2],
                    "frequency": row[3],
                    "rate": row[4],
                    "signal": row[5],
                    "security": row[6],
                })
    return {"ok": result["ok"], "error": result["stderr"], "networks": networks}


def service_name(name):
    service = SERVICE_ALLOWLIST.get(name)
    if not service:
        raise ValueError(f"Unsupported service '{name}'")
    return service


def service_status(name, unit=None):
    unit = unit or service_name(name)
    active = command_output(["systemctl", "is-active", unit], timeout=5)
    enabled = command_output(["systemctl", "is-enabled", unit], timeout=5)
    return {
        "name": name,
        "unit": unit,
        "active": active["stdout"] or "unknown",
        "enabled": enabled["stdout"] or "unknown",
        "available": active["returncode"] != 4,
    }


def services_status():
    return {"services": [service_status(name, unit) for name, unit in SERVICE_ALLOWLIST.items()]}


def service_action(name, action):
    unit = service_name(name)
    if action not in {"start", "stop", "restart", "enable", "disable"}:
        raise ValueError(f"Unsupported service action '{action}'")
    result = command_output(["systemctl", action, unit], timeout=20)
    return {"ok": result["ok"], "service": service_status(name, unit), "stdout": result["stdout"], "stderr": result["stderr"]}


def service_logs(name, lines=120):
    unit = service_name(name)
    lines = max(1, min(int(lines), 500))
    result = command_output(["journalctl", "-u", unit, "-n", str(lines), "--no-pager"], timeout=10)
    return {"ok": result["ok"], "name": name, "unit": unit, "logs": result["stdout"], "error": result["stderr"]}


def glob_paths(patterns):
    found = []
    for pattern in patterns:
        found.extend(str(path) for path in sorted(Path("/").glob(pattern.lstrip("/"))))
    return found


def autopilot_status():
    serial_devices = glob_paths(["/dev/serial/by-id/*", "/dev/ttyACM*", "/dev/ttyUSB*", "/dev/ttyAMA*"])
    manager_payload = service_manager_status("autopilot-manager")
    router_payload = service_manager_status("mavlink-router")
    return {
        "supported": True,
        "connected": manager_payload.get("connected", bool(serial_devices)),
        "serial_devices": manager_payload.get("serial_devices", serial_devices),
        "mavlink_router": service_status("yari-mavlink-router"),
        "manager": service_status("yari-autopilot-manager"),
        "manager_state": manager_payload,
        "router_state": router_payload,
        "endpoints": router_payload.get("endpoints", read_mavlink_endpoints().get("endpoints", [])),
        "flight_stack": manager_payload.get("flight_stack", "unknown"),
        "heartbeat": manager_payload.get("heartbeat"),
        "version": manager_payload.get("version"),
        "mode": manager_payload.get("mode"),
        "battery": manager_payload.get("battery"),
        "gps": manager_payload.get("gps"),
        "armed": manager_payload.get("armed"),
        "firmware_upload": {"supported": False, "message": "Firmware upload UI placeholder; flashing must remain hardware-profile aware."},
    }


def read_mavlink_endpoints():
    try:
        return json.loads(MAVLINK_CONFIG_FILE.read_text())
    except (FileNotFoundError, json.JSONDecodeError):
        return {
            "endpoints": [
                {"name": "autopilot-serial", "type": "serial", "device": "/dev/ttyACM0", "baud": 57600, "enabled": False},
                {"name": "qgc-udp", "type": "udp", "host": "0.0.0.0", "port": 14550, "enabled": False},
            ]
        }


def write_mavlink_endpoints(payload):
    endpoints = payload.get("endpoints")
    if not isinstance(endpoints, list):
        raise ValueError("endpoints must be a list")
    normalized = []
    for endpoint in endpoints:
        if not isinstance(endpoint, dict) or endpoint.get("type") not in {"serial", "udp", "tcp"}:
            raise ValueError("each endpoint needs type serial, udp, or tcp")
        item = dict(endpoint)
        item["enabled"] = bool(item.get("enabled", False))
        if item["type"] == "serial":
            if not item.get("device"):
                raise ValueError("serial endpoints require device")
            item["baud"] = int(item.get("baud", 57600))
        if item["type"] in {"udp", "tcp"}:
            item["host"] = str(item.get("host") or "127.0.0.1")
            item["port"] = int(item.get("port", 14550))
            if item["port"] < 1 or item["port"] > 65535:
                raise ValueError("endpoint port must be between 1 and 65535")
        normalized.append(item)
    MAVLINK_CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
    MAVLINK_CONFIG_FILE.write_text(json.dumps({"endpoints": normalized}, indent=2) + "\n")
    os.chmod(MAVLINK_CONFIG_FILE, 0o600)
    return read_mavlink_endpoints()


def ros_command(args, timeout=8):
    shell_args = " ".join(args)
    return command_output(["bash", "-lc", f"source /opt/ros/humble/setup.bash 2>/dev/null || true; {shell_args}"], timeout=timeout)


def ros_status():
    ros2 = command_output(["bash", "-lc", "command -v ros2"], timeout=5)
    nodes = ros_command(["ros2", "node", "list"], timeout=8) if ros2["ok"] else {"ok": False, "stdout": "", "stderr": "ros2 command not found"}
    manager_payload = service_manager_status("ros")
    return {
        "installed": manager_payload.get("installed", ros2["ok"]),
        "ros_distro": os.environ.get("ROS_DISTRO") or "humble",
        "nodes": manager_payload.get("nodes", [line for line in nodes["stdout"].splitlines() if line]),
        "topics": manager_payload.get("topics", []),
        "topics_endpoint": "/api/ros/topics",
        "launch_profiles": ["tortoisebot-hardware", "drone-companion", "rover-companion"],
        "recording": manager_payload.get("recording", ros_recording_status()),
        "error": nodes["stderr"],
        "service": service_status("yari-ros"),
        "manager_state": manager_payload,
    }


def ros_topics():
    result = ros_command(["ros2", "topic", "list", "-t"], timeout=10)
    topics = []
    if result["ok"]:
        for line in result["stdout"].splitlines():
            match = re.match(r"^(\S+)\s+\[(.+)\]$", line.strip())
            if match:
                topics.append({"name": match.group(1), "type": match.group(2)})
    return {"ok": result["ok"], "topics": topics, "error": result["stderr"]}


def process_running(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except (ProcessLookupError, ValueError, TypeError):
        return False
    except PermissionError:
        return True


def ros_recording_status():
    config = read_json_file(ROS_RECORDING_CONFIG_FILE, {"active": False})
    pid = None
    try:
        pid = int(ROS_RECORDING_PID_FILE.read_text().strip())
    except (FileNotFoundError, ValueError):
        pass
    active = bool(pid and process_running(pid))
    if config.get("active") and not active:
        config["active"] = False
        config["message"] = "recording process is not running"
    config.update({"active": active, "pid": pid, "log_file": str(ROS_RECORDING_LOG_FILE)})
    return config


def start_ros_recording(payload):
    status = ros_recording_status()
    if status.get("active"):
        return {"ok": True, "recording": status, "message": "MCAP recording is already running"}
    ros2 = command_output(["bash", "-lc", "source /opt/ros/humble/setup.bash 2>/dev/null || true; command -v ros2"], timeout=5)
    if not ros2["ok"]:
        return {"ok": False, "error": "ros2 command not found"}
    topics = payload.get("topics") or []
    if isinstance(topics, str):
        topics = [topic.strip() for topic in topics.split() if topic.strip()]
    if not isinstance(topics, list):
        raise ValueError("topics must be a list or whitespace-separated string")
    name = re.sub(r"[^a-zA-Z0-9_.-]+", "_", str(payload.get("name") or f"yari_ros_{time.strftime('%Y%m%d_%H%M%S')}"))
    output_dir = MCAP_DIR / name
    output_dir.parent.mkdir(parents=True, exist_ok=True)
    ROS_RECORDING_LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
    topic_args = "-a" if not topics else " ".join(sh_quote(str(topic)) for topic in topics)
    cmd = f"source /opt/ros/humble/setup.bash && exec ros2 bag record --storage mcap -o {sh_quote(str(output_dir))} {topic_args}"
    log_handle = ROS_RECORDING_LOG_FILE.open("ab")
    proc = subprocess.Popen(["bash", "-lc", cmd], stdout=log_handle, stderr=subprocess.STDOUT, start_new_session=True)
    ROS_RECORDING_PID_FILE.write_text(str(proc.pid) + "\n")
    config = {"active": True, "pid": proc.pid, "output_dir": str(output_dir), "topics": topics or ["*"], "started": int(time.time())}
    ROS_RECORDING_CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
    ROS_RECORDING_CONFIG_FILE.write_text(json.dumps(config, indent=2) + "\n")
    os.chmod(ROS_RECORDING_CONFIG_FILE, 0o600)
    return {"ok": True, "recording": ros_recording_status()}


def stop_ros_recording():
    status = ros_recording_status()
    pid = status.get("pid")
    if pid and status.get("active"):
        try:
            os.killpg(int(pid), signal.SIGINT)
        except ProcessLookupError:
            pass
        except Exception:
            os.kill(int(pid), signal.SIGINT)
        time.sleep(1)
    ROS_RECORDING_PID_FILE.unlink(missing_ok=True)
    status = ros_recording_status()
    status["active"] = False
    status["stopped"] = int(time.time())
    ROS_RECORDING_CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
    ROS_RECORDING_CONFIG_FILE.write_text(json.dumps(status, indent=2) + "\n")
    return {"ok": True, "recording": status}


def sh_quote(value):
    return "'" + str(value).replace("'", "'\''") + "'"


def save_video_settings(payload):
    fps = int(payload.get("fps", 15))
    if fps < 1 or fps > 60:
        raise ValueError("fps must be between 1 and 60")
    encoding = str(payload.get("encoding") or "mjpeg").lower()
    if encoding not in {"mjpeg", "h264", "h265", "bgr8", "mono8"}:
        raise ValueError("encoding must be one of mjpeg, h264, h265, bgr8, mono8")
    bandwidth = payload.get("bandwidth_kbps")
    bandwidth_kbps = None if bandwidth in {None, ""} else int(bandwidth)
    if bandwidth_kbps is not None and bandwidth_kbps < 64:
        raise ValueError("bandwidth_kbps must be at least 64")
    rtsp_url = str(payload.get("rtsp_url") or "rtsp://127.0.0.1:8554/yari-video")
    if not rtsp_url.startswith("rtsp://"):
        raise ValueError("rtsp_url must start with rtsp://")
    settings = {
        "fps": fps,
        "encoding": encoding,
        "bandwidth_kbps": bandwidth_kbps,
        "stream_enabled": bool(payload.get("stream_enabled") in {True, "true", "on", "1", 1}),
        "device": str(payload.get("device") or ""),
        "size": str(payload.get("size") or "640x480"),
        "rtsp_url": rtsp_url,
        "updated": int(time.time()),
    }
    VIDEO_CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
    VIDEO_CONFIG_FILE.write_text(json.dumps(settings, indent=2) + "\n")
    os.chmod(VIDEO_CONFIG_FILE, 0o600)
    return settings


def log_cleanup_candidates():
    candidates = []
    for item in data_status().get("mcap_logs", []):
        path = Path(item["path"])
        if path.exists():
            candidates.append({"path": str(path), "bytes": path.stat().st_size, "kind": "mcap"})
    for value in data_status().get("flight_logs", []):
        path = Path(value)
        if path.exists() and path.is_file():
            candidates.append({"path": str(path), "bytes": path.stat().st_size, "kind": "flight"})
    return candidates




def read_flight_log_downloads():
    payload = read_json_file(FLIGHT_LOG_DOWNLOADS_FILE, {"items": []})
    return {"items": [item for item in payload.get("items", []) if isinstance(item, dict)]} if isinstance(payload, dict) else {"items": []}


def write_flight_log_downloads(items):
    FLIGHT_LOG_DOWNLOADS_FILE.parent.mkdir(parents=True, exist_ok=True)
    FLIGHT_LOG_DOWNLOADS_FILE.write_text(json.dumps({"items": items, "updated": int(time.time())}, indent=2) + "\n")
    os.chmod(FLIGHT_LOG_DOWNLOADS_FILE, 0o600)


def queue_flight_log_download(payload):
    log_id = payload.get("log_id")
    if log_id in {None, ""}:
        raise ValueError("log_id is required")
    endpoint_name = str(payload.get("endpoint_name") or "")
    item_id = f"log-{int(log_id)}-{endpoint_name or 'default'}"
    items = read_flight_log_downloads()["items"]
    existing = next((item for item in items if item.get("id") == item_id), None)
    item = existing or {"id": item_id, "queued": int(time.time())}
    item.update({"log_id": int(log_id), "endpoint_name": endpoint_name, "status": "queued", "updated": int(time.time())})
    if existing is None:
        items.append(item)
    write_flight_log_downloads(items)
    return {"ok": True, "item": item, "downloads": read_flight_log_downloads()}


def retry_flight_log_downloads(payload):
    ids = set(payload.get("ids") or [])
    items = read_flight_log_downloads()["items"]
    for item in items:
        if not ids or item.get("id") in ids:
            if item.get("status") in {"failed", "missing"}:
                item["status"] = "queued"
                item["updated"] = int(time.time())
    write_flight_log_downloads(items)
    return {"ok": True, "downloads": read_flight_log_downloads()}

def read_upload_queue():
    payload = read_json_file(UPLOAD_QUEUE_FILE, {"items": []})
    items = payload.get("items", []) if isinstance(payload, dict) else []
    return {"items": [item for item in items if isinstance(item, dict)]}


def write_upload_queue(items):
    UPLOAD_QUEUE_FILE.parent.mkdir(parents=True, exist_ok=True)
    payload = {"items": items, "updated": int(time.time())}
    UPLOAD_QUEUE_FILE.write_text(json.dumps(payload, indent=2) + "\n")
    os.chmod(UPLOAD_QUEUE_FILE, 0o600)
    return payload


def upload_item_id(path):
    return uuid.uuid5(uuid.NAMESPACE_URL, str(Path(path).resolve())).hex[:16]


def enqueue_uploads(payload):
    candidates = {item["path"]: item for item in log_cleanup_candidates()}
    selected = payload.get("paths") or list(candidates)
    if isinstance(selected, str):
        selected = [selected]
    unknown = [path for path in selected if path not in candidates]
    if unknown:
        raise ValueError(f"refusing to enqueue unknown log path(s): {', '.join(unknown[:3])}")
    queue = read_upload_queue()["items"]
    by_id = {item.get("id"): item for item in queue}
    added = []
    now = int(time.time())
    for path in selected:
        candidate = candidates[path]
        item_id = upload_item_id(path)
        item = by_id.get(item_id, {})
        item.update({
            "id": item_id,
            "path": path,
            "kind": candidate.get("kind"),
            "bytes": candidate.get("bytes", 0),
            "status": "queued",
            "attempts": int(item.get("attempts", 0)),
            "queued": int(item.get("queued", now)),
            "updated": now,
        })
        by_id[item_id] = item
        added.append(item)
    write_upload_queue(list(by_id.values()))
    return {"ok": True, "added": added, "queue": read_upload_queue()}


def retry_uploads(payload):
    ids = set(payload.get("ids") or [])
    items = read_upload_queue()["items"]
    for item in items:
        if not ids or item.get("id") in ids:
            if item.get("status") in {"failed", "uploaded", "missing"}:
                item["status"] = "queued"
                item["updated"] = int(time.time())
    write_upload_queue(items)
    return {"ok": True, "queue": read_upload_queue()}


def clear_upload_queue(payload):
    keep_failed = bool(payload.get("keep_failed", True))
    items = read_upload_queue()["items"]
    if keep_failed:
        items = [item for item in items if item.get("status") == "failed"]
    else:
        items = []
    write_upload_queue(items)
    return {"ok": True, "queue": read_upload_queue()}

def cleanup_data_logs(payload):
    candidates = {item["path"]: item for item in log_cleanup_candidates()}
    selected = payload.get("paths") or list(candidates)
    if isinstance(selected, str):
        selected = [selected]
    unknown = [path for path in selected if path not in candidates]
    if unknown:
        raise ValueError(f"refusing to delete unknown log path(s): {', '.join(unknown[:3])}")
    preview = [candidates[path] for path in selected]
    if not payload.get("confirm"):
        return {"ok": True, "dry_run": True, "candidates": preview, "bytes": sum(item["bytes"] for item in preview)}
    deleted = []
    for item in preview:
        path = Path(item["path"])
        path.unlink(missing_ok=True)
        deleted.append(item)
    return {"ok": True, "dry_run": False, "deleted": deleted, "bytes": sum(item["bytes"] for item in deleted)}


def video_status():
    manager_payload = service_manager_status("video")
    return {
        "devices": manager_payload.get("devices", glob_paths(["/dev/video*", "/dev/media*"])),
        "service": service_status("yari-video"),
        "profiles": manager_payload.get("profiles", ["foxglove-compressed", "atlas-webrtc", "rtsp-low-latency"]),
        "settings": manager_payload.get("settings", read_json_file(VIDEO_CONFIG_FILE, {"fps": 15, "encoding": "mjpeg", "bandwidth_kbps": None})),
        "preview": {"supported": True, "message": "Preview is available through ROS/Foxglove/Atlas stream profiles when the video service is running."},
        "manager_state": manager_payload,
        "message": "Camera pipelines can publish ROS image topics, Foxglove streams, RTSP, or Atlas WebRTC feeds.",
    }


def data_status():
    bags = []
    if MCAP_DIR.exists():
        for path in sorted(MCAP_DIR.glob("**/*.mcap"), key=lambda p: p.stat().st_mtime, reverse=True)[:20]:
            stat = path.stat()
            bags.append({"path": str(path), "bytes": stat.st_size, "modified": int(stat.st_mtime)})
    flight_logs = glob_paths(["/var/log/*/*.ulg", "/var/log/*.ulg", "/home/*/**/*.ulg", "/home/*/**/*.BIN", "/home/*/**/*.bin"])[:50]
    manager_payload = service_manager_status("log-manager")
    return {
        "mcap_dir": str(MCAP_DIR),
        "mcap_logs": manager_payload.get("mcap_logs", bags),
        "flight_logs": manager_payload.get("flight_logs", flight_logs),
        "upload_queue": manager_payload.get("upload_queue", read_upload_queue().get("items", [])),
        "storage_cleanup": {"supported": True, "message": "Manual cleanup should be confirmed by the operator before deleting logs."},
        "remote_flight_logs": manager_payload.get("remote_flight_logs", {"ok": False, "state": "log-manager-status-unavailable", "logs": []}),
        "flight_log_downloads": manager_payload.get("flight_log_downloads", read_flight_log_downloads()),
        "service": service_status("yari-log-manager"),
        "manager_state": manager_payload,
    }


def dns_status():
    resolv = read_text_file("/etc/resolv.conf")
    servers = []
    for line in resolv.splitlines():
        parts = line.split()
        if len(parts) == 2 and parts[0] == "nameserver":
            servers.append(parts[1])
    return servers


def network_config_placeholders():
    return {
        "ap_mode": {"ssid": ap_ssid(), "address": AP_ADDR, "security": "wpa-psk" if AP_PASSWORD else "open"},
        "client_wifi": {"profile": "yari-wifi", "configured_ssid": read_configured_ssid()},
        "ethernet": {"managed_by": "NetworkManager", "dhcp": True},
        "static_ip": {"supported": False, "message": "Static IP UI/API is planned for the network adapter layer."},
        "dns": {"servers": dns_status()},
        "lte": {"supported": False, "message": "LTE modem support placeholder."},
    }


def log_sources():
    return {
        "onboarding": {"kind": "journal", "service": "yari-onboarding"},
        "system": {"kind": "journal"},
        "ros": {"kind": "paths", "paths": glob_paths(["/home/*/.ros/log/latest/*", "/home/*/.ros/log/*/*.log"])[:50]},
        "mavlink": {"kind": "journal", "service": "yari-mavlink-router"},
    }


def logs_status():
    return {"sources": log_sources(), "support_bundle_endpoint": "/api/logs/support-bundle"}


def read_log_source(source, lines=160):
    lines = max(1, min(int(lines), 1000))
    if source == "system":
        result = command_output(["journalctl", "-n", str(lines), "--no-pager"], timeout=12)
        return {"ok": result["ok"], "source": source, "logs": result["stdout"], "error": result["stderr"]}
    if source == "onboarding":
        return service_logs("yari-onboarding", lines)
    if source == "mavlink":
        return service_logs("yari-mavlink-router", lines)
    if source == "ros":
        paths = glob_paths(["/home/*/.ros/log/latest/*", "/home/*/.ros/log/*/*.log"])[:20]
        chunks = []
        for item in paths[:8]:
            result = command_output(["tail", "-n", str(max(20, lines // 4)), item], timeout=4)
            if result["stdout"]:
                chunks.append(f"==> {item} <==\n{result['stdout']}")
        return {"ok": True, "source": source, "logs": "\n\n".join(chunks), "paths": paths}
    raise ValueError(f"Unsupported log source '{source}'")


def support_bundle():
    SUPPORT_BUNDLE_DIR.mkdir(parents=True, exist_ok=True)
    bundle = SUPPORT_BUNDLE_DIR / f"yari-support-{device_id()}-{int(time.time())}.tar.gz"
    payloads = {
        "device-status.json": device_status(),
        "network-status.json": network_status(),
        "services.json": services_status(),
        "autopilot-status.json": autopilot_status(),
        "ros-status.json": ros_status(),
        "video-status.json": video_status(),
        "data-status.json": data_status(),
        "logs-status.json": logs_status(),
    }
    with tarfile.open(bundle, "w:gz") as tar:
        for name, payload in payloads.items():
            tmp = SUPPORT_BUNDLE_DIR / name
            tmp.write_text(json.dumps(payload, indent=2) + "\n")
            tar.add(tmp, arcname=name)
            tmp.unlink(missing_ok=True)
        for source in ("onboarding", "system", "ros", "mavlink"):
            tmp = SUPPORT_BUNDLE_DIR / f"{source}.log"
            tmp.write_text(read_log_source(source, 240).get("logs", "") + "\n")
            tar.add(tmp, arcname=f"logs/{source}.log")
            tmp.unlink(missing_ok=True)
    os.chmod(bundle, 0o600)
    return bundle


def shutdown_soon():
    def delayed():
        time.sleep(2)
        run(["systemctl", "poweroff"], capture=False)
    threading.Thread(target=delayed, daemon=True).start()


def factory_reset(reboot=False):
    COMPLETE_FILE.unlink(missing_ok=True)
    for path in (NM_CONNECTION_DIR / "yari-wifi.nmconnection", NETPLAN_DIR / "01-yari-wifi.yaml"):
        path.unlink(missing_ok=True)
    if has_command("nmcli"):
        run(["nmcli", "connection", "delete", "yari-wifi"], capture=True)
        run(["nmcli", "connection", "reload"], capture=True)
    state = current_state({"mode": "factory-reset", "complete": False})
    write_state(state)
    if reboot:
        reboot_soon()
    return state


class Handler(SimpleHTTPRequestHandler):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, directory=str(WEB_DIR), **kwargs)

    def log_message(self, fmt, *args):
        sys.stderr.write("yari-onboarding: " + fmt % args + "\n")

    def send_json(self, code, payload):
        body = json.dumps(payload, indent=2).encode("utf-8")
        self.send_response(code)
        self.send_header("content-type", "application/json")
        self.send_header("content-length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        parsed = urlparse(self.path)
        path = parsed.path
        query = parse_qs(parsed.query)
        try:
            if path in {"/api/status", "/api/device/status"}:
                self.send_json(200, device_status())
                return
            if path == "/api/network/status":
                self.send_json(200, network_status())
                return
            if path == "/api/network/wifi/scan":
                self.send_json(200, wifi_scan())
                return
            if path == "/api/setup/status":
                self.send_json(200, portal_config_status())
                return
            if path == "/api/services":
                self.send_json(200, services_status())
                return
            if path == "/api/logs":
                self.send_json(200, logs_status())
                return
            if path == "/api/logs/support-bundle":
                bundle = support_bundle()
                body = bundle.read_bytes()
                self.send_response(200)
                self.send_header("content-type", "application/gzip")
                self.send_header("content-disposition", f"attachment; filename={bundle.name}")
                self.send_header("content-length", str(len(body)))
                self.end_headers()
                self.wfile.write(body)
                return
            logs_match = re.match(r"^/api/logs/([^/]+)$", path)
            if logs_match:
                lines = query.get("lines", ["160"])[0]
                self.send_json(200, read_log_source(logs_match.group(1), lines))
                return
            service_logs_match = re.match(r"^/api/services/([^/]+)/logs$", path)
            if service_logs_match:
                lines = query.get("lines", ["120"])[0]
                self.send_json(200, service_logs(service_logs_match.group(1), lines))
                return
            if path == "/api/autopilot/status":
                self.send_json(200, autopilot_status())
                return
            if path == "/api/mavlink/endpoints":
                self.send_json(200, read_mavlink_endpoints())
                return
            if path == "/api/ros/status":
                self.send_json(200, ros_status())
                return
            if path == "/api/ros/topics":
                self.send_json(200, ros_topics())
                return
            if path == "/api/video/status":
                self.send_json(200, video_status())
                return
            if path == "/api/data/status":
                self.send_json(200, data_status())
                return
        except Exception as exc:
            self.send_json(500, {"ok": False, "error": str(exc)})
            return
        super().do_GET()

    def do_POST(self):
        path = urlparse(self.path).path
        length = int(self.headers.get("content-length", "0") or 0)
        try:
            payload = json.loads(self.rfile.read(length).decode("utf-8") or "{}")
        except json.JSONDecodeError as exc:
            self.send_json(400, {"ok": False, "error": f"invalid json: {exc}"})
            return
        try:
            if path in {"/api/configure", "/api/network/wifi/save"}:
                configure_wifi(str(payload.get("ssid") or ""), str(payload.get("password") or ""), str(payload.get("hostname") or ""))
                self.send_json(200, {"ok": True, "message": "Wi-Fi saved. Device will reboot." if REBOOT_AFTER_SAVE else "Wi-Fi saved."})
                if REBOOT_AFTER_SAVE:
                    reboot_soon()
                return
            if path == "/api/setup/config":
                result = save_setup_config(payload)
                result["message"] = "Setup saved. Device will reboot." if result.get("wifi_configured") and REBOOT_AFTER_SAVE else "Setup saved."
                self.send_json(200, result)
                if result.get("wifi_configured") and REBOOT_AFTER_SAVE:
                    reboot_soon()
                return
            if path == "/api/reboot":
                self.send_json(200, {"ok": True, "message": "Rebooting."})
                reboot_soon()
                return
            if path == "/api/shutdown":
                self.send_json(200, {"ok": True, "message": "Shutting down."})
                shutdown_soon()
                return
            if path == "/api/device/regenerate-id":
                self.send_json(200, {"ok": True, "state": regenerate_device_id()})
                return
            if path == "/api/network/ap/enable":
                ensure_ap()
                self.send_json(200, {"ok": True, "state": read_state()})
                return
            if path == "/api/network/factory-reset":
                self.send_json(200, {"ok": True, "state": factory_reset(bool(payload.get("reboot", False)))})
                return
            service_match = re.match(r"^/api/services/([^/]+)/(start|stop|restart|enable|disable)$", path)
            if service_match:
                self.send_json(200, service_action(service_match.group(1), service_match.group(2)))
                return
            if path == "/api/mavlink/endpoints":
                self.send_json(200, {"ok": True, "config": write_mavlink_endpoints(payload)})
                return
            if path == "/api/ros/recording/start":
                self.send_json(200, start_ros_recording(payload))
                return
            if path == "/api/ros/recording/stop":
                self.send_json(200, stop_ros_recording())
                return
            if path == "/api/video/settings":
                self.send_json(200, {"ok": True, "settings": save_video_settings(payload)})
                return
            if path == "/api/data/flight-logs/download":
                self.send_json(200, queue_flight_log_download(payload))
                return
            if path == "/api/data/flight-logs/retry":
                self.send_json(200, retry_flight_log_downloads(payload))
                return
            if path == "/api/data/uploads/enqueue":
                self.send_json(200, enqueue_uploads(payload))
                return
            if path == "/api/data/uploads/retry":
                self.send_json(200, retry_uploads(payload))
                return
            if path == "/api/data/uploads/clear":
                self.send_json(200, clear_upload_queue(payload))
                return
            if path == "/api/data/cleanup":
                self.send_json(200, cleanup_data_logs(payload))
                return
            if path == "/api/ros/launch-profile":
                self.send_json(202, {"ok": False, "supported": False, "message": "ROS launch profile switching requires a configured launch profile runner."})
                return
        except Exception as exc:
            self.send_json(500, {"ok": False, "error": str(exc)})
            return
        self.send_json(404, {"ok": False, "error": "not found"})


def serve_http(label="YARI onboarding"):
    server = ThreadingHTTPServer(("0.0.0.0", HTTP_PORT), Handler)
    print(f"{label} serving http://0.0.0.0:{HTTP_PORT}", flush=True)
    server.serve_forever()


def serve():
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    if wait_for_connectivity(CONNECTIVITY_TIMEOUT):
        write_state(current_state({"mode": "client", "message": "network already connected"}))
        serve_http("YARI device portal")
        return
    ensure_ap()
    serve_http(f"YARI onboarding setup AP {ap_ssid()}")


def main():
    parser = argparse.ArgumentParser(description="YARI first-boot network onboarding")
    parser.add_argument("command", choices=["serve", "status", "ap", "web"], nargs="?", default="serve")
    args = parser.parse_args()
    if args.command == "status":
        print(json.dumps(current_state(), indent=2))
    elif args.command == "ap":
        ensure_ap()
    elif args.command == "web":
        serve_http()
    else:
        serve()


if __name__ == "__main__":
    main()
