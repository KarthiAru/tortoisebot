def read_ros_launch_profiles():
    payload = read_json_file(ROS_LAUNCH_CONFIG_FILE, default_ros_launch_profiles())
    profiles = payload.get("profiles", []) if isinstance(payload, dict) else []
    normalized = []
    for profile in profiles:
        if not isinstance(profile, dict):
            continue
        name = re.sub(r"[^a-zA-Z0-9_.-]+", "-", str(profile.get("name") or "")).strip("-")
        if not name:
            continue
        item = dict(profile)
        item["name"] = name
        item["enabled"] = bool(item.get("enabled", True))
        item["command_configured"] = bool(str(item.get("command") or "").strip())
        normalized.append(item)
    return {"profiles": normalized, "config_file": str(ROS_LAUNCH_CONFIG_FILE)}


def find_ros_launch_profile(name):
    for profile in read_ros_launch_profiles()["profiles"]:
        if profile.get("name") == name:
            return profile
    raise ValueError(f"unknown ROS launch profile: {name}")


def ros_launch_status():
    state = read_json_file(ROS_LAUNCH_STATE_FILE, {"active": False})
    pid = None
    try:
        pid = int(ROS_LAUNCH_PID_FILE.read_text().strip())
    except (FileNotFoundError, ValueError):
        pass
    active = bool(pid and process_running(pid))
    if state.get("active") and not active:
        state["active"] = False
        state["message"] = "launch process is not running"
    state.update({"active": active, "pid": pid, "log_file": str(ROS_LAUNCH_LOG_FILE)})
    return state


def start_ros_launch_profile(payload):
    status = ros_launch_status()
    if status.get("active"):
        return {"ok": True, "launch": status, "message": "ROS launch profile is already running"}
    profile_name = str(payload.get("profile") or "")
    profile = find_ros_launch_profile(profile_name)
    if not profile.get("enabled", True):
        return {"ok": False, "profile": profile, "error": "profile is disabled"}
    command = str(profile.get("command") or "").strip()
    if not command:
        return {"ok": False, "profile": profile, "error": "profile command is not configured"}
    cwd = Path(str(profile.get("cwd") or "/home/tortoisebot"))
    if not cwd.is_absolute():
        raise ValueError("profile cwd must be an absolute path")
    setup = str(profile.get("setup") or "/opt/ros/humble/setup.bash")
    ROS_LAUNCH_LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
    shell_cmd = f"source {sh_quote(setup)} 2>/dev/null || true; cd {sh_quote(str(cwd))} && exec {command}"
    log_handle = ROS_LAUNCH_LOG_FILE.open("ab")
    proc = subprocess.Popen(["bash", "-lc", shell_cmd], stdout=log_handle, stderr=subprocess.STDOUT, start_new_session=True)
    ROS_LAUNCH_PID_FILE.write_text(str(proc.pid) + "\n")
    state = {"active": True, "pid": proc.pid, "profile": profile_name, "command": command, "cwd": str(cwd), "started": int(time.time())}
    ROS_LAUNCH_STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
    ROS_LAUNCH_STATE_FILE.write_text(json.dumps(state, indent=2) + "\n")
    os.chmod(ROS_LAUNCH_STATE_FILE, 0o600)
    return {"ok": True, "launch": ros_launch_status(), "profile": profile}


def stop_ros_launch_profile():
    status = ros_launch_status()
    pid = status.get("pid")
    if pid and status.get("active"):
        try:
            os.killpg(int(pid), signal.SIGINT)
        except ProcessLookupError:
            pass
        except Exception:
            os.kill(int(pid), signal.SIGINT)
        time.sleep(1)
    ROS_LAUNCH_PID_FILE.unlink(missing_ok=True)
    status = ros_launch_status()
    status["active"] = False
    status["stopped"] = int(time.time())
    ROS_LAUNCH_STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
    ROS_LAUNCH_STATE_FILE.write_text(json.dumps(status, indent=2) + "\n")
    os.chmod(ROS_LAUNCH_STATE_FILE, 0o600)
    return {"ok": True, "launch": status}


def ros_status():
    ros2 = command_output(["bash", "-lc", "command -v ros2"], timeout=5)
    nodes = ros_command(["ros2", "node", "list"], timeout=8) if ros2["ok"] else {"ok": False, "stdout": "", "stderr": "ros2 command not found"}
    manager_payload = service_manager_status("ros")
    launch = ros_launch_status()
    profiles = read_ros_launch_profiles()
    return {
        "installed": manager_payload.get("installed", ros2["ok"]),
        "ros_distro": os.environ.get("ROS_DISTRO") or "humble",
        "nodes": manager_payload.get("nodes", [line for line in nodes["stdout"].splitlines() if line]),
        "topics": manager_payload.get("topics", []),
        "topics_endpoint": "/api/ros/topics",
        "launch_profiles": profiles["profiles"],
        "launch": manager_payload.get("launch", launch),
        "recording": manager_payload.get("recording", ros_recording_status()),
        "error": nodes["stderr"],
        "service": service_status("yari-ros"),
        "manager_state": manager_payload,
    }


def ros_topics():
    result = ros_command(["ros2", "topic", "list", "-t"], timeout=10)
    topics = []
    if result["ok"]:
        for line in result["stdout"].splitlines():
            match = re.match(r"^(\S+)\s+\[(.+)\]$", line.strip())
            if match:
                topics.append({"name": match.group(1), "type": match.group(2)})
    return {"ok": result["ok"], "topics": topics, "error": result["stderr"]}


def process_running(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except (ProcessLookupError, ValueError, TypeError):
        return False
    except PermissionError:
        return True


def ros_recording_status():
    config = read_json_file(ROS_RECORDING_CONFIG_FILE, {"active": False})
    pid = None
    try:
        pid = int(ROS_RECORDING_PID_FILE.read_text().strip())
    except (FileNotFoundError, ValueError):
        pass
    active = bool(pid and process_running(pid))
    if config.get("active") and not active:
        config["active"] = False
        config["message"] = "recording process is not running"
    config.update({"active": active, "pid": pid, "log_file": str(ROS_RECORDING_LOG_FILE)})
    return config


def start_ros_recording(payload):
    status = ros_recording_status()
    if status.get("active"):
        return {"ok": True, "recording": status, "message": "MCAP recording is already running"}
    ros2 = command_output(["bash", "-lc", "source /opt/ros/humble/setup.bash 2>/dev/null || true; command -v ros2"], timeout=5)
    if not ros2["ok"]:
        return {"ok": False, "error": "ros2 command not found"}
    topics = payload.get("topics") or []
    if isinstance(topics, str):
        topics = [topic.strip() for topic in topics.split() if topic.strip()]
    if not isinstance(topics, list):
        raise ValueError("topics must be a list or whitespace-separated string")
    name = re.sub(r"[^a-zA-Z0-9_.-]+", "_", str(payload.get("name") or f"yari_ros_{time.strftime('%Y%m%d_%H%M%S')}"))
    output_dir = MCAP_DIR / name
    output_dir.parent.mkdir(parents=True, exist_ok=True)
    ROS_RECORDING_LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
    topic_args = "-a" if not topics else " ".join(sh_quote(str(topic)) for topic in topics)
    cmd = f"source /opt/ros/humble/setup.bash && exec ros2 bag record --storage mcap -o {sh_quote(str(output_dir))} {topic_args}"
    log_handle = ROS_RECORDING_LOG_FILE.open("ab")
    proc = subprocess.Popen(["bash", "-lc", cmd], stdout=log_handle, stderr=subprocess.STDOUT, start_new_session=True)
    ROS_RECORDING_PID_FILE.write_text(str(proc.pid) + "\n")
    config = {"active": True, "pid": proc.pid, "output_dir": str(output_dir), "topics": topics or ["*"], "started": int(time.time())}
    ROS_RECORDING_CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
    ROS_RECORDING_CONFIG_FILE.write_text(json.dumps(config, indent=2) + "\n")
    os.chmod(ROS_RECORDING_CONFIG_FILE, 0o600)
    return {"ok": True, "recording": ros_recording_status()}


def stop_ros_recording():
    status = ros_recording_status()
    pid = status.get("pid")
    if pid and status.get("active"):
        try:
            os.killpg(int(pid), signal.SIGINT)
        except ProcessLookupError:
            pass
        except Exception:
            os.kill(int(pid), signal.SIGINT)
        time.sleep(1)
    ROS_RECORDING_PID_FILE.unlink(missing_ok=True)
    status = ros_recording_status()
    status["active"] = False
    status["stopped"] = int(time.time())
    ROS_RECORDING_CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
    ROS_RECORDING_CONFIG_FILE.write_text(json.dumps(status, indent=2) + "\n")
    return {"ok": True, "recording": status}


def sh_quote(value):
    return "'" + str(value).replace("'", "'\''") + "'"


def normalize_ros_topic(value, default):
    topic = str(value or default).strip()
    if not topic.startswith("/"):
        raise ValueError(f"ROS topic must start with /: {topic}")
    if any(char.isspace() for char in topic):
        raise ValueError(f"ROS topic cannot contain whitespace: {topic}")
    return topic


def ros_topic_available(topic, expected_type=""):
    if not topic:
        return {"available": False, "topic": topic, "message": "topic is not configured"}
    result = ros_command(["ros2", "topic", "list", "-t"], timeout=6)
    if not result.get("ok"):
        return {"available": False, "topic": topic, "error": result.get("stderr") or "ros2 topic list failed"}
    for line in result.get("stdout", "").splitlines():
        match = re.match(r"^(\S+)\s+\[(.+)\]$", line.strip())
        if match and match.group(1) == topic:
            topic_type = match.group(2)
            return {
                "available": not expected_type or topic_type == expected_type,
                "topic": topic,
                "type": topic_type,
                "expected_type": expected_type,
            }
    return {"available": False, "topic": topic, "expected_type": expected_type, "message": "topic not currently published"}


def read_video_settings():
    return read_json_file(VIDEO_CONFIG_FILE, {
        "fps": 15,
        "encoding": "mjpeg",
        "bandwidth_kbps": None,
        "device": "",
        "size": "640x480",
        "stream_enabled": False,
        "rtsp_url": "rtsp://127.0.0.1:8554/yari-video",
        "foxglove_topic": "/camera/image_raw/compressed",
        "atlas_webrtc_enabled": False,
        "atlas_camera_topic": "/camera/image_raw/compressed",
        "atlas_max_video_fps": 15,
    })


def save_video_settings(payload):
    fps = int(payload.get("fps", 15))
    if fps < 1 or fps > 60:
        raise ValueError("fps must be between 1 and 60")
    encoding = str(payload.get("encoding") or "mjpeg").lower()
    if encoding not in {"mjpeg", "h264", "h265", "bgr8", "mono8"}:
        raise ValueError("encoding must be one of mjpeg, h264, h265, bgr8, mono8")
    bandwidth = payload.get("bandwidth_kbps")
    bandwidth_kbps = None if bandwidth in {None, ""} else int(bandwidth)
    if bandwidth_kbps is not None and bandwidth_kbps < 64:
        raise ValueError("bandwidth_kbps must be at least 64")
    rtsp_url = str(payload.get("rtsp_url") or "rtsp://127.0.0.1:8554/yari-video")
    if not rtsp_url.startswith("rtsp://"):
        raise ValueError("rtsp_url must start with rtsp://")
    atlas_max_video_fps = int(payload.get("atlas_max_video_fps") or fps)
    if atlas_max_video_fps < 1 or atlas_max_video_fps > 60:
        raise ValueError("atlas_max_video_fps must be between 1 and 60")
    settings = {
        "fps": fps,
        "encoding": encoding,
        "bandwidth_kbps": bandwidth_kbps,
        "stream_enabled": bool(payload.get("stream_enabled") in {True, "true", "on", "1", 1}),
        "device": str(payload.get("device") or ""),
        "size": str(payload.get("size") or "640x480"),
        "rtsp_url": rtsp_url,
        "foxglove_topic": normalize_ros_topic(payload.get("foxglove_topic"), "/camera/image_raw/compressed"),
        "atlas_webrtc_enabled": bool(payload.get("atlas_webrtc_enabled") in {True, "true", "on", "1", 1}),
        "atlas_camera_topic": normalize_ros_topic(payload.get("atlas_camera_topic"), "/camera/image_raw/compressed"),
        "atlas_max_video_fps": atlas_max_video_fps,
        "updated": int(time.time()),
    }
    VIDEO_CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
    VIDEO_CONFIG_FILE.write_text(json.dumps(settings, indent=2) + "\n")
    os.chmod(VIDEO_CONFIG_FILE, 0o600)
    return settings


def log_cleanup_candidates():
    candidates = []
    for item in data_status().get("mcap_logs", []):
        path = Path(item["path"])
        if path.exists():
            candidates.append({"path": str(path), "bytes": path.stat().st_size, "kind": "mcap"})
    for value in data_status().get("flight_logs", []):
        path = Path(value)
        if path.exists() and path.is_file():
            candidates.append({"path": str(path), "bytes": path.stat().st_size, "kind": "flight"})
    return candidates




def read_flight_log_downloads():
    payload = read_json_file(FLIGHT_LOG_DOWNLOADS_FILE, {"items": []})
    return {"items": [item for item in payload.get("items", []) if isinstance(item, dict)]} if isinstance(payload, dict) else {"items": []}


def write_flight_log_downloads(items):
    FLIGHT_LOG_DOWNLOADS_FILE.parent.mkdir(parents=True, exist_ok=True)
    FLIGHT_LOG_DOWNLOADS_FILE.write_text(json.dumps({"items": items, "updated": int(time.time())}, indent=2) + "\n")
    os.chmod(FLIGHT_LOG_DOWNLOADS_FILE, 0o600)


def queue_flight_log_download(payload):
    log_id = payload.get("log_id")
    if log_id in {None, ""}:
        raise ValueError("log_id is required")
    endpoint_name = str(payload.get("endpoint_name") or "")
    item_id = f"log-{int(log_id)}-{endpoint_name or 'default'}"
    items = read_flight_log_downloads()["items"]
    existing = next((item for item in items if item.get("id") == item_id), None)
    item = existing or {"id": item_id, "queued": int(time.time())}
    item.update({"log_id": int(log_id), "endpoint_name": endpoint_name, "status": "queued", "updated": int(time.time())})
    if existing is None:
        items.append(item)
    write_flight_log_downloads(items)
    return {"ok": True, "item": item, "downloads": read_flight_log_downloads()}


def retry_flight_log_downloads(payload):
    ids = set(payload.get("ids") or [])
    items = read_flight_log_downloads()["items"]
    for item in items:
        if not ids or item.get("id") in ids:
            if item.get("status") in {"failed", "missing"}:
                item["status"] = "queued"
                item["updated"] = int(time.time())
    write_flight_log_downloads(items)
    return {"ok": True, "downloads": read_flight_log_downloads()}

def read_upload_queue():
    payload = read_json_file(UPLOAD_QUEUE_FILE, {"items": []})
    items = payload.get("items", []) if isinstance(payload, dict) else []
    return {"items": [item for item in items if isinstance(item, dict)]}


def write_upload_queue(items):
    UPLOAD_QUEUE_FILE.parent.mkdir(parents=True, exist_ok=True)
    payload = {"items": items, "updated": int(time.time())}
    UPLOAD_QUEUE_FILE.write_text(json.dumps(payload, indent=2) + "\n")
    os.chmod(UPLOAD_QUEUE_FILE, 0o600)
    return payload


def upload_item_id(path):
    return uuid.uuid5(uuid.NAMESPACE_URL, str(Path(path).resolve())).hex[:16]


def enqueue_uploads(payload):
    candidates = {item["path"]: item for item in log_cleanup_candidates()}
    selected = payload.get("paths") or list(candidates)
    if isinstance(selected, str):
        selected = [selected]
    unknown = [path for path in selected if path not in candidates]
    if unknown:
        raise ValueError(f"refusing to enqueue unknown log path(s): {', '.join(unknown[:3])}")
    queue = read_upload_queue()["items"]
    by_id = {item.get("id"): item for item in queue}
    added = []
    now = int(time.time())
    for path in selected:
        candidate = candidates[path]
        item_id = upload_item_id(path)
        item = by_id.get(item_id, {})
        item.update({
            "id": item_id,
            "path": path,
            "kind": candidate.get("kind"),
            "bytes": candidate.get("bytes", 0),
            "status": "queued",
            "attempts": int(item.get("attempts", 0)),
            "queued": int(item.get("queued", now)),
            "updated": now,
        })
        by_id[item_id] = item
        added.append(item)
    write_upload_queue(list(by_id.values()))
    return {"ok": True, "added": added, "queue": read_upload_queue()}


def retry_uploads(payload):
    ids = set(payload.get("ids") or [])
    items = read_upload_queue()["items"]
    for item in items:
        if not ids or item.get("id") in ids:
            if item.get("status") in {"failed", "uploaded", "missing"}:
                item["status"] = "queued"
                item["updated"] = int(time.time())
    write_upload_queue(items)
    return {"ok": True, "queue": read_upload_queue()}


def clear_upload_queue(payload):
    keep_failed = bool(payload.get("keep_failed", True))
    items = read_upload_queue()["items"]
    if keep_failed:
        items = [item for item in items if item.get("status") == "failed"]
    else:
        items = []
    write_upload_queue(items)
    return {"ok": True, "queue": read_upload_queue()}

def cleanup_data_logs(payload):
    candidates = {item["path"]: item for item in log_cleanup_candidates()}
    selected = payload.get("paths") or list(candidates)
    if isinstance(selected, str):
        selected = [selected]
    unknown = [path for path in selected if path not in candidates]
    if unknown:
        raise ValueError(f"refusing to delete unknown log path(s): {', '.join(unknown[:3])}")
    preview = [candidates[path] for path in selected]
    if not payload.get("confirm"):
        return {"ok": True, "dry_run": True, "candidates": preview, "bytes": sum(item["bytes"] for item in preview)}
    deleted = []
    for item in preview:
        path = Path(item["path"])
        path.unlink(missing_ok=True)
        deleted.append(item)
    return {"ok": True, "dry_run": False, "deleted": deleted, "bytes": sum(item["bytes"] for item in deleted)}


def video_preview_status(settings, devices):
    device = settings.get("device") or next((item for item in devices if "/dev/video" in item), "")
    ffmpeg_available = has_command("ffmpeg")
    return {
        "supported": bool(device and ffmpeg_available),
        "endpoint": "/api/video/snapshot",
        "device": device,
        "requires": "ffmpeg and a /dev/video* camera",
        "message": "Local JPEG snapshot preview is available" if device and ffmpeg_available else "Install ffmpeg and connect a camera for local preview",
    }


def capture_video_snapshot():
    settings = read_video_settings()
    devices = glob_paths(["/dev/video*"])
    device = settings.get("device") or (devices[0] if devices else "")
    if not device:
        raise ValueError("no /dev/video* camera is available")
    if not has_command("ffmpeg"):
        raise ValueError("ffmpeg is required for video snapshot preview")
    size = str(settings.get("size") or "640x480")
    result = subprocess.run([
        "ffmpeg", "-hide_banner", "-loglevel", "error", "-f", "v4l2", "-video_size", size,
        "-i", str(device), "-frames:v", "1", "-f", "mjpeg", "pipe:1"
    ], stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=8)
    if result.returncode != 0 or not result.stdout:
        raise RuntimeError(result.stderr.decode("utf-8", errors="replace") or "failed to capture video snapshot")
    return result.stdout


def video_stream_targets(settings, manager_payload=None):
    manager_payload = manager_payload or {}
    portal_config = read_json_file(PORTAL_CONFIG_FILE, {})
    secrets = read_json_file(PORTAL_SECRETS_FILE, {})
    foxglove_topic = settings.get("foxglove_topic") or "/camera/image_raw/compressed"
    atlas_topic = settings.get("atlas_camera_topic") or foxglove_topic
    foxglove_status = manager_payload.get("foxglove", ros_topic_available(foxglove_topic, "sensor_msgs/msg/CompressedImage"))
    atlas_topic_status = manager_payload.get("atlas_topic", ros_topic_available(atlas_topic, "sensor_msgs/msg/CompressedImage"))
    atlas_ready = bool(settings.get("atlas_webrtc_enabled") and portal_config.get("atlas_url") and secrets.get("atlas_token") and atlas_topic_status.get("available"))
    return {
        "rtsp": {
            "enabled": bool(settings.get("stream_enabled")),
            "url": settings.get("rtsp_url") or "rtsp://127.0.0.1:8554/yari-video",
            "encoding": settings.get("encoding", "mjpeg"),
            "fps": settings.get("fps", 15),
            "bandwidth_kbps": settings.get("bandwidth_kbps"),
        },
        "foxglove": {
            "topic": foxglove_topic,
            "expected_type": "sensor_msgs/msg/CompressedImage",
            "ready": bool(foxglove_status.get("available")),
            "status": foxglove_status,
            "message": "Use this compressed ROS image topic in Foxglove for low-bandwidth live video.",
        },
        "atlas_webrtc": {
            "enabled": bool(settings.get("atlas_webrtc_enabled")),
            "camera_topic": atlas_topic,
            "max_video_fps": settings.get("atlas_max_video_fps", settings.get("fps", 15)),
            "ready": atlas_ready,
            "atlas_url_configured": bool(portal_config.get("atlas_url")),
            "atlas_token_configured": bool(secrets.get("atlas_token")),
            "topic_status": atlas_topic_status,
            "message": "Atlas WebRTC is ready when enabled, Atlas credentials are saved, and the compressed camera topic is published.",
        },
    }


def video_status():
    manager_payload = service_manager_status("video")
    devices = manager_payload.get("devices", glob_paths(["/dev/video*", "/dev/media*"]))
    settings = manager_payload.get("settings", read_video_settings())
    return {
        "devices": devices,
        "service": service_status("yari-video"),
        "profiles": manager_payload.get("profiles", ["foxglove-compressed", "atlas-webrtc", "rtsp-low-latency"]),
        "settings": settings,
        "preview": video_preview_status(settings, devices),
        "stream_targets": manager_payload.get("stream_targets", video_stream_targets(settings, manager_payload)),
        "manager_state": manager_payload,
        "message": "Camera pipelines can publish ROS image topics, Foxglove streams, RTSP, or Atlas WebRTC feeds.",
    }


def data_status():
    bags = []
    if MCAP_DIR.exists():
        for path in sorted(MCAP_DIR.glob("**/*.mcap"), key=lambda p: p.stat().st_mtime, reverse=True)[:20]:
            stat = path.stat()
            bags.append({"path": str(path), "bytes": stat.st_size, "modified": int(stat.st_mtime)})
    flight_logs = glob_paths(["/var/log/*/*.ulg", "/var/log/*.ulg", "/home/*/**/*.ulg", "/home/*/**/*.BIN", "/home/*/**/*.bin"])[:50]
    manager_payload = service_manager_status("log-manager")
    return {
        "mcap_dir": str(MCAP_DIR),
        "mcap_logs": manager_payload.get("mcap_logs", bags),
        "flight_logs": manager_payload.get("flight_logs", flight_logs),
        "upload_queue": manager_payload.get("upload_queue", read_upload_queue().get("items", [])),
        "storage_cleanup": {"supported": True, "message": "Manual cleanup should be confirmed by the operator before deleting logs."},
        "remote_flight_logs": manager_payload.get("remote_flight_logs", {"ok": False, "state": "log-manager-status-unavailable", "logs": []}),
        "flight_log_downloads": manager_payload.get("flight_log_downloads", read_flight_log_downloads()),
        "service": service_status("yari-log-manager"),
        "manager_state": manager_payload,
    }


def ota_artifacts():
    artifacts = []
    if OTA_ARTIFACT_DIR.exists():
        for path in sorted(OTA_ARTIFACT_DIR.glob("*"), key=lambda p: p.stat().st_mtime, reverse=True):
            if path.is_file() and path.suffix.lower() in {".mender", ".yarios"}:
                stat = path.stat()
                artifacts.append({"path": str(path), "name": path.name, "bytes": stat.st_size, "modified": int(stat.st_mtime)})
    return artifacts


def mender_version():
    if not has_command("mender"):
        return {"available": False, "version": "", "error": "mender client is not installed"}
    result = command_output(["mender", "--version"], timeout=8)
    return {"available": True, "version": result.get("stdout", ""), "error": result.get("stderr", "")}


def default_ota_config():
    return {
        "release_channel": "stable",
        "auto_check": True,
        "auto_download": False,
        "auto_install": False,
        "atlas_assignment_url": "",
        "require_signed_artifacts": True,
    }


def read_ota_config():
    config = {**default_ota_config(), **read_json_file(OTA_CONFIG_FILE, {})}
    if config.get("release_channel") not in {"dev", "beta", "stable"}:
        config["release_channel"] = "stable"
    return config


def save_ota_config(payload):
    channel = str(payload.get("release_channel") or payload.get("channel") or "stable").strip().lower()
    if channel not in {"dev", "beta", "stable"}:
        raise ValueError("release_channel must be one of dev, beta, stable")
    auto_install = bool(payload.get("auto_install") in {True, "true", "on", "1", 1})
    auto_download = bool(payload.get("auto_download") in {True, "true", "on", "1", 1}) or auto_install
    config = {
        "release_channel": channel,
        "auto_check": bool(payload.get("auto_check") in {True, "true", "on", "1", 1}),
        "auto_download": auto_download,
        "auto_install": auto_install,
        "atlas_assignment_url": str(payload.get("atlas_assignment_url") or "").strip(),
        "require_signed_artifacts": bool(payload.get("require_signed_artifacts", True) in {True, "true", "on", "1", 1}),
        "updated": int(time.time()),
    }
    if config["auto_install"] and not config["require_signed_artifacts"]:
        raise ValueError("auto_install requires signed artifacts")
    OTA_CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
    OTA_CONFIG_FILE.write_text(json.dumps(config, indent=2) + "\n")
    os.chmod(OTA_CONFIG_FILE, 0o600)
    return {"ok": True, "config": config}


def ota_status():
    state = read_json_file(OTA_STATE_FILE, {"state": "idle"})
    return {
        "supported": True,
        "engine": "mender",
        "mender": mender_version(),
        "artifact_dir": str(OTA_ARTIFACT_DIR),
        "artifacts": ota_artifacts(),
        "state": state,
        "config": read_ota_config(),
        "manual_install_endpoint": "/api/ota/install",
        "config_endpoint": "/api/ota/config",
        "atlas_managed": {"planned": True, "message": "Atlas will assign signed artifacts and orchestrate staged rollout later."},
    }


def resolve_ota_artifact(path_value):
    if not path_value:
        raise ValueError("artifact path is required")
    artifact_dir = OTA_ARTIFACT_DIR.resolve()
    path = Path(str(path_value)).expanduser()
    if not path.is_absolute():
        path = artifact_dir / path
    resolved = path.resolve()
    try:
        resolved.relative_to(artifact_dir)
    except ValueError as exc:
        raise ValueError(f"artifact must be under {artifact_dir}") from exc
    if not resolved.exists() or not resolved.is_file():
        raise ValueError(f"artifact not found: {resolved}")
    if resolved.suffix.lower() not in {".mender", ".yarios"}:
        raise ValueError("artifact must end with .mender or .yarios")
    return resolved


def write_ota_state(payload):
    OTA_STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
    payload = {**payload, "updated": int(time.time())}
    OTA_STATE_FILE.write_text(json.dumps(payload, indent=2) + "\n")
    os.chmod(OTA_STATE_FILE, 0o600)
    return payload


def install_ota_artifact(payload):
    if not payload.get("confirm"):
        raise ValueError("OTA install requires confirm=true")
    mender = mender_version()
    if not mender["available"]:
        raise ValueError(mender["error"])
    artifact = resolve_ota_artifact(payload.get("path"))
    state = write_ota_state({"state": "installing", "artifact": str(artifact), "engine": "mender"})
    result = command_output(["mender", "install", str(artifact)], timeout=600)
    final_state = "installed-reboot-required" if result["ok"] else "failed"
    state = write_ota_state({"state": final_state, "artifact": str(artifact), "engine": "mender", "stdout": result["stdout"], "stderr": result["stderr"], "returncode": result["returncode"]})
    return {"ok": result["ok"], "state": state, "mender": mender}


def dns_status():
    resolv = read_text_file("/etc/resolv.conf")
    servers = []
    for line in resolv.splitlines():
        parts = line.split()
        if len(parts) == 2 and parts[0] == "nameserver":
            servers.append(parts[1])
    return servers


def network_config_placeholders():
    return {
        "ap_mode": {"ssid": ap_ssid(), "address": AP_ADDR, "security": "wpa-psk" if AP_PASSWORD else "open"},
        "client_wifi": {"profile": "yari-wifi", "configured_ssid": read_configured_ssid()},
        "ethernet": {"managed_by": "NetworkManager", "dhcp": True},
        "static_ip": {"supported": True, **read_static_ip_config()},
        "policy": read_network_policy(),
        "dns": {"servers": dns_status()},
        "lte": {"supported": False, "message": "LTE modem support placeholder."},
    }


def log_sources():
    return {
        "onboarding": {"kind": "journal", "service": "yari-onboarding"},
        "system": {"kind": "journal"},
        "ros": {"kind": "paths", "paths": glob_paths(["/home/*/.ros/log/latest/*", "/home/*/.ros/log/*/*.log"])[:50]},
        "mavlink": {"kind": "journal", "service": "yari-mavlink-router"},
    }


def logs_status():
    return {
        "sources": log_sources(),
        "support_bundle_endpoint": "/api/logs/support-bundle",
        "support_bundle": {
            "format": "tar.gz",
            "includes": [
                "device, network, service, ROS, video, data, app, and OTA status snapshots",
                "sanitized YARI config files and app manifests",
                "onboarding, system, ROS, MAVLink, and YARI service logs",
            ],
            "redaction": "passwords, tokens, secrets, authorization headers, and SSH keys are redacted",
        },
    }


def read_log_source(source, lines=160):
    lines = max(1, min(int(lines), 1000))
    if source == "system":
        result = command_output(["journalctl", "-n", str(lines), "--no-pager"], timeout=12)
        return {"ok": result["ok"], "source": source, "logs": result["stdout"], "error": result["stderr"]}
    if source == "onboarding":
        return service_logs("yari-onboarding", lines)
    if source == "mavlink":
        return service_logs("yari-mavlink-router", lines)
    if source == "ros":
        paths = glob_paths(["/home/*/.ros/log/latest/*", "/home/*/.ros/log/*/*.log"])[:20]
        chunks = []
        for item in paths[:8]:
            result = command_output(["tail", "-n", str(max(20, lines // 4)), item], timeout=4)
            if result["stdout"]:
                chunks.append(f"==> {item} <==\n{result['stdout']}")
        return {"ok": True, "source": source, "logs": "\n\n".join(chunks), "paths": paths}
    raise ValueError(f"Unsupported log source '{source}'")


def sanitize_support_payload(value):
    secret_keys = {"password", "psk", "token", "secret", "authorization", "authorized_keys", "ssh_password", "atlas_token", "foxglove_token"}
    if isinstance(value, dict):
        result = {}
        for key, item in value.items():
            lowered = str(key).lower()
            if any(secret in lowered for secret in secret_keys):
                result[key] = redact_secret(item) if item else {"configured": False}
            else:
                result[key] = sanitize_support_payload(item)
        return result
    if isinstance(value, list):
        return [sanitize_support_payload(item) for item in value]
    return value


def support_config_snapshots():
    snapshots = {
        "device-portal-config.json": sanitize_support_payload(read_json_file(PORTAL_CONFIG_FILE, {})),
        "network-policy.json": read_network_policy(),
        "static-network.json": read_static_ip_config(),
        "ota-config.json": read_ota_config(),
        "ota-state.json": read_json_file(OTA_STATE_FILE, {"state": "idle"}),
        "upload-queue.json": sanitize_support_payload(read_upload_queue()),
        "flight-log-downloads.json": read_flight_log_downloads(),
    }
    return snapshots


def support_app_manifest_snapshots():
    manifests = {}
    for app in raw_app_manifests()[0]:
        source = app.get("source") or "builtin"
        name = f"{app['id']}.json"
        manifests[name] = sanitize_support_payload(app)
        manifests[name]["source"] = source
    return manifests


def support_bundle():
    SUPPORT_BUNDLE_DIR.mkdir(parents=True, exist_ok=True)
    bundle = SUPPORT_BUNDLE_DIR / f"yari-support-{device_id()}-{int(time.time())}.tar.gz"
    payloads = {
        "device-status.json": device_status(),
        "network-status.json": network_status(),
        "network-diagnostics.json": network_diagnostics(),
        "services.json": services_status(),
        "apps.json": app_catalog(),
        "app-packages.json": app_packages(),
        "ota-status.json": ota_status(),
        "autopilot-status.json": autopilot_status(),
        "ros-status.json": ros_status(),
        "video-status.json": video_status(),
        "data-status.json": data_status(),
        "logs-status.json": logs_status(),
        "portal-version.json": portal_version(),
    }
    with tarfile.open(bundle, "w:gz") as tar:
        for name, payload in payloads.items():
            tmp = SUPPORT_BUNDLE_DIR / name
            tmp.write_text(json.dumps(sanitize_support_payload(payload), indent=2) + "\n")
            tar.add(tmp, arcname=name)
            tmp.unlink(missing_ok=True)
        if PORTAL_ASSETS_FILE.exists():
            tar.add(PORTAL_ASSETS_FILE, arcname="portal-assets.json")
        for name, payload in support_config_snapshots().items():
            tmp = SUPPORT_BUNDLE_DIR / name
            tmp.write_text(json.dumps(payload, indent=2) + "\n")
            tar.add(tmp, arcname=f"config/{name}")
            tmp.unlink(missing_ok=True)
        for name, payload in support_app_manifest_snapshots().items():
            tmp = SUPPORT_BUNDLE_DIR / name
            tmp.write_text(json.dumps(payload, indent=2) + "\n")
            tar.add(tmp, arcname=f"apps/{name}")
            tmp.unlink(missing_ok=True)
        for source in ("onboarding", "system", "ros", "mavlink"):
            tmp = SUPPORT_BUNDLE_DIR / f"{source}.log"
            tmp.write_text(read_log_source(source, 240).get("logs", "") + "\n")
            tar.add(tmp, arcname=f"logs/{source}.log")
            tmp.unlink(missing_ok=True)
    os.chmod(bundle, 0o600)
    return bundle


def shutdown_soon():
    def delayed():
        time.sleep(2)
        run(["systemctl", "poweroff"], capture=False)
    threading.Thread(target=delayed, daemon=True).start()


def factory_reset(reboot=False):
    COMPLETE_FILE.unlink(missing_ok=True)
    for path in (NM_CONNECTION_DIR / "yari-wifi.nmconnection", NETPLAN_DIR / "01-yari-wifi.yaml"):
        path.unlink(missing_ok=True)
    if has_command("nmcli"):
        run(["nmcli", "connection", "delete", "yari-wifi"], capture=True)
        run(["nmcli", "connection", "reload"], capture=True)
    state = current_state({"mode": "factory-reset", "complete": False})
    write_state(state)
    if reboot:
        reboot_soon()
    return state


class Handler(SimpleHTTPRequestHandler):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, directory=str(WEB_DIR), **kwargs)

    def log_message(self, fmt, *args):
        sys.stderr.write("yari-onboarding: " + fmt % args + "\n")

    def send_json(self, code, payload):
        body = json.dumps(payload, indent=2).encode("utf-8")
        self.send_response(code)
        self.send_header("content-type", "application/json")
        self.send_header("cache-control", "no-store")
        self.send_header("content-length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def send_binary(self, code, content_type, body):
        self.send_response(code)
        self.send_header("content-type", content_type)
        self.send_header("cache-control", "no-store")
        self.send_header("content-length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def serve_static(self, request_path):
        relative = unquote(request_path.lstrip("/")) or "index.html"
        if relative.endswith("/"):
            relative = f"{relative}index.html"
        if ".." in Path(relative).parts:
            self.send_error(404)
            return
        target = WEB_DIR / relative
        if not target.exists() or target.is_dir():
            target = WEB_DIR / "index.html"
        if not target.exists():
            self.send_error(404)
            return
        content_path = target
        use_gzip = "gzip" in self.headers.get("accept-encoding", "") and target.with_suffix(target.suffix + ".gz").exists()
        if use_gzip:
            content_path = target.with_suffix(target.suffix + ".gz")
        body = content_path.read_bytes()
        content_type = mimetypes.guess_type(str(target))[0] or "application/octet-stream"
        self.send_response(200)
        self.send_header("content-type", content_type)
        self.send_header("vary", "Accept-Encoding")
        if use_gzip:
            self.send_header("content-encoding", "gzip")
        if target.name == "index.html":
            self.send_header("cache-control", "no-cache")
        else:
            self.send_header("cache-control", "public, max-age=31536000, immutable")
        self.send_header("content-length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        parsed = urlparse(self.path)
        path = parsed.path
        query = parse_qs(parsed.query)
        try:
            if path in {"/api/status", "/api/device/status"}:
                self.send_json(200, device_status())
                return
            if path == "/api/network/status":
                self.send_json(200, network_status())
                return
            if path == "/api/portal/version":
                self.send_json(200, portal_version())
                return
            if path == "/api/network/diagnostics":
                self.send_json(200, network_diagnostics())
                return
            if path == "/api/network/wifi/scan":
                self.send_json(200, wifi_scan())
                return
            if path == "/api/setup/status":
                self.send_json(200, portal_config_status())
                return
            if path == "/api/services":
                self.send_json(200, services_status())
                return
            if path == "/api/apps":
                self.send_json(200, app_catalog())
                return
            if path == "/api/apps/registry":
                self.send_json(200, app_registry())
                return
            if path == "/api/apps/packages":
                self.send_json(200, app_packages())
                return
            if path == "/api/logs":
                self.send_json(200, logs_status())
                return
            if path == "/api/logs/support-bundle":
                bundle = support_bundle()
                body = bundle.read_bytes()
                self.send_response(200)
                self.send_header("content-type", "application/gzip")
                self.send_header("content-disposition", f"attachment; filename={bundle.name}")
                self.send_header("content-length", str(len(body)))
                self.end_headers()
                self.wfile.write(body)
                return
            logs_match = re.match(r"^/api/logs/([^/]+)$", path)
            if logs_match:
                lines = query.get("lines", ["160"])[0]
                self.send_json(200, read_log_source(logs_match.group(1), lines))
                return
            service_logs_match = re.match(r"^/api/services/([^/]+)/logs$", path)
            if service_logs_match:
                lines = query.get("lines", ["120"])[0]
                self.send_json(200, service_logs(service_logs_match.group(1), lines))
                return
            app_logs_match = re.match(r"^/api/apps/([^/]+)/logs$", path)
            if app_logs_match:
                lines = query.get("lines", ["120"])[0]
                self.send_json(200, app_logs(app_logs_match.group(1), lines))
                return
            if path == "/api/autopilot/status":
                self.send_json(200, autopilot_status())
                return
            if path == "/api/mavlink/endpoints":
                self.send_json(200, read_mavlink_endpoints())
                return
            if path == "/api/ros/status":
                self.send_json(200, ros_status())
                return
            if path == "/api/ros/topics":
                self.send_json(200, ros_topics())
                return
            if path == "/api/video/status":
                self.send_json(200, video_status())
                return
            if path == "/api/video/snapshot":
                self.send_binary(200, "image/jpeg", capture_video_snapshot())
                return
            if path == "/api/data/status":
                self.send_json(200, data_status())
                return
            if path == "/api/ota/status":
                self.send_json(200, ota_status())
                return
        except Exception as exc:
            self.send_json(500, {"ok": False, "error": str(exc)})
            return
        if path.startswith("/api/"):
            self.send_json(404, {"ok": False, "error": "not found"})
            return
        self.serve_static(path)

    def do_POST(self):
        path = urlparse(self.path).path
        if not request_authorized(self.headers):
            self.send_json(401, {"ok": False, "error": "YARI portal API token required"})
            return
        length = int(self.headers.get("content-length", "0") or 0)
        try:
            payload = json.loads(self.rfile.read(length).decode("utf-8") or "{}")
        except json.JSONDecodeError as exc:
            self.send_json(400, {"ok": False, "error": f"invalid json: {exc}"})
            return
        try:
            if path in {"/api/configure", "/api/network/wifi/save"}:
                configure_wifi(str(payload.get("ssid") or ""), str(payload.get("password") or ""), str(payload.get("hostname") or ""))
                self.send_json(200, {"ok": True, "message": "Wi-Fi saved. Device will reboot." if REBOOT_AFTER_SAVE else "Wi-Fi saved."})
                if REBOOT_AFTER_SAVE:
                    reboot_soon()
                return
            if path == "/api/setup/config":
                result = save_setup_config(payload)
                result["message"] = "Setup saved. Device will reboot." if result.get("wifi_configured") and REBOOT_AFTER_SAVE else "Setup saved."
                self.send_json(200, result)
                if result.get("wifi_configured") and REBOOT_AFTER_SAVE:
                    reboot_soon()
                return
            if path == "/api/reboot":
                self.send_json(200, {"ok": True, "message": "Rebooting."})
                reboot_soon()
                return
            if path == "/api/shutdown":
                self.send_json(200, {"ok": True, "message": "Shutting down."})
                shutdown_soon()
                return
            if path == "/api/device/regenerate-id":
                self.send_json(200, {"ok": True, "state": regenerate_device_id()})
                return
            if path == "/api/device/profile":
                self.send_json(200, save_device_profile(payload))
                return
            if path == "/api/network/ap/enable":
                ensure_ap()
                self.send_json(200, {"ok": True, "state": read_state()})
                return
            if path == "/api/network/static-ip":
                self.send_json(200, save_static_ip_config(payload))
                return
            if path == "/api/network/policy":
                self.send_json(200, save_network_policy(payload))
                return
            if path == "/api/network/wifi/reconnect":
                self.send_json(200, reconnect_wifi())
                return
            if path == "/api/network/wifi/forget":
                self.send_json(200, forget_wifi())
                return
            if path == "/api/network/factory-reset":
                self.send_json(200, {"ok": True, "state": factory_reset(bool(payload.get("reboot", False)))})
                return
            if path == "/api/ota/config":
                self.send_json(200, save_ota_config(payload))
                return
            if path == "/api/ota/install":
                self.send_json(200, install_ota_artifact(payload))
                return
            service_match = re.match(r"^/api/services/([^/]+)/(start|stop|restart|enable|disable)$", path)
            if service_match:
                self.send_json(200, service_action(service_match.group(1), service_match.group(2)))
                return
            if path == "/api/apps/validate":
                self.send_json(200, validate_app_manifest_payload(payload))
                return
            if path == "/api/apps/install":
                self.send_json(200, install_app_manifest(payload))
                return
            if path == "/api/apps/packages/upload":
                self.send_json(200, upload_app_package(payload))
                return
            app_registry_install_match = re.match(r"^/api/apps/registry/([^/]+)/install$", path)
            if app_registry_install_match:
                self.send_json(200, install_registry_app(app_registry_install_match.group(1), bool(payload.get("replace", False))))
                return
            app_package_install_match = re.match(r"^/api/apps/packages/([^/]+)/install$", path)
            if app_package_install_match:
                self.send_json(200, install_app_package(unquote(app_package_install_match.group(1)), bool(payload.get("replace", False))))
                return
            app_package_delete_match = re.match(r"^/api/apps/packages/([^/]+)/delete$", path)
            if app_package_delete_match:
                self.send_json(200, delete_app_package(unquote(app_package_delete_match.group(1))))
                return
            app_uninstall_match = re.match(r"^/api/apps/([^/]+)/uninstall$", path)
            if app_uninstall_match:
                self.send_json(200, uninstall_app_manifest(app_uninstall_match.group(1)))
                return
            app_update_match = re.match(r"^/api/apps/([^/]+)/update$", path)
            if app_update_match:
                self.send_json(200, update_installed_app(app_update_match.group(1)))
                return
            app_match = re.match(r"^/api/apps/([^/]+)/(start|stop|restart)$", path)
            if app_match:
                self.send_json(200, app_action(app_match.group(1), app_match.group(2)))
                return
            if path == "/api/mavlink/endpoints":
                self.send_json(200, {"ok": True, "config": write_mavlink_endpoints(payload)})
                return
            if path == "/api/ros/recording/start":
                self.send_json(200, start_ros_recording(payload))
                return
            if path == "/api/ros/recording/stop":
                self.send_json(200, stop_ros_recording())
                return
            if path == "/api/video/settings":
                self.send_json(200, {"ok": True, "settings": save_video_settings(payload)})
                return
            if path == "/api/data/flight-logs/download":
                self.send_json(200, queue_flight_log_download(payload))
                return
            if path == "/api/data/flight-logs/retry":
                self.send_json(200, retry_flight_log_downloads(payload))
                return
            if path == "/api/data/uploads/enqueue":
                self.send_json(200, enqueue_uploads(payload))
                return
            if path == "/api/data/uploads/retry":
                self.send_json(200, retry_uploads(payload))
                return
            if path == "/api/data/uploads/clear":
                self.send_json(200, clear_upload_queue(payload))
                return
            if path == "/api/data/cleanup":
                self.send_json(200, cleanup_data_logs(payload))
                return
            if path == "/api/ros/launch-profile":
                action = str(payload.get("action") or "start")
                if action == "stop":
                    self.send_json(200, stop_ros_launch_profile())
                elif action == "start":
                    self.send_json(200, start_ros_launch_profile(payload))
                else:
                    self.send_json(400, {"ok": False, "error": "action must be start or stop"})
                return
        except Exception as exc:
            self.send_json(500, {"ok": False, "error": str(exc)})
            return
        self.send_json(404, {"ok": False, "error": "not found"})


def serve_http(label="YARI onboarding"):
    server = ThreadingHTTPServer(("0.0.0.0", HTTP_PORT), Handler)
    print(f"{label} serving http://0.0.0.0:{HTTP_PORT}", flush=True)
    server.serve_forever()


def serve():
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    policy = read_network_policy()
    if policy.get("maintenance_ap_enabled"):
        ensure_ap()
        serve_http(f"YARI maintenance setup AP {ap_ssid()}")
        return
    if wait_for_connectivity(policy.get("fallback_timeout_sec", CONNECTIVITY_TIMEOUT)):
        write_state(current_state({"mode": "client", "message": "network already connected"}))
        serve_http("YARI device portal")
        return
    if policy.get("fallback_ap_enabled", True):
        ensure_ap()
        serve_http(f"YARI onboarding setup AP {ap_ssid()}")
        return
    write_state(current_state({"mode": "client-failed-no-ap", "message": "network unavailable and fallback AP disabled"}))
    serve_http("YARI device portal")


def main():
    parser = argparse.ArgumentParser(description="YARI first-boot network onboarding")
    parser.add_argument("command", choices=["serve", "status", "ap", "web"], nargs="?", default="serve")
    args = parser.parse_args()
    if args.command == "status":
        print(json.dumps(current_state(), indent=2))
    elif args.command == "ap":
        ensure_ap()
    elif args.command == "web":
        serve_http()
    else:
        serve()


if __name__ == "__main__":
    main()





