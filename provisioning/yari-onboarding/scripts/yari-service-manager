#!/usr/bin/env python3
import argparse
import json
import os
import signal
import subprocess
import time
import uuid
from pathlib import Path
from urllib import request as urlrequest
from urllib.error import HTTPError, URLError

STATE_DIR = Path(os.environ.get("YARI_SERVICE_STATE_DIR", "/var/lib/yari/services"))
RUNTIME_DIR = Path(os.environ.get("YARI_SERVICE_RUNTIME_DIR", "/run/yari"))
CONFIG_DIR = Path(os.environ.get("YARI_DEVICE_CONFIG_DIR", "/etc/yari"))
MCAP_DIR = Path(os.environ.get("YARI_MCAP_DIR", "/home/tortoisebot/tortoisebot_mcap"))
MAVLINK_CONFIG_FILE = Path(os.environ.get("YARI_MAVLINK_CONFIG_FILE", "/etc/yari/mavlink-endpoints.json"))
UPLOAD_QUEUE_FILE = Path(os.environ.get("YARI_UPLOAD_QUEUE_FILE", "/var/lib/yari/upload-queue.json"))
FLIGHT_LOG_DIR = Path(os.environ.get("YARI_FLIGHT_LOG_DIR", "/var/lib/yari/flight-logs"))
FLIGHT_LOG_DOWNLOADS_FILE = Path(os.environ.get("YARI_FLIGHT_LOG_DOWNLOADS_FILE", "/var/lib/yari/flight-log-downloads.json"))
ROS_LAUNCH_CONFIG_FILE = Path(os.environ.get("YARI_ROS_LAUNCH_CONFIG_FILE", "/etc/yari/ros-launch-profiles.json"))
ROS_LAUNCH_STATE_FILE = Path(os.environ.get("YARI_ROS_LAUNCH_STATE_FILE", "/var/lib/yari/onboarding/ros-launch.json"))

RUNNING = True


def stop(_signum, _frame):
    global RUNNING
    RUNNING = False


def command(args, timeout=8):
    try:
        result = subprocess.run(args, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=timeout)
    except (FileNotFoundError, subprocess.TimeoutExpired) as exc:
        return {"ok": False, "stdout": "", "stderr": str(exc), "returncode": 1}
    return {"ok": result.returncode == 0, "stdout": result.stdout.strip(), "stderr": result.stderr.strip(), "returncode": result.returncode}


def glob_paths(patterns, limit=50):
    found = []
    for pattern in patterns:
        found.extend(str(path) for path in sorted(Path("/").glob(pattern.lstrip("/"))))
    return found[:limit]


def read_json(path, default):
    try:
        return json.loads(path.read_text())
    except (FileNotFoundError, PermissionError, OSError, json.JSONDecodeError):
        return default


def write_status(role, payload):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    payload.update({"role": role, "updated": int(time.time())})
    path = STATE_DIR / f"{role}.json"
    path.write_text(json.dumps(payload, indent=2) + "\n")
    os.chmod(path, 0o644)


def service_status(role):
    return {
        "ok": True,
        "message": f"yari-{role} service heartbeat",
        "pid": os.getpid(),
    }


def command_exists(name):
    return command(["bash", "-lc", f"command -v {name}"], timeout=5)["ok"]


def write_mavlink_router_config(endpoints):
    RUNTIME_DIR.mkdir(parents=True, exist_ok=True)
    config_path = RUNTIME_DIR / "mavlink-router.conf"
    serial = next((endpoint for endpoint in endpoints if endpoint.get("enabled") and endpoint.get("type") == "serial"), None)
    lines = ["[General]", "ReportStats=false", "MavlinkDialect=auto", ""]
    if serial:
        lines.extend(["[UartEndpoint autopilot]", f"Device={serial.get('device', '/dev/ttyACM0')}", f"Baud={int(serial.get('baud', 57600))}", ""])
    udp_count = 0
    for endpoint in endpoints:
        if not endpoint.get("enabled") or endpoint.get("type") != "udp":
            continue
        udp_count += 1
        name = endpoint.get("name") or f"udp-{udp_count}"
        host = endpoint.get("host") or "127.0.0.1"
        port = int(endpoint.get("port", 14550))
        mode = endpoint.get("mode") or "normal"
        lines.extend([f"[UdpEndpoint {name}]", f"Address={host}", f"Port={port}", f"Mode={mode}", ""])
    config_path.write_text("\n".join(lines))
    os.chmod(config_path, 0o644)
    return config_path


def start_mavlink_router_process(config_path):
    if not command_exists("mavlink-routerd"):
        return {"running": False, "error": "mavlink-routerd is not installed"}
    pid_file = RUNTIME_DIR / "mavlink-router.pid"
    if pid_file.exists():
        try:
            pid = int(pid_file.read_text().strip())
            os.kill(pid, 0)
            return {"running": True, "pid": pid, "config": str(config_path)}
        except (ValueError, ProcessLookupError):
            pid_file.unlink(missing_ok=True)
    log_file = RUNTIME_DIR / "mavlink-router.log"
    log_handle = log_file.open("ab")
    proc = subprocess.Popen(["mavlink-routerd", "-c", str(config_path)], stdout=log_handle, stderr=subprocess.STDOUT, start_new_session=True)
    pid_file.write_text(str(proc.pid) + "\n")
    return {"running": True, "pid": proc.pid, "config": str(config_path), "log_file": str(log_file)}


def mavlink_router_status():
    endpoints = read_json(MAVLINK_CONFIG_FILE, {"endpoints": []}).get("endpoints", [])
    enabled = [endpoint for endpoint in endpoints if endpoint.get("enabled")]
    router = {"running": False, "message": "no enabled MAVLink endpoints"}
    config_path = None
    if enabled:
        config_path = write_mavlink_router_config(endpoints)
        router = start_mavlink_router_process(config_path)
    return {
        **service_status("mavlink-router"),
        "config_file": str(MAVLINK_CONFIG_FILE),
        "router_config": str(config_path) if config_path else None,
        "endpoints": endpoints,
        "enabled_endpoints": enabled,
        "serial_devices": glob_paths(["/dev/serial/by-id/*", "/dev/ttyACM*", "/dev/ttyUSB*", "/dev/ttyAMA*"]),
        "routing": "running" if router.get("running") else ("configured" if enabled else "disabled"),
        "router_process": router,
    }



def mavlink_connection_target(endpoint):
    if endpoint.get("type") == "serial":
        return str(endpoint.get("device") or "/dev/ttyACM0"), int(endpoint.get("baud", 57600))
    if endpoint.get("type") == "udp":
        host = endpoint.get("host") or "0.0.0.0"
        port = int(endpoint.get("port", 14550))
        mode = endpoint.get("mode") or "udpin"
        if mode not in {"udpin", "udpout", "udp"}:
            mode = "udpin"
        return f"{mode}:{host}:{port}", None
    return None, None


def import_mavutil():
    try:
        from pymavlink import mavutil
        return mavutil, None
    except Exception as exc:
        return None, str(exc)


def mavlink_autopilot_name(value):
    mapping = {
        3: "ArduPilot",
        12: "PX4",
    }
    return mapping.get(value, f"unknown({value})" if value is not None else "unknown")


def heartbeat_summary(connection, heartbeat, mavutil):
    base_mode = getattr(heartbeat, "base_mode", None)
    autopilot = getattr(heartbeat, "autopilot", None)
    armed_flag = getattr(mavutil.mavlink, "MAV_MODE_FLAG_SAFETY_ARMED", 128)
    return {
        "type": getattr(heartbeat, "type", None),
        "autopilot": autopilot,
        "flight_stack": mavlink_autopilot_name(autopilot),
        "base_mode": base_mode,
        "custom_mode": getattr(heartbeat, "custom_mode", None),
        "system_status": getattr(heartbeat, "system_status", None),
        "mode": getattr(connection, "flightmode", None),
        "armed": bool(base_mode & armed_flag) if base_mode is not None else None,
        "system_id": getattr(connection, "target_system", None),
        "component_id": getattr(connection, "target_component", None),
    }


def collect_mavlink_status(connection, deadline):
    battery = None
    gps = None
    version = None
    while time.monotonic() < deadline and (battery is None or gps is None or version is None):
        try:
            msg = connection.recv_match(blocking=False)
        except Exception:
            break
        if msg is None:
            time.sleep(0.05)
            continue
        msg_type = msg.get_type() if hasattr(msg, "get_type") else ""
        if msg_type == "BATTERY_STATUS":
            voltages = getattr(msg, "voltages", []) or []
            valid = [value for value in voltages if isinstance(value, int) and value not in {0, 65535}]
            battery = {
                "voltage_v": round(sum(valid) / 1000, 2) if valid else None,
                "remaining_percent": getattr(msg, "battery_remaining", None),
            }
        elif msg_type == "SYS_STATUS":
            voltage = getattr(msg, "voltage_battery", None)
            battery = {
                "voltage_v": round(voltage / 1000, 2) if isinstance(voltage, int) and voltage > 0 else None,
                "remaining_percent": getattr(msg, "battery_remaining", None),
            }
        elif msg_type == "GPS_RAW_INT":
            gps = {
                "fix_type": getattr(msg, "fix_type", None),
                "satellites_visible": getattr(msg, "satellites_visible", None),
                "lat": getattr(msg, "lat", None),
                "lon": getattr(msg, "lon", None),
                "alt_mm": getattr(msg, "alt", None),
            }
        elif msg_type == "AUTOPILOT_VERSION":
            version = {
                "flight_sw_version": getattr(msg, "flight_sw_version", None),
                "middleware_sw_version": getattr(msg, "middleware_sw_version", None),
                "board_version": getattr(msg, "board_version", None),
                "vendor_id": getattr(msg, "vendor_id", None),
                "product_id": getattr(msg, "product_id", None),
            }
    return {"battery": battery, "gps": gps, "version": version}


def probe_autopilot(endpoints, timeout=2.5):
    enabled = [endpoint for endpoint in endpoints if endpoint.get("enabled")]
    candidates = [endpoint for endpoint in enabled if endpoint.get("type") in {"serial", "udp"}]
    if not candidates:
        return {"connected": False, "detection": "no-enabled-mavlink-endpoint"}
    mavutil, import_error = import_mavutil()
    if mavutil is None:
        return {"connected": False, "detection": "pymavlink-missing", "error": import_error}
    errors = []
    for endpoint in candidates:
        target, baud = mavlink_connection_target(endpoint)
        if not target:
            continue
        try:
            kwargs = {"autoreconnect": True}
            if baud:
                kwargs["baud"] = baud
            connection = mavutil.mavlink_connection(target, **kwargs)
            heartbeat = connection.wait_heartbeat(timeout=timeout)
        except Exception as exc:
            errors.append({"endpoint": endpoint.get("name") or target, "error": str(exc)})
            continue
        if heartbeat is None:
            errors.append({"endpoint": endpoint.get("name") or target, "error": "heartbeat timeout"})
            continue
        summary = heartbeat_summary(connection, heartbeat, mavutil)
        status = collect_mavlink_status(connection, time.monotonic() + 1.0)
        try:
            connection.close()
        except Exception:
            pass
        return {
            "connected": True,
            "detection": "heartbeat",
            "endpoint": endpoint,
            "heartbeat": summary,
            "flight_stack": summary.get("flight_stack"),
            "mode": summary.get("mode"),
            "armed": summary.get("armed"),
            "battery": status.get("battery"),
            "gps": status.get("gps"),
            "version": status.get("version"),
        }
    return {"connected": False, "detection": "no-heartbeat", "errors": errors}

def autopilot_manager_status():
    serial_devices = glob_paths(["/dev/serial/by-id/*", "/dev/ttyACM*", "/dev/ttyUSB*", "/dev/ttyAMA*"])
    endpoints = read_json(MAVLINK_CONFIG_FILE, {"endpoints": []}).get("endpoints", [])
    probe = probe_autopilot(endpoints)
    return {
        **service_status("autopilot-manager"),
        "flight_stack": probe.get("flight_stack", "unknown"),
        "connected": bool(probe.get("connected")),
        "serial_devices": serial_devices,
        "endpoints": endpoints,
        "heartbeat": probe.get("heartbeat"),
        "version": probe.get("version"),
        "mode": probe.get("mode"),
        "battery": probe.get("battery"),
        "gps": probe.get("gps"),
        "armed": probe.get("armed"),
        "detection": probe.get("detection"),
        "probe": probe,
    }





def mavlink_candidates(endpoints):
    return [endpoint for endpoint in endpoints if endpoint.get("enabled") and endpoint.get("type") in {"serial", "udp"}]


def connect_mavlink_endpoint(endpoint, timeout=2.5):
    mavutil, import_error = import_mavutil()
    if mavutil is None:
        return None, None, {"ok": False, "state": "pymavlink-missing", "error": import_error}
    target, baud = mavlink_connection_target(endpoint)
    if not target:
        return None, mavutil, {"ok": False, "state": "invalid-endpoint"}
    try:
        kwargs = {"autoreconnect": True}
        if baud:
            kwargs["baud"] = baud
        connection = mavutil.mavlink_connection(target, **kwargs)
        heartbeat = connection.wait_heartbeat(timeout=timeout)
        if heartbeat is None:
            return None, mavutil, {"ok": False, "state": "heartbeat-timeout"}
        return connection, mavutil, {"ok": True, "endpoint": endpoint}
    except Exception as exc:
        return None, mavutil, {"ok": False, "state": "connection-error", "error": str(exc)}


def list_remote_flight_logs(endpoints, timeout=2.5):
    candidates = mavlink_candidates(endpoints)
    if not candidates:
        return {"ok": False, "state": "no-enabled-mavlink-endpoint", "logs": []}
    errors = []
    for endpoint in candidates:
        connection, _mavutil, status = connect_mavlink_endpoint(endpoint, timeout=timeout)
        if not status.get("ok"):
            errors.append(status)
            continue
        logs = []
        try:
            connection.mav.log_request_list_send(connection.target_system, connection.target_component, 0, 0xFFFF)
            deadline = time.monotonic() + timeout
            while time.monotonic() < deadline:
                msg = connection.recv_match(type="LOG_ENTRY", blocking=True, timeout=0.2)
                if msg is None:
                    continue
                logs.append({
                    "id": getattr(msg, "id", None),
                    "num_logs": getattr(msg, "num_logs", None),
                    "last_log_num": getattr(msg, "last_log_num", None),
                    "time_utc": getattr(msg, "time_utc", None),
                    "size": getattr(msg, "size", None),
                })
                if len(logs) >= 100:
                    break
        except Exception as exc:
            errors.append({"state": "log-list-error", "error": str(exc)})
        finally:
            try:
                connection.close()
            except Exception:
                pass
        return {"ok": True, "state": "listed", "endpoint": endpoint, "logs": logs}
    return {"ok": False, "state": "unreachable", "logs": [], "errors": errors}


def read_flight_log_downloads():
    payload = read_json(FLIGHT_LOG_DOWNLOADS_FILE, {"items": []})
    return [item for item in payload.get("items", []) if isinstance(item, dict)] if isinstance(payload, dict) else []


def write_flight_log_downloads(items):
    FLIGHT_LOG_DOWNLOADS_FILE.parent.mkdir(parents=True, exist_ok=True)
    FLIGHT_LOG_DOWNLOADS_FILE.write_text(json.dumps({"items": items, "updated": int(time.time())}, indent=2) + "\n")
    os.chmod(FLIGHT_LOG_DOWNLOADS_FILE, 0o600)


def queue_flight_log_download(log_id, endpoint_name=""):
    items = read_flight_log_downloads()
    item_id = f"log-{log_id}-{endpoint_name or 'default'}"
    existing = next((item for item in items if item.get("id") == item_id), None)
    item = existing or {"id": item_id, "queued": int(time.time())}
    item.update({"log_id": int(log_id), "endpoint_name": endpoint_name, "status": "queued", "updated": int(time.time())})
    if existing is None:
        items.append(item)
    write_flight_log_downloads(items)
    return item


def download_remote_log(connection, log_id, destination, timeout=8):
    chunks = []
    ofs = 0
    chunk_size = 90
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        connection.mav.log_request_data_send(connection.target_system, connection.target_component, int(log_id), ofs, chunk_size)
        msg = connection.recv_match(type="LOG_DATA", blocking=True, timeout=0.5)
        if msg is None:
            continue
        count = int(getattr(msg, "count", 0) or 0)
        data = bytes(getattr(msg, "data", [])[:count])
        chunks.append(data)
        ofs += count
        if count < chunk_size:
            break
    if not chunks:
        raise RuntimeError("no LOG_DATA chunks received")
    destination.parent.mkdir(parents=True, exist_ok=True)
    destination.write_bytes(b"".join(chunks))
    return {"path": str(destination), "bytes": destination.stat().st_size}


def process_flight_log_downloads(endpoints):
    items = read_flight_log_downloads()
    candidates = mavlink_candidates(endpoints)
    if not items:
        return {"items": [], "counts": {}, "message": "no queued flight log downloads"}
    if not candidates:
        return {"items": items, "counts": download_counts(items), "state": "no-enabled-mavlink-endpoint"}
    changed = False
    for item in items:
        if item.get("status") != "queued":
            continue
        endpoint = next((candidate for candidate in candidates if not item.get("endpoint_name") or candidate.get("name") == item.get("endpoint_name")), candidates[0])
        connection, _mavutil, status = connect_mavlink_endpoint(endpoint)
        if not status.get("ok"):
            item.update({"status": "failed", "error": status, "updated": int(time.time())})
            changed = True
            continue
        try:
            destination = FLIGHT_LOG_DIR / f"autopilot-log-{item.get('log_id')}.bin"
            result = download_remote_log(connection, item.get("log_id"), destination)
            item.update({"status": "downloaded", "path": result["path"], "bytes": result["bytes"], "updated": int(time.time())})
        except Exception as exc:
            item.update({"status": "failed", "error": str(exc), "updated": int(time.time())})
        finally:
            changed = True
            try:
                connection.close()
            except Exception:
                pass
    if changed:
        write_flight_log_downloads(items)
    return {"items": items, "counts": download_counts(items), "download_dir": str(FLIGHT_LOG_DIR)}


def download_counts(items):
    counts = {}
    for item in items:
        status = item.get("status", "unknown")
        counts[status] = counts.get(status, 0) + 1
    return counts


def atlas_upload_endpoint(config):
    if config.get("atlas_upload_url"):
        return str(config["atlas_upload_url"])
    atlas_url = str(config.get("atlas_url") or "").rstrip("/")
    if not atlas_url:
        return ""
    return f"{atlas_url}/logs/upload"


def multipart_upload(url, token, file_path, metadata, timeout=30):
    boundary = f"----yari-{uuid.uuid4().hex}"
    path = Path(file_path)
    fields = {"metadata": json.dumps(metadata)}
    body = bytearray()
    for name, value in fields.items():
        body.extend(f"--{boundary}\r\n".encode())
        body.extend(f'Content-Disposition: form-data; name="{name}"\r\n\r\n'.encode())
        body.extend(str(value).encode())
        body.extend(b"\r\n")
    body.extend(f"--{boundary}\r\n".encode())
    body.extend(f'Content-Disposition: form-data; name="file"; filename="{path.name}"\r\n'.encode())
    body.extend(b"Content-Type: application/octet-stream\r\n\r\n")
    body.extend(path.read_bytes())
    body.extend(b"\r\n")
    body.extend(f"--{boundary}--\r\n".encode())
    req = urlrequest.Request(url, data=bytes(body), method="POST")
    req.add_header("Content-Type", f"multipart/form-data; boundary={boundary}")
    req.add_header("Authorization", f"Bearer {token}")
    req.add_header("User-Agent", "yari-os-agent/0.1")
    with urlrequest.urlopen(req, timeout=timeout) as response:
        response_body = response.read(4096).decode("utf-8", errors="replace")
        return {"status": getattr(response, "status", response.getcode()), "body": response_body}


def process_upload_queue(config, secrets, max_items=1):
    items = read_upload_queue()
    endpoint = atlas_upload_endpoint(config)
    token = secrets.get("atlas_token")
    if not endpoint or not token:
        return {"items": items, "counts": upload_counts(items), "state": "waiting-for-atlas-config", "endpoint_configured": bool(endpoint), "token_configured": bool(token)}
    changed = False
    processed = 0
    for item in items:
        if item.get("status") != "queued" or processed >= max_items:
            continue
        path = Path(str(item.get("path", "")))
        if not path.exists():
            item.update({"status": "missing", "updated": int(time.time()), "error": "file does not exist"})
            changed = True
            continue
        item["attempts"] = int(item.get("attempts", 0)) + 1
        item["status"] = "uploading"
        item["updated"] = int(time.time())
        changed = True
        try:
            response = multipart_upload(endpoint, token, path, item)
            item.update({"status": "uploaded", "uploaded": int(time.time()), "response": response})
        except HTTPError as exc:
            body = exc.read(2048).decode("utf-8", errors="replace") if hasattr(exc, "read") else ""
            item.update({"status": "failed", "updated": int(time.time()), "error": {"type": "http", "code": exc.code, "body": body}})
        except (URLError, TimeoutError, OSError) as exc:
            item.update({"status": "failed", "updated": int(time.time()), "error": {"type": "network", "message": str(exc)}})
        processed += 1
    if changed:
        write_upload_queue(items)
    return {"items": items, "counts": upload_counts(items), "state": "processed" if processed else "idle", "endpoint": endpoint}


def upload_counts(items):
    counts = {}
    for item in items:
        status = item.get("status", "unknown")
        counts[status] = counts.get(status, 0) + 1
    return counts

def read_upload_queue():
    payload = read_json(UPLOAD_QUEUE_FILE, {"items": []})
    items = payload.get("items", []) if isinstance(payload, dict) else []
    normalized = []
    changed = False
    for item in items:
        if not isinstance(item, dict):
            continue
        path = Path(str(item.get("path", "")))
        if item.get("status") in {"queued", "uploading"} and item.get("path") and not path.exists():
            item = dict(item)
            item["status"] = "missing"
            item["updated"] = int(time.time())
            changed = True
        normalized.append(item)
    if changed:
        write_upload_queue(normalized)
    return normalized


def write_upload_queue(items):
    UPLOAD_QUEUE_FILE.parent.mkdir(parents=True, exist_ok=True)
    UPLOAD_QUEUE_FILE.write_text(json.dumps({"items": items, "updated": int(time.time())}, indent=2) + "\n")
    os.chmod(UPLOAD_QUEUE_FILE, 0o600)


def upload_queue_summary():
    items = read_upload_queue()
    counts = {}
    for item in items:
        status = item.get("status", "unknown")
        counts[status] = counts.get(status, 0) + 1
    return {"items": items, "counts": counts, "queue_file": str(UPLOAD_QUEUE_FILE)}

def log_manager_status():
    mcap_logs = []
    if MCAP_DIR.exists():
        for path in sorted(MCAP_DIR.glob("**/*.mcap"), key=lambda p: p.stat().st_mtime, reverse=True)[:25]:
            stat = path.stat()
            mcap_logs.append({"path": str(path), "bytes": stat.st_size, "modified": int(stat.st_mtime)})
    endpoints = read_json(MAVLINK_CONFIG_FILE, {"endpoints": []}).get("endpoints", [])
    remote_logs = list_remote_flight_logs(endpoints, timeout=1.5)
    downloads = process_flight_log_downloads(endpoints)
    return {
        **service_status("log-manager"),
        "mcap_dir": str(MCAP_DIR),
        "mcap_logs": mcap_logs,
        "flight_logs": glob_paths(["/var/log/*/*.ulg", "/var/log/*.ulg", "/home/*/**/*.ulg", "/home/*/**/*.BIN", "/home/*/**/*.bin", str(FLIGHT_LOG_DIR / "*")], 100),
        "remote_flight_logs": remote_logs,
        "flight_log_downloads": downloads,
        "upload_queue": upload_queue_summary(),
    }



def process_is_running(pid_file):
    try:
        pid = int(pid_file.read_text().strip())
        os.kill(pid, 0)
        return pid
    except (FileNotFoundError, ValueError, ProcessLookupError):
        pid_file.unlink(missing_ok=True)
        return None
    except PermissionError:
        return int(pid_file.read_text().strip())


def video_pipeline_args(settings, device):
    fps = int(settings.get("fps", 15))
    encoding = str(settings.get("encoding") or "mjpeg").lower()
    rtsp_url = settings.get("rtsp_url") or "rtsp://127.0.0.1:8554/yari-video"
    size = settings.get("size") or "640x480"
    args = ["ffmpeg", "-hide_banner", "-loglevel", "warning", "-fflags", "nobuffer", "-flags", "low_delay", "-f", "v4l2", "-framerate", str(fps), "-video_size", str(size), "-i", str(device)]
    if encoding in {"h264", "h265"}:
        codec = "libx264" if encoding == "h264" else "libx265"
        args.extend(["-an", "-c:v", codec, "-preset", "ultrafast", "-tune", "zerolatency", "-f", "rtsp", rtsp_url])
    else:
        args.extend(["-an", "-c:v", "mjpeg", "-q:v", "5", "-f", "rtsp", rtsp_url])
    return args


def start_video_stream(settings, devices):
    if not settings.get("stream_enabled", False):
        return {"running": False, "state": "disabled", "message": "stream_enabled is false"}
    if not devices:
        return {"running": False, "state": "no-camera", "message": "no /dev/video* device found"}
    if not command_exists("ffmpeg"):
        return {"running": False, "state": "ffmpeg-missing", "message": "ffmpeg is not installed"}
    device = settings.get("device") or devices[0]
    pid_file = RUNTIME_DIR / "yari-video.pid"
    running_pid = process_is_running(pid_file)
    if running_pid:
        return {"running": True, "state": "running", "pid": running_pid, "device": device, "rtsp_url": settings.get("rtsp_url") or "rtsp://127.0.0.1:8554/yari-video"}
    RUNTIME_DIR.mkdir(parents=True, exist_ok=True)
    log_file = RUNTIME_DIR / "yari-video.log"
    args = video_pipeline_args(settings, device)
    log_handle = log_file.open("ab")
    proc = subprocess.Popen(args, stdout=log_handle, stderr=subprocess.STDOUT, start_new_session=True)
    pid_file.write_text(str(proc.pid) + "\n")
    return {"running": True, "state": "starting", "pid": proc.pid, "device": device, "rtsp_url": settings.get("rtsp_url") or "rtsp://127.0.0.1:8554/yari-video", "log_file": str(log_file), "args": args}

def video_status():
    v4l2 = command(["bash", "-lc", "command -v v4l2-ctl >/dev/null && v4l2-ctl --list-devices"], timeout=8)
    devices = glob_paths(["/dev/video*", "/dev/media*"])
    settings = read_json(CONFIG_DIR / "video.json", {"fps": 15, "encoding": "mjpeg", "bandwidth_kbps": None, "stream_enabled": False, "rtsp_url": "rtsp://127.0.0.1:8554/yari-video"})
    stream = start_video_stream(settings, [device for device in devices if "/dev/video" in device])
    return {
        **service_status("video"),
        "devices": devices,
        "v4l2_devices": v4l2["stdout"],
        "profiles": ["foxglove-compressed", "atlas-webrtc", "rtsp-low-latency"],
        "settings": settings,
        "stream": stream,
    }


def default_ros_launch_profiles():
    return {
        "profiles": [
            {"name": "tortoisebot-hardware", "label": "TortoiseBot hardware bringup", "command_configured": True, "enabled": True},
            {"name": "drone-companion", "label": "PX4/ArduPilot drone companion", "command_configured": False, "enabled": False},
            {"name": "rover-companion", "label": "PX4/ArduPilot rover companion", "command_configured": False, "enabled": False},
        ]
    }


def ros_launch_profiles():
    payload = read_json(ROS_LAUNCH_CONFIG_FILE, default_ros_launch_profiles())
    profiles = payload.get("profiles", []) if isinstance(payload, dict) else []
    normalized = []
    for profile in profiles:
        if not isinstance(profile, dict):
            continue
        item = dict(profile)
        item["command_configured"] = bool(str(item.get("command") or "").strip()) if "command" in item else bool(item.get("command_configured"))
        item["enabled"] = bool(item.get("enabled", True))
        normalized.append(item)
    return normalized


def ros_launch_status():
    state = read_json(ROS_LAUNCH_STATE_FILE, {"active": False})
    return {"profiles": ros_launch_profiles(), "active": bool(state.get("active")), "state": state, "config_file": str(ROS_LAUNCH_CONFIG_FILE)}


def ros_status():
    ros2 = command(["bash", "-lc", "source /opt/ros/humble/setup.bash 2>/dev/null || true; command -v ros2"], timeout=5)
    nodes = command(["bash", "-lc", "source /opt/ros/humble/setup.bash 2>/dev/null || true; ros2 node list"], timeout=8) if ros2["ok"] else {"stdout": "", "stderr": "ros2 command not found"}
    topics = command(["bash", "-lc", "source /opt/ros/humble/setup.bash 2>/dev/null || true; ros2 topic list -t"], timeout=8) if ros2["ok"] else {"stdout": "", "stderr": "ros2 command not found"}
    return {
        **service_status("ros"),
        "installed": ros2["ok"],
        "nodes": [line for line in nodes["stdout"].splitlines() if line],
        "topics": [line for line in topics["stdout"].splitlines() if line],
        "launch": ros_launch_status(),
        "recording": read_json(CONFIG_DIR / "ros-recording.json", {"active": False}),
        "errors": [value for value in (nodes.get("stderr"), topics.get("stderr")) if value],
    }


def agent_status():
    secrets_file = Path(os.environ.get("YARI_PORTAL_SECRETS_FILE", "/etc/yari/device-portal-secrets.json"))
    config_file = Path(os.environ.get("YARI_PORTAL_CONFIG_FILE", "/etc/yari/device-portal.json"))
    secrets = read_json(secrets_file, {})
    config = read_json(config_file, {})
    uploads = process_upload_queue(config, secrets)
    return {
        **service_status("agent"),
        "atlas_url": config.get("atlas_url"),
        "atlas_upload_url": atlas_upload_endpoint(config),
        "atlas_token_configured": bool(secrets.get("atlas_token")),
        "foxglove_token_configured": bool(secrets.get("foxglove_token")),
        "upload_queue": uploads,
    }


ROLE_BUILDERS = {
    "agent": agent_status,
    "mavlink-router": mavlink_router_status,
    "autopilot-manager": autopilot_manager_status,
    "log-manager": log_manager_status,
    "video": video_status,
    "ros": ros_status,
}


def main():
    parser = argparse.ArgumentParser(description="YARI service manager status heartbeat")
    parser.add_argument("role", choices=sorted(ROLE_BUILDERS))
    parser.add_argument("--once", action="store_true")
    parser.add_argument("--interval", type=int, default=int(os.environ.get("YARI_SERVICE_INTERVAL", "10")))
    args = parser.parse_args()
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    while RUNNING:
        write_status(args.role, ROLE_BUILDERS[args.role]())
        if args.once:
            break
        time.sleep(max(1, args.interval))


if __name__ == "__main__":
    main()
