#cloud-config
hostname: __HOSTNAME__
manage_etc_hosts: true
ssh_pwauth: true
disable_root: true
ssh_authorized_keys:
  - "__SSH_AUTHORIZED_KEY__"

users:
  - default
  - name: __USERNAME__
    gecos: TortoiseBot Operator
    groups: sudo
    shell: /bin/bash
    lock_passwd: false
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - "__SSH_AUTHORIZED_KEY__"

chpasswd:
  expire: false
  list: |
    __USERNAME__:__PASSWORD__

package_update: false
package_upgrade: false

bootcmd:
  - [ bash, -lc, 'for d in /boot/firmware /boot; do if [ -d "$d" ]; then echo "cloud-init bootcmd $(date -Is)" >> "$d/tortoisebot-cloud-init-status.log"; break; fi; done' ]
write_files:
  - path: /usr/local/sbin/tortoisebot-bootstrap-login.sh
    owner: root:root
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -uxo pipefail

      BOOT_STATUS_LOG=""
      for boot_dir in /boot/firmware /boot; do
        if [[ -d "${boot_dir}" ]]; then
          BOOT_STATUS_LOG="${boot_dir}/tortoisebot-cloud-init-status.log"
          break
        fi
      done
      if [[ -n "${BOOT_STATUS_LOG}" ]]; then
        exec > >(tee -a /var/log/tortoisebot-bootstrap-login.log "${BOOT_STATUS_LOG}") 2>&1
      else
        exec >/var/log/tortoisebot-bootstrap-login.log 2>&1
      fi
      echo "==> tortoisebot SSH bootstrap start $(date -Is)"

      USERNAME="__USERNAME__"
      PASSWORD="__PASSWORD__"
      SSH_AUTHORIZED_KEY="__SSH_AUTHORIZED_KEY__"
      EXTRA_GROUPS="adm sudo dialout video plugdev"

      install -d /etc/ssh/sshd_config.d
      printf '%s\n' \
        'PasswordAuthentication yes' \
        'KbdInteractiveAuthentication yes' \
        'PubkeyAuthentication yes' \
        >/etc/ssh/sshd_config.d/10-tortoisebot-password-auth.conf

      SSHD_CONFIG=/etc/ssh/sshd_config
      if [[ -f "${SSHD_CONFIG}" ]]; then
        cp -n "${SSHD_CONFIG}" "${SSHD_CONFIG}.tortoisebot.bak" || true
        sed -i -E \
          -e '/^[#[:space:]]*PasswordAuthentication[[:space:]]+/d' \
          -e '/^[#[:space:]]*KbdInteractiveAuthentication[[:space:]]+/d' \
          -e '/^[#[:space:]]*ChallengeResponseAuthentication[[:space:]]+/d' \
          -e '/^[#[:space:]]*PubkeyAuthentication[[:space:]]+/d' \
          "${SSHD_CONFIG}"
        printf '%s\n' \
          '' \
          '# TortoiseBot provisioning' \
          'PasswordAuthentication yes' \
          'KbdInteractiveAuthentication yes' \
          'ChallengeResponseAuthentication yes' \
          'PubkeyAuthentication yes' \
          >>"${SSHD_CONFIG}"
      fi
      trap 'sshd -t && (systemctl restart ssh || systemctl restart sshd || true)' EXIT

      if ! id "${USERNAME}" >/dev/null 2>&1; then
        useradd -m -s /bin/bash "${USERNAME}"
      else
        usermod -s /bin/bash "${USERNAME}"
      fi

      for group_name in ${EXTRA_GROUPS}; do
        if getent group "${group_name}" >/dev/null 2>&1; then
          usermod -aG "${group_name}" "${USERNAME}"
        fi
      done

      echo "${USERNAME}:${PASSWORD}" | chpasswd
      passwd -u "${USERNAME}" || true

      if command -v sshd >/dev/null 2>&1; then
        sshd -T | grep -E 'passwordauthentication|kbdinteractiveauthentication|challengeresponseauthentication|pubkeyauthentication|authorizedkeysfile' || true
      fi

      install -d -m 0700 -o "${USERNAME}" -g "${USERNAME}" "/home/${USERNAME}/.ssh"
      if [[ -n "${SSH_AUTHORIZED_KEY}" ]]; then
        printf '%s\n' "${SSH_AUTHORIZED_KEY}" > "/home/${USERNAME}/.ssh/authorized_keys"
        chown "${USERNAME}:${USERNAME}" "/home/${USERNAME}/.ssh/authorized_keys"
        chmod 0600 "/home/${USERNAME}/.ssh/authorized_keys"
      fi

      echo "==> tortoisebot SSH bootstrap complete $(date -Is)"
  - path: /usr/local/sbin/tortoisebot-install.sh
    owner: root:root
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -euxo pipefail

      USERNAME="__USERNAME__"
      REPO_URL="__REPO_URL__"
      REPO_BRANCH="__REPO_BRANCH__"
      WS="/home/${USERNAME}/tb_ws"
      REPO_DIR="${WS}/src/tortoisebot"
      LOG_FILE="/var/log/tortoisebot-install.log"
      SENTINEL="/var/lib/tortoisebot/.install-complete"

      install -d /var/lib/tortoisebot
      touch "${LOG_FILE}"
      chmod 0644 "${LOG_FILE}"
      exec > >(tee -a "${LOG_FILE}") 2>&1

      echo "==> TortoiseBot install started at $(date -Is)"

      if [[ -f "${SENTINEL}" ]]; then
        echo "==> TortoiseBot install already completed. Remove ${SENTINEL} to force a reinstall."
        exit 0
      fi

      export DEBIAN_FRONTEND=noninteractive
      apt-get update
      apt-get install -y ca-certificates git

      install -d -o "${USERNAME}" -g "${USERNAME}" "${WS}/src"
      if [[ ! -d "${REPO_DIR}/.git" ]]; then
        sudo -u "${USERNAME}" git clone --branch "${REPO_BRANCH}" "${REPO_URL}" "${REPO_DIR}"
      else
        sudo -u "${USERNAME}" git -C "${REPO_DIR}" fetch origin "${REPO_BRANCH}"
        sudo -u "${USERNAME}" git -C "${REPO_DIR}" checkout "${REPO_BRANCH}"
        sudo -u "${USERNAME}" git -C "${REPO_DIR}" pull --ff-only
      fi

      bash "${REPO_DIR}/provisioning/scripts/install_tortoisebot_humble.sh"

      cd "${WS}"
      rosdep install --from-paths src --ignore-src -r -y --rosdistro humble
      sudo -u "${USERNAME}" bash -lc "source /opt/ros/humble/setup.bash && cd '${WS}' && colcon build"

      if ! grep -q "${WS}/install/setup.bash" "/home/${USERNAME}/.bashrc"; then
        echo "source ${WS}/install/setup.bash" >> "/home/${USERNAME}/.bashrc"
      fi
      chown "${USERNAME}:${USERNAME}" "/home/${USERNAME}/.bashrc"

      touch "${SENTINEL}"
      echo "==> TortoiseBot install complete at $(date -Is)"

  - path: /etc/motd
    owner: root:root
    permissions: '0644'
    content: |
      TortoiseBot Raspberry Pi is online.

      To install ROS 2 Humble and the TortoiseBot workspace, run:
        sudo /usr/local/sbin/tortoisebot-install.sh

      To monitor install progress:
        tail -f /var/log/tortoisebot-install.log

  - path: /etc/ssh/sshd_config.d/10-tortoisebot-password-auth.conf
    owner: root:root
    permissions: '0644'
    content: |
      PasswordAuthentication yes
      KbdInteractiveAuthentication yes
      PubkeyAuthentication yes

runcmd:
  - [ bash, -lc, "/usr/local/sbin/tortoisebot-bootstrap-login.sh" ]

final_message: "TortoiseBot base boot complete. SSH in and run: sudo /usr/local/sbin/tortoisebot-install.sh"
