# Copy this file to tortoisebot-image.local.env and fill in private values.
# The .local.env file is ignored by Git.

# Optional. Leave blank to use the first-boot YARI setup access point.
WIFI_SSID=""
WIFI_PASSWORD=""

HOSTNAME="tortoisebot"
USERNAME="tortoisebot"
USER_PASSWORD="raspberry"

# Public key only. Defaults to ~/.ssh/id_ed25519.pub when unset.
SSH_AUTHORIZED_KEY=""

REPO_URL="https://github.com/KarthiAru/tortoisebot.git"
REPO_BRANCH="mcap-logging"

# Optional. Set to a Foxglove device token to persist remote access on the Pi.
FOXGLOVE_DEVICE_TOKEN=""

# First-boot/local fallback onboarding. When Wi-Fi is blank or unavailable,
# the device attempts to start AP YARI-<hostname> and serves http://192.168.4.1.
YARI_ONBOARDING_ENABLED=1
YARI_ONBOARDING_AP_PASSWORD=""
YARI_ONBOARDING_CONNECTIVITY_TIMEOUT=45

# Svelte portal build policy. Legacy static fallback is intentionally unsupported.
# auto/always both require Node.js >= 18 and npm when onboarding is enabled.
YARI_PORTAL_BUILD=always

# Ubuntu Server 22.04 Raspberry Pi arm64 image.
IMAGE_URL="https://cdimage.ubuntu.com/releases/22.04/release/ubuntu-22.04.5-preinstalled-server-arm64+raspi.img.xz"

# Local cache/work output.
CACHE_DIR="$HOME/.cache/tortoisebot"
OUTPUT_DIR="$PWD/provisioning/output"

# Safety guard for --device flashing.
MAX_DEVICE_SIZE_GB=128
